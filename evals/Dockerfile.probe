# The breach probe's image (spec 000 plan §2 and §8; tasks.md T144, brought forward from T080). A one-off container
# on a stack's internal network, from which a client that can't reach the stack's published ports calls its gateway
# in-network: the dev-cpu hops of the operator CLI (contracts/operator-admin.md §6) and of hello's client (tasks.md
# T147, contracts/gateway-http.md §9) run in it, and so does the breach test's probe (evals/breach_probe.py, T080),
# which loads the CLI beside it. Built from the repository root as its context, as the gateway is: in
# deploy/compose.yaml its build.context is `..`, and the compose policy refuses any other.
#
# The pinned base:python of deploy/images.lock, by digest, which the compose policy requires (plan §11). There is no
# `# syntax=` line: it would pull an unpinned frontend image. Nothing is installed: the base's own python3 runs the
# scripts, which are standard library only. compose passes H4_BUILD_PROXY as the HTTP_PROXY and HTTPS_PROXY build
# arguments, as it does for the gateway; this build fetches nothing, and they never reach the image's environment.
FROM public.ecr.aws/docker/library/python:3.12.15-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
# The one build step: the user the scripts run as, never root. No password, home, or login shell.
RUN useradd --uid 10001 --user-group --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin probe
# Root-owned and read-only to the probe user; the container's root filesystem is read-only besides (compose.yaml).
COPY scripts/operator.py /app/operator.py
COPY scripts/hello.py /app/hello.py
COPY evals/breach_probe.py /app/breach_probe.py
USER probe
