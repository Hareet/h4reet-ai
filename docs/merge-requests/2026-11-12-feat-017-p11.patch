+        lambda s: s["models"][0].update(name="qwen_image"),
+        lambda s: s["models"][0].update(repository="Qwen/Qwen2-Image"),
+        lambda s: s["models"][0].update(name="FLUX.1 [dev]"),
+        lambda s: s["models"][0].update(repository="black-forest-labs/FLUX.1-dev"),
+        lambda s: s.update(name="inpaint with Qwen Image Edit"),
+        lambda s: s.update(
+            tools=[
+                {
+                    "name": "Flux Dev",
+                    "version": "1",
+                    "license": "apache-2.0",
+                    "license_version": "2.0",
+                }
+            ]
+        ),
+    ],
+    ids=[
+        "qwen-image-2.1",
+        "qwen-underscore",
+        "qwen2-image-repository",
