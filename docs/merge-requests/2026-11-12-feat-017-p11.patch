+        "the-step-name",
+        "a-tool",
+    ],
+)
+def test_r8_a_step_naming_qwen_image_or_flux_dev_is_refused_by_name(
+    repo: fx.Repo, change
+) -> None:
+    data = fx.png()
+    step = fx.model_step()
+    change(step)
+    run = in_dog(repo, "still.png", data, [fx.entry("still.png", data, steps=[step])])
+    assert run.code == 1 and run.has("R8", f"{DOG}/records.json"), run.out
+    (line,) = [ln for ln in run.out.splitlines() if ln.startswith("R8 ")]
+    assert "steps[0]" in line and "FLUX [dev]" in line
+    # The finding names the step, never the record's string.
+    for text in ("Qwen-Image-2.1", "qwen_image", "Qwen2-Image", "FLUX.1", "Flux Dev"):
+        assert text not in line
+
+
