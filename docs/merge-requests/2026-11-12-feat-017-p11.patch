+# Spec 017 FR-029 (rule R8; its G3 review, Important 1): Qwen-Image's outputs, in any version, and FLUX [dev]'s never
+# ship, whatever the licence allowlist says, so a record step naming either, in any of its strings, is refused by name.
+# Qwen-Image is "qwen", then anything but a letter, then "image" (Qwen-Image-2.1, Qwen2-Image, qwen_image); FLUX [dev] is
+# "flux" and a "dev" no letter follows, in one string (FLUX.1 [dev], black-forest-labs/FLUX.1-dev). FLUX.2 [klein] and
+# Qwen3's text encoder aren't either.
+REFUSED_QWEN = re.compile(r"qwen[^a-z]*image")
+REFUSED_DEV = re.compile(r"dev(?![a-z])")
+REFUSED_MODELS = "Qwen-Image or FLUX [dev], whose outputs never ship, whatever the policy says (spec 017 FR-029)"
+
+
+def refused_by_name(text: str) -> bool:
+    low = text.lower()
+    return bool(REFUSED_QWEN.search(low)) or (
+        "flux" in low and bool(REFUSED_DEV.search(low))
+    )
+
