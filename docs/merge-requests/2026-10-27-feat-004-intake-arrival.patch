+        ({**fx.ROOM_CAPS, "max_lights": 4}, "max_lights"),
+        ({k: v for k, v in fx.ROOM_CAPS.items() if k != "triangles"}, "triangles"),
+        ({**fx.ROOM_CAPS, "gzip_bytes": "2500000"}, "gzip_bytes"),
