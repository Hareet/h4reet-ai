+def test_f3_counts_the_two_largest_visitor_folders(tmp_path: Path) -> None:
+    # Spec 009 (Amendment M13): the twin's stand-in is a visitor avatar, fetched beside the visitor's own, so the first
+    # visit counts the two largest visitor folders. Each folder alone fits the budget; the two together don't.
+    import gzip
+
+    model = fx.glb()
+    size = len(gzip.compress(model, 9, mtime=0))
+    repo = fx.repository(tmp_path, limits=fx.caps(phase2=size + size // 2))
+    repo.directory(DOG, {"dog.glb": model})
+    repo.directory("assets/visitors/cat", {"cat.glb": model})
+    repo.directory(TWIN, {}, [])
+    repo.commit("two visitor avatars")
+    run = check(repo, "--range", "main..HEAD")
+    assert run.code == 1 and run.has("F3"), run.out
+    assert f"first visit (phase 2): {2 * size:,} of" in run.out, run.out
+
+
 def test_h1_the_history_over_its_cap(tmp_path: Path) -> None:
