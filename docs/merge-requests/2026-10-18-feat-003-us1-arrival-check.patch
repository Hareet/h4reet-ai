+LINE = re.compile(
+    r"^(?P<rule>[A-Z]\d+) (?P<path>\S+)(?: @(?P<commit>[0-9a-f]{7,40}))?: (?P<reason>.+)$"
+)
+DOG = "assets/visitors/dog"
