+def check(repo: fx.Repo, *args: str) -> Run:
+    done = subprocess.run(
+        [
+            sys.executable,
+            "-I",
+            "-B",
+            "-X",
+            "pycache_prefix=/dev/null",
+            str(SCRIPT),
+            "--repo",
+            str(repo.root),
+            *args,
+        ],
+        cwd=repo.root,
+        env=repo.env(),
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=120,
+    )
+    return Run(done)
+
