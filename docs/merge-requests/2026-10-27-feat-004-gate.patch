+def studio_files(repo: Path, base: str, sha: str) -> list[str] | None:
+    """The files under STUDIO_ROOT, outside STUDIO_POLICY, that the range adds or changes, or None when git can't say:
+    in any of its commits, so a file a later commit removes still counts, since it stays in the history the merge
+    brings in; and in the tree it ends at, which holds what a merge's resolution adds."""
+    net = changed_paths(repo, base, sha, "--diff-filter=d", under=STUDIO_ROOT)
+    each = git(
+        repo,
+        "log",
+        "--no-renames",
+        "--name-only",
+        "-z",
+        "--format=",
+        "--diff-filter=d",
+        f"{base}..{sha}",
+        "--",
+        STUDIO_ROOT,
+        binary=True,
+    )
+    if net is None or each.returncode:
+        return None
+    found = set(net) | {
+        p.decode("utf-8", "surrogateescape") for p in each.stdout.split(b"\0") if p
+    }
+    return sorted(
+        p
+        for p in found
+        if p.startswith(STUDIO_ROOT) and not p.startswith(STUDIO_POLICY)
+    )
+
+
+def studio_settings(repo: Path, sha: str, base: str | None, tmp: Path) -> Step:
+    """Spec 004's studio-settings step (FR-025, SC-013; contracts/intake-amendments.md §12): when the range brings a
+    studio file in, main's tools/gates/studio_settings_check.py, as the Author runs it, with no option, under PY_HOST,
+    on the settings the studio's session loads on this machine. PASS on exit 0, FAIL on any other; its lines go into
+    the report above the step's, for the note. The step names no path and no file of the range: the check prints
+    folder and scope names and hashes only (§5), and the step adds a count."""
+    begin(
+        "studio-settings",
+        "main's studio settings check, when the range brings a studio file in",
+    )
+    step = Step("studio-settings")
+    if base is None:
+        return step.fail(
+            "no merge base with main, so the range's studio files can't be named"
+        )
+    files = studio_files(repo, base, sha)
+    if files is None:
+        return step.fail("git couldn't name the range's files under assets/")
+    if not files:
+        return step.set("SKIP", "no studio file in the range")
+    checker = repo / "tools" / "gates" / "studio_settings_check.py"
+    if not checker.is_file():
+        return step.fail(
+            "main's tools/gates/studio_settings_check.py is missing (spec 004, P-3)"
+        )
+    count = f"{len(files)} studio file{'s' if len(files) != 1 else ''}"
+    say(f"{count} in the range, so main's check runs")
+    # The Author's own CLAUDE_CONFIG_DIR, when the shell sets it: the check reads the user scope there (§5).
+    config_dir = os.environ.get("CLAUDE_CONFIG_DIR")
+    extra = {"CLAUDE_CONFIG_DIR": config_dir} if config_dir else {}
+    rc, _ = stream(py_host(checker), tool_env(**extra), tmp)
+    if rc == 0:
+        return step.set("PASS", f"{count}; the check's lines are above, for the note")
+    if rc == 1:
+        return step.fail(
+            f"{count}; the check found what its lines above name, for the note"
+        )
+    return step.fail(
+        f"the studio settings check exited {rc}: it couldn't check, which counts as a failure; its lines are above"
+    )
+
