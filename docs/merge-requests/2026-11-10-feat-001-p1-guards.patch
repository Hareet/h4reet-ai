+    while True:
+        if j >= len(src):
+            raise HclError("an unterminated string", line)
+        c = src[j]
+        if c == '"':
+            return j + 1, line, template, None if template else "".join(out)
+        if c == "\n":
+            raise HclError("a newline inside a quoted string", line)
+        if c == "\\":
