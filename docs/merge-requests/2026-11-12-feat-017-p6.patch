 # ----------------------------------------------------------------------------------------------------------------------
+# h4-agent-plan, the night shift's plan-only role (spec 017 FR-032; its research.md R-06; ADR 0051): the runner, outside
+# every container, assumes it from the Author's live SSO session with `aws configure export-credentials`, for one plan,
+# and the plan's container holds those credentials for that run alone. AWS's ReadOnlyAccess, minus any parameter's or
+# secret's value: IAM has no condition key for a parameter read's decryption, so every ssm:GetParameter* read is denied,
+# and Terraform here reads none (rule T9). Plus the state's lock files, so an agent's plan takes the lock as his apply
+# does and never races it. Only his administrator permission set's role may assume it, by the pattern
+# h4-laptop-bedrock's trust uses, for at most an hour. Its apply is his.
+
+data "aws_iam_policy_document" "agent_plan_trust" {
+  statement {
+    sid     = "TheAuthorsAdministratorRoleOnly"
+    effect  = "Allow"
+    actions = ["sts:AssumeRole"]
+
+    principals {
+      type        = "AWS"
+      identifiers = ["arn:aws:iam::${data.aws_caller_identity.current.account_id}:root"]
+    }
+
+    condition {
+      test     = "ArnLike"
+      variable = "aws:PrincipalArn"
+      values = [
+        "arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_${local.plan_permission_set}_????????????????",
+        "arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_${local.plan_permission_set}_????????????????",
+      ]
+    }
+  }
+}
+
+# The bootstrap's state bucket is h4reet-ai-tfstate-<suffix>, and the suffix is the Author's, never in this root (its
+# variable is denied to agent sessions), so the lock files are named by the bucket's prefix: S3's lock file for each
+# root's state is <key>.tflock.
+data "aws_iam_policy_document" "agent_plan" {
+  statement {
+    sid    = "NoParameterOrSecretValue"
+    effect = "Deny"
+    actions = [
+      "ssm:GetParameter",
+      "ssm:GetParameters",
+      "ssm:GetParametersByPath",
+      "ssm:GetParameterHistory",
+      "secretsmanager:GetSecretValue",
+      "secretsmanager:BatchGetSecretValue",
+    ]
+    resources = ["*"]
+  }
+
+  statement {
+    sid       = "TheStatesLockFiles"
+    effect    = "Allow"
+    actions   = ["s3:PutObject", "s3:DeleteObject"]
+    resources = ["arn:aws:s3:::h4reet-ai-tfstate-*/*.tflock"]
+  }
+}
+
+resource "aws_iam_role" "agent_plan" {
+  name                 = "h4-agent-plan"
+  path                 = "/"
+  description          = "The night shift's plans: read-only, and the state's lock files (spec 017 FR-032)"
+  assume_role_policy   = data.aws_iam_policy_document.agent_plan_trust.json
+  max_session_duration = 3600
+
+  tags = {
+    component = "agent-plan"
+  }
+
+  lifecycle {
+    precondition {
+      condition     = can(regex("^[A-Za-z0-9+=,.@_-]{1,32}$", local.plan_permission_set))
+      error_message = "local.plan_permission_set: write the Author's administrator permission set's name in iam.tf (spec 017 P-6)."
+    }
+  }
+}
+
+resource "aws_iam_role_policy_attachment" "agent_plan_read_only" {
+  role       = aws_iam_role.agent_plan.name
+  policy_arn = "arn:aws:iam::aws:policy/ReadOnlyAccess"
+}
+
+resource "aws_iam_role_policy" "agent_plan" {
+  name   = "no-values-and-the-state-locks"
+  role   = aws_iam_role.agent_plan.id
+  policy = data.aws_iam_policy_document.agent_plan.json
+}
+
