+    log = '{"decision":"allow","rule":"allow"}\n{"decision":"refuse","rule":"A14"}\n'
+    done = _refusals(tmp_path, log)
+    assert done.returncode == 0, done.stderr
+    assert done.stdout.strip() == '{"decision":"refuse","rule":"A14"}'
