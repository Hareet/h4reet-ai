diff --git a/deploy/agents-engine/test/test_setup_host_sh.py b/deploy/agents-engine/test/test_setup_host_sh.py
index dddf4dc..caa863b 100644
--- a/deploy/agents-engine/test/test_setup_host_sh.py
+++ b/deploy/agents-engine/test/test_setup_host_sh.py
@@ -561,3 +561,101 @@ echo "WHY [$(pending_restart)]"
     assert done.returncode == 0, done.stderr
     want = "" if held else f"{ME}'s membership of h4gpu"
     assert f"WHY [{want}]" in done.stdout
+
+
+# --------------------------------------------------------------------------------------------------
+# H6: the NVIDIA hook's CLI runs as the least privileged user NVML works as (tasks.md T179)
+# --------------------------------------------------------------------------------------------------
+def _nvidia_user(
+    tmp_path: Path,
+    *,
+    mode: str = "h4gpu 660",
+    nobody: int = 0,
+    root: int = 0,
+    config: str = '[nvidia-container-cli]\n#user = "root:video"\n',
+    device: bool = True,
+) -> subprocess.CompletedProcess[str]:
+    """ensure_nvidia_cli_user with the toolkit, the group, and the device stood in for. nvidia-ctk only echoes."""
+    (tmp_path / "config.toml").write_text(config, encoding="utf-8")
+    if device:
+        (tmp_path / "dxg").write_text("", encoding="utf-8")
+    script = f"""
+nvidia_config={q(tmp_path / "config.toml")}
+dxg={q(tmp_path / "dxg")}
+log() {{ echo "LOG $*"; }}
+getent() {{ echo "h4gpu:x:1001:"; }}
+stat() {{ echo {q(mode)}; }}
+nvidia-container-cli() {{
+    case "$1" in
+    --user=65534:1001) return {nobody} ;;
+    --user=0:1001) return {root} ;;
+    *) return 9 ;;
+    esac
+}}
+nvidia-ctk() {{ echo "CTK $*"; }}
+ensure_nvidia_cli_user
+"""
+    return setup_host(script, tmp_path)
+
+
+def test_nobody_in_h4gpu_when_nvml_works_as_it(tmp_path: Path) -> None:
+    done = _nvidia_user(tmp_path)
+    assert done.returncode == 0, done.stderr
+    assert (
+        f"CTK config --config-file {tmp_path / 'config.toml'} --in-place --set nvidia-container-cli.user=nobody:h4gpu"
+        in done.stdout
+    )
+
+
+def test_root_in_h4gpu_when_nobody_cant_open_the_device(tmp_path: Path) -> None:
+    done = _nvidia_user(tmp_path, nobody=1)
+    assert done.returncode == 0, done.stderr
+    assert "--set nvidia-container-cli.user=root:h4gpu" in done.stdout
+
+
+def test_nobody_is_tried_only_once_the_device_has_h6s_mode(tmp_path: Path) -> None:
+    # Before the boot that applies H6, /dev/dxg is 0666, open to all: nobody would pass and prove nothing.
+    done = _nvidia_user(tmp_path, mode="root 666")
+    assert done.returncode == 0, done.stderr
+    assert "--set nvidia-container-cli.user=root:h4gpu" in done.stdout
+
+
+def test_a_user_already_set_is_left_as_it_is(tmp_path: Path) -> None:
+    config = '[nvidia-container-cli]\nuser = "nobody:h4gpu"\n[nvidia-container-runtime]\nlog-level = "info"\n'
+    done = _nvidia_user(tmp_path, config=config)
+    assert done.returncode == 0, done.stderr
+    assert "CTK" not in done.stdout
+
+
+def test_a_user_under_another_section_isnt_the_clis(tmp_path: Path) -> None:
+    config = '[nvidia-container-runtime]\nuser = "nobody:h4gpu"\n[nvidia-container-cli]\nldconfig = "@/sbin/ldconfig"\n'
+    done = _nvidia_user(tmp_path, config=config)
+    assert done.returncode == 0, done.stderr
+    assert "--set nvidia-container-cli.user=nobody:h4gpu" in done.stdout
+
+
+def test_a_gpu_neither_user_reaches_warns_and_changes_nothing(tmp_path: Path) -> None:
+    done = _nvidia_user(tmp_path, nobody=1, root=1)
+    assert done.returncode == 0, done.stderr
+    assert (
+        "LOG WARNING: nvidia-container-cli reaches the GPU neither as nobody nor as root in h4gpu"
+        in done.stdout
+    )
+    assert "CTK" not in done.stdout
+
+
+def test_no_device_leaves_the_cli_alone(tmp_path: Path) -> None:
+    done = _nvidia_user(tmp_path, device=False)
+    assert done.returncode == 0, done.stderr
+    assert "CTK" not in done.stdout
+    assert "the CLI's user is left alone" in done.stdout
+
+
+def test_setup_runs_the_cli_user_step_after_the_group(tmp_path: Path) -> None:
+    main = (
+        SETUP.read_text(encoding="utf-8")
+        .split("\nmain() {\n", 1)[1]
+        .split("\n}\n", 1)[0]
+    )
+    steps = [line.strip() for line in main.splitlines()]
+    assert steps.index("ensure_nvidia_cli_user") == steps.index("ensure_gpu_group") + 1
