diff --git a/tools/gates/makefiles_check.py b/tools/gates/makefiles_check.py
new file mode 100644
index 0000000..8d0a68f
--- /dev/null
+++ b/tools/gates/makefiles_check.py
@@ -0,0 +1,141 @@
+#!/usr/bin/env python3
+"""GNUmakefile holds only the Author's include, and there is no makefile (spec 000, tasks.md T183).
+
+    python3 -I -B -X pycache_prefix=/dev/null tools/gates/makefiles_check.py [DIR]
+
+GNU make reads the first of GNUmakefile, makefile, and Makefile that it finds, so either of the first two would run
+in place of the Makefile. GNUmakefile must be a regular file, not a link, whose bytes are exactly EXPECTED, which
+only includes the Makefile; and makefile must not exist. One thing counts as no makefile: the sandbox's mask in the
+main tree, /dev/null's character device (1:3), which it binds over a write-denied path that doesn't exist, and which
+holds nothing. In the main tree agent sessions can't write either file; a branch made in a worktree can carry both.
+
+The gate runs this from the Author's tree on the branch's export, before anything runs make, and a FAIL stops the
+gate (tasks.md T092). make check runs it too (`makefiles-check`), but through make it reports only an accidental
+edit: a hostile GNUmakefile has already run by then, and can skip or fake this check. Standard library only.
+
+Exit 0 when both hold, 1 when either doesn't, 2 on a usage error. DIR defaults to the working directory.
+"""
+
+from __future__ import annotations
+
+import difflib
+import errno
+import os
+import stat
+import sys
+from pathlib import Path
+
+EXPECTED = b"""\
+# The Makefile, and nothing else (spec 000, tasks.md T183). GNU make reads GNUmakefile first. With no file here,
+# the sandbox's write-deny on this path (T045) left a placeholder no process could open, and every make in an agent
+# session stopped: "make: GNUmakefile: Permission denied". Agents must not change this file. In the main tree,
+# protected-paths.sh blocks their edits and the sandbox binds it read-only; a worktree has neither, so the gate holds
+# it to exactly this text, before any make (tools/gates/makefiles_check.py). Never add a rule here.
+include $(dir $(lastword $(MAKEFILE_LIST)))Makefile
+"""
+
+SANDBOX_MASK = os.makedev(1, 3)  # /dev/null
+SHOWN = (
+    len(EXPECTED) + 4096
+)  # read at most this much: enough to show a change, never a whole planted file
+
+
+def is_sandbox_mask(path: Path) -> bool:
+    """path is the sandbox's mask: /dev/null's device, bound over a write-denied path that doesn't exist."""
+    st = os.lstat(path)
+    return stat.S_ISCHR(st.st_mode) and st.st_rdev == SANDBOX_MASK
+
+
+def read_regular(path: Path, limit: int) -> tuple[bytes | None, str]:
+    """Up to limit bytes of path, or None and why it can't be read as a regular file. It never follows a link, never
+    waits on a FIFO, and checks the type of what it opened, not of what the name pointed to a moment before."""
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    except OSError as err:
+        if err.errno == errno.ELOOP:
+            return None, "it is a link"
+        return None, f"it can't be opened: {err.strerror}"
+    try:
+        if not stat.S_ISREG(os.fstat(fd).st_mode):
+            return (
+                None,
+                "it isn't a regular file: a directory, a FIFO, a socket, or a device",
+            )
+        chunks: list[bytes] = []
+        while limit > 0 and (chunk := os.read(fd, limit)):
+            chunks.append(chunk)
+            limit -= len(chunk)
+        return b"".join(chunks), ""
+    except OSError as err:
+        return None, f"it can't be read: {err.strerror}"
+    finally:
+        os.close(fd)
+
+
+def problems(root: Path) -> tuple[list[str], list[str]]:
+    """What is wrong with the makefiles make would read in root before its Makefile, and what was noted about them."""
+    found: list[str] = []
+    notes: list[str] = []
+    names = set(os.listdir(root))  # exact names, also on a filesystem that ignores case
+    if "makefile" in names:
+        if is_sandbox_mask(root / "makefile"):
+            notes.append(
+                "makefile: the sandbox's mask, a /dev/null device that holds nothing, counted as none"
+            )
+        else:
+            found.append(
+                "a makefile exists: make reads it instead of the Makefile whenever GNUmakefile is missing. An empty one"
+                " in the main tree is a killed session's mask: remove it while no session runs"
+            )
+    if "GNUmakefile" not in names:
+        found.append("GNUmakefile is missing")
+        return found, notes
+    data, why = read_regular(root / "GNUmakefile", SHOWN)
+    if data is None:
+        found.append(f"GNUmakefile can't be checked: {why}")
+    elif data != EXPECTED:
+        shown = data.decode("utf-8", errors="backslashreplace").replace("\r", "\\r")
+        diff = difflib.unified_diff(
+            EXPECTED.decode("utf-8").splitlines(keepends=True),
+            shown.splitlines(keepends=True),
+            "expected",
+            "GNUmakefile",
+        )
+        cut = (
+            f"\n(the diff shows the file's first {SHOWN} bytes)"
+            if len(data) == SHOWN
+            else ""
+        )
+        found.append(
+            "GNUmakefile differs from the text the Author committed:\n"
+            + "".join(diff).rstrip("\n")
+            + cut
+        )
+    return found, notes
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) > 2:
+        print("usage: makefiles_check.py [DIR]", file=sys.stderr)
+        return 2
+    root = Path(argv[1]) if len(argv) == 2 else Path.cwd()
+    if not root.is_dir():
+        print(f"makefiles_check: not a directory: {root}", file=sys.stderr)
+        return 2
+    found, notes = problems(root)
+    for note in notes:
+        print(note)
+    for problem in found:
+        print(f"FAIL  {problem}", file=sys.stderr)
+    if found:
+        print(
+            "Read the change before any make there; make -f Makefile reads only the Makefile.",
+            file=sys.stderr,
+        )
+        return 1
+    print("makefiles: GNUmakefile holds only its include, and there is no makefile")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/tools/gates/test/test_makefiles_check.py b/tools/gates/test/test_makefiles_check.py
new file mode 100644
index 0000000..a888089
--- /dev/null
+++ b/tools/gates/test/test_makefiles_check.py
@@ -0,0 +1,170 @@
+"""Tests for tools/gates/makefiles_check.py (tasks.md T183): the committed GNUmakefile passes, the sandbox's mask counts
+as no makefile, and each way a branch could change what make reads before the Makefile fails."""
+
+from __future__ import annotations
+
+import importlib.util
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[3]
+CHECK = REPO / "tools" / "gates" / "makefiles_check.py"
+SPEC = importlib.util.spec_from_file_location("makefiles_check", CHECK)
+assert SPEC and SPEC.loader
+mc = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = mc
+SPEC.loader.exec_module(mc)
+
+PLANTED = b"help:\n\t@touch PWNED\n"
+
+
+def test_the_committed_gnumakefile_passes() -> None:
+    # In the main tree inside the sandbox, makefile is the sandbox's mask, which counts as none.
+    assert (REPO / "GNUmakefile").read_bytes() == mc.EXPECTED
+    assert mc.problems(REPO)[0] == []
+
+
+def test_make_check_runs_it_first() -> None:
+    makefile = (REPO / "Makefile").read_text(encoding="utf-8")
+    assert re.search(r"^CHECK_GATES := makefiles-check ", makefile, re.MULTILINE)
+    assert re.search(
+        r"^makefiles-check: .*\n\t\$\(PY_HOST\) tools/gates/makefiles_check\.py$",
+        makefile,
+        re.MULTILINE,
+    )
+
+
+@pytest.fixture
+def tree(tmp_path: Path) -> Path:
+    (tmp_path / "GNUmakefile").write_bytes(mc.EXPECTED)
+    (tmp_path / "Makefile").write_text("help:\n", encoding="utf-8")
+    return tmp_path
+
+
+def test_a_tree_as_committed_passes(
+    tree: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    assert mc.main(["makefiles_check.py", str(tree)]) == 0
+    assert "holds only its include" in capsys.readouterr().out
+
+
+def test_dir_defaults_to_the_working_directory(
+    tree: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.chdir(tree)
+    assert mc.main(["makefiles_check.py"]) == 0
+
+
+def test_only_dev_null_is_the_sandbox_mask(tmp_path: Path) -> None:
+    (tmp_path / "file").write_bytes(b"")
+    (tmp_path / "link").symlink_to("/dev/null")
+    assert mc.is_sandbox_mask(Path("/dev/null"))
+    assert not mc.is_sandbox_mask(Path("/dev/zero"))  # a device too, but 1:5
+    assert not mc.is_sandbox_mask(tmp_path / "file")
+    assert not mc.is_sandbox_mask(tmp_path / "link")  # a link to it isn't the device
+
+
+def test_the_sandbox_mask_at_makefile_counts_as_none(
+    tree: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    # Making a device takes root, so the mask's own test is the one above; here a stand-in answers for it.
+    (tree / "makefile").write_bytes(b"")
+    monkeypatch.setattr(mc, "is_sandbox_mask", lambda path: path.name == "makefile")
+    assert mc.main(["makefiles_check.py", str(tree)]) == 0
+    assert "the sandbox's mask" in capsys.readouterr().out
+
+
+def change(tree: Path, how: str) -> None:
+    gnu = tree / "GNUmakefile"
+    lines = mc.EXPECTED.splitlines(keepends=True)
+    if how == "a rule added":
+        gnu.write_bytes(mc.EXPECTED + PLANTED)
+    elif how == "another file included":
+        gnu.write_bytes(b"".join(lines[:-1]) + b"include evil.mk\n")
+    elif how == "a newline added":
+        gnu.write_bytes(mc.EXPECTED + b"\n")
+    elif how == "a comment changed":
+        gnu.write_bytes(
+            mc.EXPECTED.replace(b"Never add a rule here.", b"Add rules freely.")
+        )
+    elif how == "CRLF line ends":
+        gnu.write_bytes(mc.EXPECTED.replace(b"\n", b"\r\n"))
+    elif how == "not UTF-8":
+        gnu.write_bytes(mc.EXPECTED + b"\xff\n")
+    elif how == "missing":
+        gnu.unlink()
+    elif how == "a link to the same text":
+        (tree / "elsewhere").write_bytes(mc.EXPECTED)
+        gnu.unlink()
+        gnu.symlink_to("elsewhere")
+    elif how == "a directory":
+        gnu.unlink()
+        gnu.mkdir()
+    elif how == "a makefile beside it":
+        (tree / "makefile").write_bytes(PLANTED)
+    elif how == "an empty makefile beside it":
+        (tree / "makefile").write_bytes(b"")
+    else:
+        raise AssertionError(how)
+
+
+@pytest.mark.parametrize(
+    ("how", "says"),
+    [
+        ("a rule added", "+help:"),
+        ("another file included", "+include evil.mk"),
+        ("a newline added", "differs from the text the Author committed"),
+        ("a comment changed", "+# it to exactly this text, before any make"),
+        ("CRLF line ends", "\\r"),
+        ("not UTF-8", "\\xff"),
+        ("missing", "GNUmakefile is missing"),
+        ("a link to the same text", "it is a link"),
+        ("a directory", "isn't a regular file"),
+        ("a makefile beside it", "a makefile exists"),
+        ("an empty makefile beside it", "a killed session's mask"),
+    ],
+)
+def test_a_change_fails(
+    tree: Path, how: str, says: str, capsys: pytest.CaptureFixture[str]
+) -> None:
+    change(tree, how)
+    assert mc.main(["makefiles_check.py", str(tree)]) == 1
+    err = capsys.readouterr().err
+    assert err.startswith("FAIL  ")
+    assert says in err
+
+
+def test_a_long_file_is_read_only_in_part(
+    tree: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    (tree / "GNUmakefile").write_bytes(mc.EXPECTED + b"x" * 100_000)
+    assert mc.main(["makefiles_check.py", str(tree)]) == 1
+    assert f"the file's first {mc.SHOWN} bytes" in capsys.readouterr().err
