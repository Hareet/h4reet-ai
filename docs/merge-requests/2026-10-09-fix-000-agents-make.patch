diff --git a/tools/gates/makefiles_check.py b/tools/gates/makefiles_check.py
new file mode 100644
index 0000000..2610497
--- /dev/null
+++ b/tools/gates/makefiles_check.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""GNUmakefile holds only the Author's include, and there is no makefile (spec 000, tasks.md T183).
+
+    python3 -I -B -X pycache_prefix=/dev/null tools/gates/makefiles_check.py [DIR]
+
+GNU make reads the first of GNUmakefile, makefile, and Makefile that it finds, so either of the first two would run
+in place of the Makefile. GNUmakefile must be a regular file holding exactly EXPECTED, which only includes the
+Makefile, and makefile must not exist. In the main tree, agent sessions can't write either; a branch made in a
+worktree can carry both. `make check` runs this first (`makefiles-check`), where make has already read the file, so
+there it only warns early. The gate runs it from the Author's tree on the branch's export, before anything runs
+make (tasks.md T092). Standard library only.
+
+Exit 0 when both hold, 1 when either doesn't, 2 on a usage error. DIR defaults to the working directory.
+"""
+
+from __future__ import annotations
+
+import difflib
+import os
+import stat
+import sys
+from pathlib import Path
+
+EXPECTED = """\
+# The Makefile, and nothing else (spec 000, tasks.md T183). GNU make reads GNUmakefile first. With no file here,
+# the sandbox's write-deny on this path (T045) left a placeholder no process could open, and every make in an agent
+# session stopped: "make: GNUmakefile: Permission denied". Agents must not change this file. In the main tree,
+# protected-paths.sh blocks their edits and the sandbox's denyWrite names it; a worktree has neither, so make check
+# and the gate hold it to exactly this text (tools/gates/makefiles_check.py). Never add a rule here.
+include $(dir $(lastword $(MAKEFILE_LIST)))Makefile
+"""
+
+
+def problems(root: Path) -> list[str]:
+    """What is wrong with the makefiles make would read in root before its Makefile; empty when nothing is."""
+    found: list[str] = []
+    names = set(os.listdir(root))  # exact names, also on a filesystem that ignores case
+    if "makefile" in names:
+        found.append(
+            "a makefile exists: make reads it instead of the Makefile whenever GNUmakefile is missing"
+        )
+    if "GNUmakefile" not in names:
+        found.append("GNUmakefile is missing")
+        return found
+    gnu = root / "GNUmakefile"
+    if not stat.S_ISREG(
+        gnu.lstat().st_mode
+    ):  # never opened: a FIFO would block, a link could point anywhere
+        found.append(
+            "GNUmakefile isn't a regular file: a link, a directory, or a special file"
+        )
+        return found
+    try:
+        text = gnu.read_text(encoding="utf-8")
+    except (OSError, UnicodeDecodeError) as err:
+        found.append(f"GNUmakefile can't be read: {err}")
+        return found
+    if text != EXPECTED:
+        diff = difflib.unified_diff(
+            EXPECTED.splitlines(keepends=True),
+            text.splitlines(keepends=True),
+            "expected",
+            "GNUmakefile",
+        )
+        found.append(
+            "GNUmakefile differs from the text the Author committed:\n"
+            + "".join(diff).rstrip("\n")
+        )
+    return found
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) > 2:
+        print("usage: makefiles_check.py [DIR]", file=sys.stderr)
+        return 2
+    root = Path(argv[1]) if len(argv) == 2 else Path.cwd()
+    if not root.is_dir():
+        print(f"makefiles_check: not a directory: {root}", file=sys.stderr)
+        return 2
+    found = problems(root)
+    for problem in found:
+        print(f"FAIL  {problem}", file=sys.stderr)
+    if found:
+        print(
+            "Read the change before any make there; make -f Makefile reads only the Makefile.",
+            file=sys.stderr,
+        )
+        return 1
+    print("makefiles: GNUmakefile holds only its include, and there is no makefile")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/tools/gates/test/test_makefiles_check.py b/tools/gates/test/test_makefiles_check.py
new file mode 100644
index 0000000..b6f6b39
--- /dev/null
+++ b/tools/gates/test/test_makefiles_check.py
@@ -0,0 +1,137 @@
+"""Tests for tools/gates/makefiles_check.py (tasks.md T183): the committed GNUmakefile passes, and each way a branch
+could change what make reads before the Makefile fails."""
+
+from __future__ import annotations
+
+import importlib.util
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[3]
+CHECK = REPO / "tools" / "gates" / "makefiles_check.py"
+SPEC = importlib.util.spec_from_file_location("makefiles_check", CHECK)
+assert SPEC and SPEC.loader
+mc = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = mc
+SPEC.loader.exec_module(mc)
+
+PLANTED = "help:\n\t@touch PWNED\n"
+
+
+def test_the_committed_gnumakefile_passes() -> None:
+    assert (REPO / "GNUmakefile").read_text(encoding="utf-8") == mc.EXPECTED
+    assert mc.problems(REPO) == []
+
+
+def test_make_check_runs_it_first() -> None:
+    makefile = (REPO / "Makefile").read_text(encoding="utf-8")
+    assert re.search(r"^CHECK_GATES := makefiles-check ", makefile, re.MULTILINE)
+    assert re.search(
+        r"^makefiles-check: .*\n\t\$\(PY_HOST\) tools/gates/makefiles_check\.py$",
+        makefile,
+        re.MULTILINE,
+    )
+
+
+@pytest.fixture
+def tree(tmp_path: Path) -> Path:
+    (tmp_path / "GNUmakefile").write_text(mc.EXPECTED, encoding="utf-8")
+    (tmp_path / "Makefile").write_text("help:\n", encoding="utf-8")
+    return tmp_path
+
+
+def test_a_tree_as_committed_passes(
+    tree: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    assert mc.main(["makefiles_check.py", str(tree)]) == 0
+    assert "holds only its include" in capsys.readouterr().out
+
+
+def test_dir_defaults_to_the_working_directory(
+    tree: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.chdir(tree)
+    assert mc.main(["makefiles_check.py"]) == 0
+
+
+def change(tree: Path, how: str) -> None:
+    gnu = tree / "GNUmakefile"
+    lines = mc.EXPECTED.splitlines(keepends=True)
+    if how == "a rule added":
+        gnu.write_text(mc.EXPECTED + PLANTED, encoding="utf-8")
+    elif how == "another file included":
+        gnu.write_text("".join(lines[:-1]) + "include evil.mk\n", encoding="utf-8")
+    elif how == "a newline added":
+        gnu.write_text(mc.EXPECTED + "\n", encoding="utf-8")
+    elif how == "a comment changed":
+        gnu.write_text(
+            mc.EXPECTED.replace("Never add a rule here.", "Add rules freely."),
+            encoding="utf-8",
+        )
+    elif how == "not UTF-8":
+        gnu.write_bytes(mc.EXPECTED.encode("utf-8") + b"\xff\n")
+    elif how == "missing":
+        gnu.unlink()
+    elif how == "a link to the same text":
+        (tree / "elsewhere").write_text(mc.EXPECTED, encoding="utf-8")
+        gnu.unlink()
+        gnu.symlink_to("elsewhere")
+    elif how == "a directory":
+        gnu.unlink()
+        gnu.mkdir()
+    elif how == "a makefile beside it":
+        (tree / "makefile").write_text(PLANTED, encoding="utf-8")
+    else:
+        raise AssertionError(how)
+
+
+@pytest.mark.parametrize(
+    ("how", "says"),
+    [
+        ("a rule added", "+help:"),
+        ("another file included", "+include evil.mk"),
+        ("a newline added", "differs from the text the Author committed"),
+        ("a comment changed", "+# and the gate hold it"),
+        ("not UTF-8", "can't be read"),
+        ("missing", "GNUmakefile is missing"),
+        ("a link to the same text", "isn't a regular file"),
+        ("a directory", "isn't a regular file"),
+        ("a makefile beside it", "a makefile exists"),
+    ],
+)
+def test_a_change_fails(
+    tree: Path, how: str, says: str, capsys: pytest.CaptureFixture[str]
+) -> None:
+    change(tree, how)
+    assert mc.main(["makefiles_check.py", str(tree)]) == 1
+    err = capsys.readouterr().err
+    assert err.startswith("FAIL  ")
+    assert says in err
+
+
+def test_a_fifo_fails_without_blocking(tree: Path) -> None:
+    # Opening a FIFO would wait for a writer forever. Run as the gate runs it, with a timeout in case it ever opens one.
+    gnu = tree / "GNUmakefile"
+    gnu.unlink()
+    os.mkfifo(gnu)
+    done = subprocess.run(
+        [sys.executable, "-I", "-B", str(CHECK), str(tree)],
+        capture_output=True,
+        text=True,
+        timeout=30,
+        check=False,
+    )
+    assert done.returncode == 1
+    assert "isn't a regular file" in done.stderr
+
+
+@pytest.mark.parametrize(
+    "argv", [["makefiles_check.py", "a", "b"], ["makefiles_check.py", "/nonexistent"]]
+)
+def test_usage_errors(argv: list[str]) -> None:
+    assert mc.main(argv) == 2
