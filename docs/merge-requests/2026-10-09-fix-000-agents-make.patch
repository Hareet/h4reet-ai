diff --git a/GNUmakefile b/GNUmakefile
new file mode 100644
index 0000000..7749b61
--- /dev/null
+++ b/GNUmakefile
@@ -0,0 +1,5 @@
+# The Makefile, by name, and nothing else (spec 000, tasks.md T183). GNU make reads GNUmakefile before Makefile.
+# With no file here, the sandbox's write-deny on this path (T045) left a placeholder no process can open, and make
+# stopped in every agent session: "make: GNUmakefile: Permission denied". Human-only: the write-deny and
+# protected-paths.sh keep agents from changing it, so it can't shadow the Makefile. Never add a rule here.
+include $(dir $(lastword $(MAKEFILE_LIST)))Makefile
