+    ("deploy/night-shift/images/worker.Dockerfile", "TOOLCHAIN_IMAGE"),
+}
 DISCLOSURE_FILE = "docs/data-flow-disclosure.md"
 DEVCONTAINER_FILE = ".devcontainer/devcontainer.json"
 ENV_FILES = (
