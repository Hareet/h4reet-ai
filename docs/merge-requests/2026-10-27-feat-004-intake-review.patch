+
+      Put the Coca-Cola logo, in its red script, on the lamp's shade, large enough to read from the room's camera.
+    apps/web/room/catalog/fx-shelf.yaml: |
+      version: 1
+      id: fx-shelf
+      name: Wall shelf
+      size: {w: 0.8, h: 0.04, d: 0.2, estimated: true}
+      stylized_scale: 1
