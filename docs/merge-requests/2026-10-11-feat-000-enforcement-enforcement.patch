+  for reading in "$cmd" "$joined" "$uncommented"; do
+    seen=0
+    while IFS= read -r v; do
+      seen=1
+      v="$(sed -E "s/^${opt}([[:space:]]*[:+?!]*=[[:space:]]*|[[:space:]]+)?//" <<<"$v" | tr -d "\"'\\\\\$")"
+      [ "$v" = dev-cpu ] || return 1
+    done < <(grep -oE "${opt}(([[:space:]]*[:+?!]*=[[:space:]]*|[[:space:]]+)[^[:space:];&|()<>]*)?" <<<"$reading" || true)
