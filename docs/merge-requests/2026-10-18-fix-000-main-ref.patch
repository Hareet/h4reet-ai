+    continue
+  fi
+  echo "Blocked by .claude/git-hooks/reference-transaction: a bare main would name $ref beside refs/heads/main (git reads main, refs/main, and refs/tags/main first), and the Author's gate stops while one exists. Name the tag or ref anything else." >&2
+  exit 1
 done
 exit 0
