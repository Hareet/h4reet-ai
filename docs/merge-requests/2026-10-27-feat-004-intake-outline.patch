+def test_it_reports_what_it_left_behind_an_embedded_image_among_it(
+    tmp_path: Path,
+) -> None:
+    image = (
+        f'  <image xlink:href="data:image/png;base64,{"QUJD" * 40}" width="400" height="120"/>\n'
