--- a/.claude/hooks/bash-gate.sh
+++ b/.claude/hooks/bash-gate.sh
@@ -446,6 +446,36 @@
 # shellcheck disable=SC2016
 echo "$cmd" | grep -Eq '(^|[;&| ])rm +-[a-zA-Z]*r[a-zA-Z]* +(/|~|\$HOME|\.\.)' \
   && block "recursive delete outside workspace" "delete only inside the repo"
+# Q109 (night 5): the rule above reads only rm -<...r...> after a separator, with a literal target. This one reads rm
+# wherever a command starts: after a separator, a subshell's ( or {, a backtick or $(, a wrapper or find -exec (the
+# engine rule's starts and skips), a shell's -c, or eval; by path, quoted, or after a backslash; in has()'s three
+# readings. Its simple command is recursive when a word is -r, -R, a cluster holding either, or --recursive (or an
+# abbreviation of it), before or after the operands. It is refused when a word holds $ or a backtick ($VAR, ${...},
+# $(...), `...`), since the gate can't prove such a path is inside the workspace, or when an operand starts with /, ~,
+# or .., as above. Known gaps (the matrix's rows): rm's name in a variable ($R -rf), a list on stdin (xargs rm -rf),
+# find -delete and find -exec rm with {}, a relative path after a cd, and another tool's delete (Python's rmtree).
+rm_start="(^|[;&|(\`{!]|\\\$\\(|\\b(then|do|else|exec|sudo|doas|env|nohup|time|command|builtin|xargs|timeout|nice|ionice|stdbuf|setsid|watch|bash|sh|zsh|dash|ksh|source|eval|busybox)\\b|-exec(dir)?\\b)"
+rm_lead="${rm_start}(${engine_skip})*[[:space:]]*[\"'\\\\]*([^[:space:];&|\"']*/)?$(spelled rm)[\"'\\\\]*([[:space:]]|\$)"
+rm_recursive="(^|[[:space:]])[\"'\\\\]*-([[:alpha:]\"'\\\\]*[rR]|-${eq}r)"
+# rm_unproven <the words after rm>: recursive, with a word the gate can't place inside the workspace.
+rm_unproven() {
+  local w words
+  grep -Eq "$rm_recursive" <<<"$1" || return 1
+  # shellcheck disable=SC2016 # a literal $ or backtick in the command text
+  grep -q '[$`]' <<<"$1" && return 0
+  read -ra words <<<"$(sed -E 's/[0-9]*[<>]+&?[[:space:]]*[^[:space:]]*//g' <<<"$1" | tr -d "\"'\\\\")"
+  for w in "${words[@]}"; do
+    case "$w" in /* | "~"* | ..*) return 0 ;; esac
+  done
+  return 1
+}
+for reading in "$cmd" "$joined" "$uncommented"; do
+  while IFS= read -r seg; do
+    if rm_unproven "$(sed -E "s#^${rm_lead}##" <<<"$seg")"; then
+      block "recursive delete outside workspace" "a recursive rm whose target holds \$ or a backtick, or starts outside the repo, can't be proved inside the workspace (Q109); name the path literally, inside the repo, and leave /tmp scratch for the runner's cleanup"
+    fi
+  done < <(grep -oE "${rm_lead}[^;&|]*" <<<"$reading" || true)
+done
 # Arbitrary egress. The sandbox enforces the domain allowlist at the OS level; this adds the audit trail.
 echo "$cmd" | grep -Eq '(^|[;&| ])(curl|wget|nc|ncat|ssh|scp) ' \
   && block "network egress tool" "package installs go through the toolchain; fetching docs is a human step"
