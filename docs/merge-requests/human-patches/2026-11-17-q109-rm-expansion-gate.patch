--- a/.claude/hooks/bash-gate.sh
+++ b/.claude/hooks/bash-gate.sh
@@ -446,6 +446,78 @@
 # shellcheck disable=SC2016
 echo "$cmd" | grep -Eq '(^|[;&| ])rm +-[a-zA-Z]*r[a-zA-Z]* +(/|~|\$HOME|\.\.)' \
   && block "recursive delete outside workspace" "delete only inside the repo"
+# Q109 (night 5): the rule above reads only rm -<...r...> after a separator, with a literal target. This one reads rm
+# where a command starts, as listed in rm_start: a line's start; after ;, &, |, or !; after a subshell's or a group's
+# ( or {, a case arm's ), a backtick, or $(; after the keywords if, elif, then, do, else, while, until, and coproc;
+# after a wrapper in rm_start's list (exec, sudo, doas, env, nohup, time, command, builtin, xargs, timeout, nice,
+# ionice, stdbuf, setsid, watch, busybox, a shell and its -c, source, eval) or find -exec and -execdir; past the
+# rule's own skips (rm_skip: an option and one argument, quoted or not; a duration; an assignment, with = or +=, its
+# value quoted or not); by path, quoted, or after a backslash; in has()'s three readings. Its simple command runs to
+# the first ;, & or | that isn't a redirection's (2>&1, >&2, 2>&-, <&0, &>, >|); when that cut leaves a quote open or
+# ends on a backslash, it runs on to the line's end, and over each newline a quote holds open, so a quoted or escaped
+# separator (';', '|', "&", "a;b", \;) doesn't end it. A backslash that ends a line is left to the joined reading.
+# It is recursive when a word is -r, -R, a cluster holding either, or --recursive (or an abbreviation of it), before
+# or after the operands. It is refused when a word holds $ or a backtick ($VAR, ${...}, $(...), `...`), since the
+# gate can't prove such a path is inside the workspace, or when an operand starts with /, ~, or .., as above; a
+# redirection's target isn't an operand, but an escaped \> or a quoted '<' is. Any $ in what it reads counts, so
+# these fail closed, refused: a $ in a redirection (rm -rf build 2>"$LOG") or in a trailing comment (rm -rf build #
+# $x), and a $ later on the line after a quoted separator (bash -c 'rm -rf build; echo $x'). Known gaps (the matrix's
+# rows): a wrapper not in the list (strace, flock, chroot, su -c, and the others the matrix names), or one in the list
+# named in quotes or with a backslash ("sudo", 'nice', s\udo, 'bash' -c, "eval"); find -ok and -okdir; a redirection
+# written before rm (>/dev/null rm -rf $S); rm's name in a variable ($R -rf) or made by an expansion ({rm,-rf,$S},
+# rm${IFS}-rf${IFS}$S); a brace expansion's target (rm -rf {/tmp/x,y}); a list on stdin (xargs rm -rf), and a
+# command a shell reads from a pipe or a here-string (| bash, bash <<<); find -delete and find -exec rm with {}; a
+# relative path after a cd; and another tool's delete (Python's rmtree).
+rm_start="(^|[;&|(\`{!)]|\\\$\\(|\\b(if|elif|then|do|else|while|until|coproc|exec|sudo|doas|env|nohup|time|command|builtin|xargs|timeout|nice|ionice|stdbuf|setsid|watch|bash|sh|zsh|dash|ksh|source|eval|busybox)\\b|-exec(dir)?\\b)"
+# One shell word, with its quoted runs and escaped characters; and the rule's own skips: engine_skip's three, with a
+# quoted option argument or assignment value, and +=. engine_skip itself, the engine rule's, is left as it is (Q127).
+rm_word="('[^']*'|\"([^\"\\\\]|\\\\.)*\"|\\\\.|[^[:space:];&|'\"\\\\])+"
+rm_skip="[[:space:]]*-[^[:space:]]*([[:space:]]+${rm_word})?|[[:space:]]+[0-9][0-9.]*[smhd]?|[[:space:]]*[A-Za-z_][A-Za-z0-9_]*\\+?=(${rm_word})?"
+rm_lead="${rm_start}(${rm_skip})*[[:space:]]*[\"'\\\\]*([^[:space:];&|\"']*/)?$(spelled rm)[\"'\\\\]*([[:space:]]|\$)"
+# The cut, and closed text: no quote left open, no backslash at its end; a # at a word's start ends its line's text.
+rm_cut="([^;&|]|[<>]&|&>|>\\|)*"
+rm_nl=$'\n'
+rm_closed="^([^'\"\\\\]|'[^']*'|\"([^\"\\\\]|\\\\.)*\"|\\\\.|(^|[[:space:]])#[^${rm_nl}]*)*\$"
+rm_recursive="(^|[[:space:]])[\"'\\\\]*-([[:alpha:]\"'\\\\]*[rR]|-${eq}r)"
+rm_maybe="[\$\`]|(^|[[:space:]])[\"'\\\\]*(/|~|\\.[\"'\\\\]*\\.)"
+# rm_unproven <the words after rm>: recursive, with a word the gate can't place inside the workspace. A redirection
+# and its target are left out, unless the < or > is escaped (rm -rf \> /tmp/x deletes /tmp/x).
+rm_unproven() {
+  local w words
+  grep -Eq "$rm_recursive" <<<"$1" || return 1
+  # shellcheck disable=SC2016 # a literal $ or backtick in the command text
+  grep -q '[$`]' <<<"$1" && return 0
+  read -ra words <<<"$(sed -E 's/(^|[^\\])(&|[0-9]*)[<>]+&?[[:space:]]*[^[:space:]]*/\1/g' <<<"$1" \
+    | tr -d "\"'\\\\" | tr '\n' ' ')"
+  for w in "${words[@]}"; do
+    case "$w" in /* | "~"* | ..*) return 0 ;; esac
+  done
+  return 1
+}
+for reading in "$cmd" "$joined" "$uncommented"; do
+  mapfile -t rm_lines <<<"$reading"
+  while IFS= read -r rm_hit; do
+    rm_n="${rm_hit%%:*}"
+    seg="${rm_hit#*:}"
+    if ! [[ "$seg" =~ $rm_closed ]]; then
+      rm_rest="${rm_lines[rm_n - 1]#*"$seg"}"
+      if [ -z "$rm_rest" ] && [[ "$seg" == *\\ && "${seg%\\}" =~ $rm_closed ]]; then
+        seg="${seg%\\}"
+      else
+        seg+="$rm_rest"
+        while ! [[ "$seg" =~ $rm_closed ]] && [ "$rm_n" -lt "${#rm_lines[@]}" ]; do
+          seg+="${rm_nl}${rm_lines[rm_n]}"
+          rm_n=$((rm_n + 1))
+        done
+      fi
+    fi
+    # rm_unproven's two tests first, on the whole text with its lead, without starting a process: a wider match.
+    [[ "$seg" =~ $rm_recursive && "$seg" =~ $rm_maybe ]] || continue
+    if rm_unproven "$(sed -zE "s#^${rm_lead}##" <<<"$seg")"; then
+      block "recursive delete outside workspace" "a recursive rm whose target holds \$ or a backtick, or starts outside the repo, can't be proved inside the workspace (Q109); name the path literally, inside the repo, and leave /tmp scratch for the runner's cleanup"
+    fi
+  done < <(grep -noE "${rm_lead}${rm_cut}" <<<"$reading" || true)
+done
 # Arbitrary egress. The sandbox enforces the domain allowlist at the OS level; this adds the audit trail.
 echo "$cmd" | grep -Eq '(^|[;&| ])(curl|wget|nc|ncat|ssh|scp) ' \
   && block "network egress tool" "package installs go through the toolchain; fetching docs is a human step"
