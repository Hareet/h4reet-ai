+# --------------------------------------------------------------------------------------------------
+# Spec 036: the test step's one retry (FR-001 to FR-005)
+# --------------------------------------------------------------------------------------------------
+# make test says what each part exited, each workspace's tests by folder and then pytest, whatever the others exited
+# (the Makefile since spec 036, FR-008). Without those lines a workspace's failure may have kept pytest from running, or
+# npm's one exit may hide which workspace failed, so nothing is rerun.
+TEST_PART = re.compile(r"test-part: (?:workspace (\S+)|(pytest)) exited (\d+)")
+# vitest 5.0.3's lines, escape sequences removed (spec 036 research.md R-1). Each workspace's run opens with its RUN
+# line, on stdout with its summary; its Failed Tests section, on stderr, names each failing test as
+# FAIL  <file> > <suite> > ... > <test>, whose text after "<file> > " is the full name -t matches. docker forwards
+# stdout and stderr apart, so a FAIL line is put in a workspace by its file, never by where it lands.
+VITEST_RUN = re.compile(r"\s*RUN\s+v\d\S*\s+(/\S+)\s*")
+VITEST_SECTION = re.compile(
+    r"\s*⎯+\s*(Failed Tests|Failed Suites|Unhandled Errors?)(?:\s+(\d+))?\s*⎯+\s*"
+)
+VITEST_FAIL = re.compile(r"\s*FAIL\s+(\S+?) > (\S.*?)\s*")
+VITEST_COUNT = re.compile(r"\s*(Test Files|Tests|Errors) {2,}(\S.*?)\s*")
+VITEST_TOTAL = re.compile(r"(.*?)\s*\(\d+\)")
+VITEST_SCRIPT = "vitest run"
+# A file as vitest names it, relative to its workspace: no leading slash or dash.
+WORKSPACE_FILE = re.compile(r"[A-Za-z0-9_@+][A-Za-z0-9_@+./-]*")
+WORKSPACE_PATTERN = re.compile(r"[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*(?:/\*)?")
+# pytest 9.1.1's -q lines (research.md R-2): the summary, unpadded under -q, and the short test summary's header.
+PYTEST_SUMMARY = re.compile(
+    r"=*\s*(\d+ [a-z]+(?:, \d+ [a-z]+)*) in \d+(?:\.\d+)?s(?: \([0-9:.]+\))?\s*=*"
+)
+PYTEST_SHORT = re.compile(r"=+ short test summary info =+")
+PYTEST_NODE = re.compile(
+    r"[A-Za-z0-9_][A-Za-z0-9_./-]*\.py(?:::[A-Za-z_][A-Za-z0-9_]*)+"
+)
+PYTEST_ARGS = re.compile(r"^PYTEST_ARGS\s*:?=(.*)$", re.MULTILINE)
+PLAIN_WORD = re.compile(r"[A-Za-z0-9_.:=/-]+")
+
+
+@dataclass
+class VitestRun:
+    """One workspace's run: the folder its RUN line names, and its summary's counts, by line (Test Files, Tests,
+    Errors)."""
+
+    root: str
+    counts: dict[str, dict[str, int]] = field(default_factory=dict)
+
+
+@dataclass
+class Retry:
+    """What the one retry reruns: each failing workspace's (file, full name) pairs, by folder; pytest's node ids, and
+    the branch's PYTEST_ARGS."""
+
+    vitest: dict[str, list[tuple[str, str]]] = field(default_factory=dict)
+    pytest: list[str] = field(default_factory=list)
+    pytest_args: list[str] = field(default_factory=list)
+
+    def names(self) -> list[str]:
+        return [
+            f"{folder}/{file} > {name}"
+            for folder, tests in self.vitest.items()
+            for file, name in tests
+        ] + self.pytest
+
+    def short(self) -> list[str]:
+        """The names the summary line gives: a test file's own name, then the test's."""
+        return [
+            f"{file.rsplit('/', 1)[-1]} > {name}"
+            for tests in self.vitest.values()
+            for file, name in tests
+        ] + [
+            f"{node.partition('::')[0].rsplit('/', 1)[-1]}::{node.partition('::')[2]}"
+            for node in self.pytest
+        ]
+
+
+def counted(text: str) -> dict[str, int] | None:
+    """vitest's `1 failed | 1 passed (2)`, or pytest's `3 failed, 3 passed, 1 error`, by word, or None."""
+    total = VITEST_TOTAL.fullmatch(text)
+    body = total.group(1) if total else text
+    counts: dict[str, int] = {}
+    for part in re.split(r" \| |, ", body):
+        found = re.fullmatch(r"(\d+) ([a-z]+)", part.strip())
+        if found is None:
+            return None
+        counts[found.group(2)] = counts.get(found.group(2), 0) + int(found.group(1))
+    return counts
+
+
+def vitest_output(
+    lines: list[str],
+) -> tuple[list[VitestRun], list[tuple[str, int]], list[tuple[str, str]], str]:
+    """Every run's root and summary, each section's kind and count, and the FAIL lines; or why they don't read."""
+    runs: list[VitestRun] = []
+    sections: list[tuple[str, int]] = []
+    fails: list[tuple[str, str]] = []
+    for line in lines:
+        if found := VITEST_RUN.fullmatch(line):
+            runs.append(VitestRun(found.group(1)))
+        elif found := VITEST_SECTION.fullmatch(line):
+            sections.append((found.group(1), int(found.group(2) or 0)))
+        elif found := VITEST_FAIL.fullmatch(line):
+            fails.append((found.group(1), found.group(2)))
+        elif found := VITEST_COUNT.fullmatch(line):
+            key, counts = found.group(1), counted(found.group(2))
+            if not runs or counts is None or key in runs[-1].counts:
+                return [], [], [], f"vitest's {key} line doesn't read as one run's"
+            runs[-1].counts[key] = counts
+    return runs, sections, fails, ""
+
+
+def regular_file(top: Path, rel: str) -> bool:
+    """rel names a regular file inside top, never through a link."""
+    if not WORKSPACE_FILE.fullmatch(rel) or ".." in rel.split("/"):
+        return False
+    path = top / rel
+    return (
+        not any(p.is_symlink() for p in [path, *path.parents] if top in p.parents)
+        and path.is_file()
+    )
+
+
+def workspace_scripts(export_dir: Path) -> tuple[dict[str, object] | None, str]:
+    """Each workspace's test script, by folder, from the root package.json's list, as npm reads it; or None and why
+    not. A workspace with no test script, which npm test --if-present skips, isn't listed."""
+    try:
+        root = json.loads((export_dir / "package.json").read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None, "the root package.json doesn't read"
+    patterns = root.get("workspaces") if isinstance(root, dict) else None
+    if not isinstance(patterns, list) or not all(
+        isinstance(p, str)
+        and WORKSPACE_PATTERN.fullmatch(p)
+        and ".." not in p.split("/")
+        for p in patterns
+    ):
+        return None, "the root package.json's workspaces aren't plain folders"
+    scripts: dict[str, object] = {}
+    for pattern in patterns:
+        base = pattern.removesuffix("/*")
+        found = [base]
+        if pattern.endswith("/*"):
+            parent, found = export_dir / base, []
+            if parent.is_dir() and not parent.is_symlink():
+                with os.scandir(parent) as entries:
+                    found = sorted(
+                        f"{base}/{entry.name}"
+                        for entry in entries
+                        if entry.is_dir(follow_symlinks=False)
+                    )
+        for folder in found:
+            manifest = export_dir / folder / "package.json"
+            if manifest.is_symlink() or not manifest.is_file():
+                continue
+            try:
+                package = json.loads(manifest.read_text(encoding="utf-8"))
+            except (OSError, ValueError):
+                return None, f"{folder}/package.json doesn't read"
+            listed = package.get("scripts") if isinstance(package, dict) else None
+            if isinstance(listed, dict) and "test" in listed:
+                scripts[folder] = listed["test"]
+    return scripts, ""
+
+
+def vitest_failures(
+    lines: list[str], export_dir: Path, failing: list[str]
+) -> tuple[dict[str, list[tuple[str, str]]] | None, str]:
+    """The failed tests of each workspace that exited 1, from the lines before pytest's part, when they account for
+    every one of its failures (FR-002); or None and why not."""
+    scripts, why = workspace_scripts(export_dir)
+    if scripts is None:
+        return None, why
+    other_script = [f for f in failing if scripts.get(f) != VITEST_SCRIPT]
+    if other_script:
+        return None, f"{some(other_script)}'s test script isn't {VITEST_SCRIPT}"
+    runs, sections, fails, why = vitest_output(lines)
+    if why:
+        return None, why
+    other = sorted({kind for kind, _ in sections if kind != "Failed Tests"})
+    if other:
+        return (
+            None,
+            f"vitest reported {', '.join(other)}, which isn't a test it can rerun alone",
+        )
+    by_folder: dict[str, VitestRun] = {}
+    for run in runs:
+        folder = run.root.removeprefix("/work/")
+        if run.root == folder or folder in by_folder:
+            return None, f"a vitest run at {run.root} isn't one workspace's own"
+        by_folder[folder] = run
+    cut = [
+        f
+        for f in failing
+        if f not in by_folder or {"Test Files", "Tests"} - set(by_folder[f].counts)
+    ]
+    if cut:
+        return None, f"{some(cut)} didn't run its tests to their summary"
+    if any("Errors" in by_folder[f].counts for f in failing):
+        return None, "vitest caught errors outside the tests"
+    quiet = [f for f in failing if not by_folder[f].counts["Tests"].get("failed")]
+    if quiet:
+        return None, f"{some(quiet)} exited 1, and its summary counts no failed test"
+    if sum(n for _, n in sections) != len(fails):
+        return (
+            None,
+            "vitest's Failed Tests sections don't count the FAIL lines they hold",
+        )
+    placed: dict[str, list[tuple[str, str]]] = {f: [] for f in failing}
+    for file, name in fails:
+        owners = [f for f in failing if regular_file(export_dir / f, file)]
+        if len(owners) != 1:
+            return None, f"{file} isn't in one failing workspace, but in {len(owners)}"
+        placed[owners[0]].append((file, name))
+    for folder, tests in placed.items():
+        counts = by_folder[folder].counts
+        if (
+            len(set(tests)) != len(tests)
+            or counts["Tests"].get("failed", 0) != len(tests)
+            or counts["Test Files"].get("failed", 0) != len({f for f, _ in tests})
+        ):
+            return (
+                None,
+                f"{folder}'s failed counts don't match the tests its FAIL lines name",
+            )
+    return placed, ""
+
+
+def failed_node(line: str) -> str | None:
+    """The node id in pytest's `FAILED <id>[ - <message>]`, or None when it can't be read for certain: a test's path
+    and name, then any parameters' brackets, nested as pytest writes them, to the "]" that closes them, followed by the
+    line's end or " - "."""
+    rest = line.removeprefix("FAILED ")
+    base = PYTEST_NODE.match(rest)
+    if rest == line or base is None:
+        return None
+    tail, end = rest[base.end() :], 0
+    if tail.startswith("["):
+        depth = 0
+        for i, ch in enumerate(tail):
+            depth += {"[": 1, "]": -1}.get(ch, 0)
+            if depth == 0:
+                end = i + 1
+                break
+        else:
+            return None
+    if tail[end:] and not tail[end:].startswith(" - "):
+        return None
+    return base.group(0) + tail[:end]
+
+
+def pytest_args(export_dir: Path) -> tuple[list[str] | None, str]:
+    """The branch's PYTEST_ARGS, which make test gives pytest, as plain words; or None and why not."""
+    try:
+        text = (export_dir / "Makefile").read_text(encoding="utf-8")
+    except OSError:
+        return None, "the branch has no Makefile to read PYTEST_ARGS from"
+    found = PYTEST_ARGS.findall(text)
+    words = found[0].split() if len(found) == 1 else []
+    if not words or not all(PLAIN_WORD.fullmatch(w) for w in words):
+        return None, "the Makefile doesn't set PYTEST_ARGS once, in plain words"
+    return words, ""
+
+
+def pytest_failures(
+    lines: list[str], export_dir: Path
+) -> tuple[tuple[list[str], list[str]] | None, str]:
+    """pytest's failed tests, by node id, and the branch's PYTEST_ARGS, from the lines between make test's two lines,
+    when its summary accounts for every failure (FR-002); or None and why not."""
+    ends = [i for i, line in enumerate(lines) if PYTEST_SUMMARY.fullmatch(line.strip())]
+    if not ends:
+        return None, "pytest didn't print its summary"
+    counts = counted(PYTEST_SUMMARY.fullmatch(lines[ends[-1]].strip()).group(1)) or {}
+    if counts.get("error") or counts.get("errors"):
+        return None, "pytest reported an error, which isn't a failed test"
+    starts = [i for i in range(ends[-1]) if PYTEST_SHORT.fullmatch(lines[i].strip())]
+    if not starts:
+        return None, "pytest printed no short test summary"
+    nodes: list[str] = []
+    for line in lines[starts[-1] + 1 : ends[-1]]:
+        if not line.strip():
+            continue
+        if not line.startswith("FAILED "):
+            return (
+                None,
+                f"pytest's summary holds a {line.split()[0]} line, and only FAILED tests are rerun",
+            )
+        node = failed_node(line)
+        if node is None:
+            return None, "a FAILED line's node id can't be read for certain"
+        if not regular_file(export_dir, node.split("::", 1)[0]):
+            return None, f"{node.split('::', 1)[0]} isn't a file of the branch"
+        nodes.append(node)
+    if (
+        not nodes
+        or len(set(nodes)) != len(nodes)
+        or counts.get("failed", 0) != len(nodes)
+    ):
+        return None, "pytest's failed count doesn't match its FAILED lines"
+    args, why = pytest_args(export_dir)
+    if args is None:
+        return None, why
+    return (nodes, args), ""
+
+
+def retry_plan(output: str, export_dir: Path) -> tuple[Retry | None, str]:
+    """What the test step's one retry reruns, from make test's output, or None and why nothing is (FR-001, FR-002)."""
+    lines = ANSI_ESCAPE.sub("", output).splitlines()
+    parts = [
+        (i, found.group(1) or found.group(2), int(found.group(3)))
+        for i, line in enumerate(lines)
+        if (found := TEST_PART.fullmatch(line.strip()))
+    ]
+    kinds = [kind for _, kind, _ in parts]
+    if (
+        not kinds
+        or kinds[-1] != "pytest"
+        or kinds.count("pytest") != 1
+        or len(set(kinds)) != len(kinds)
+    ):
+        return None, (
+            "make test didn't say what each of its parts exited, so pytest may not have run: a Makefile from before "
+            "spec 036, which merging main into the branch brings"
+        )
+    odd = [f"{kind} exited {rc}" for _, kind, rc in parts if rc not in (0, 1)]
+    if odd:
+        return None, f"{some(odd)}: only a failed test, exit 1, is rerun"
+    failing = [kind for _, kind, rc in parts[:-1] if rc]
+    py_at, py_rc = parts[-1][0], parts[-1][2]
+    if not failing and not py_rc:
+        return None, "every part of make test exited 0, so something else failed"
+    py_from = parts[-2][0] + 1 if len(parts) > 1 else 0
+    plan = Retry()
+    if failing:
+        placed, why = vitest_failures(lines[:py_from], export_dir, failing)
+        if placed is None:
+            return None, why
+        plan.vitest = placed
+    if py_rc:
+        found, why = pytest_failures(lines[py_from:py_at], export_dir)
+        if found is None:
+            return None, why
+        plan.pytest, plan.pytest_args = found
+    return plan, ""
+
+
+def js_regex(name: str) -> str:
+    """A test's full name as a JavaScript pattern that matches it alone: each syntax character escaped."""
+    return re.sub(r"[\\^$.*+?()[\]{}|]", lambda m: "\\" + m.group(0), name)
+
+
+def vitest_rerun_problem(rc: int, output: str, folder: str, count: int) -> str | None:
+    """Why a workspace's rerun didn't pass exactly its tests, or None."""
+    if rc != 0:
+        return f"exited {rc}"
+    runs, sections, fails, why = vitest_output(ANSI_ESCAPE.sub("", output).splitlines())
+    if why:
+        return why
+    if sections or fails:
+        return "it named failures"
+    if [run.root for run in runs] != [f"/work/{folder}"]:
+        return f"it didn't run in {folder}"
+    counts = runs[0].counts
+    tests, files = counts.get("Tests"), counts.get("Test Files")
+    if tests is None or files is None or "Errors" in counts:
+        return "it didn't reach its summary"
+    if tests.get("failed") or files.get("failed") or tests.get("passed", 0) != count:
+        return f"it passed {tests.get('passed', 0)} of the {count} tests it was given"
+    return None
+
+
+def pytest_rerun_problem(rc: int, output: str, count: int) -> str | None:
+    """Why pytest's rerun didn't pass exactly its tests, or None."""
+    if rc != 0:
+        return f"exited {rc}"
+    found = [
+        PYTEST_SUMMARY.fullmatch(line.strip())
+        for line in ANSI_ESCAPE.sub("", output).splitlines()
+    ]
+    summaries = [m for m in found if m]
+    counts = counted(summaries[-1].group(1)) if summaries else None
+    if counts is None:
+        return "it printed no summary"
+    if (
+        counts.get("failed")
+        or counts.get("error")
+        or counts.get("errors")
+        or counts.get("passed", 0) != count
+    ):
+        return f"it passed {counts.get('passed', 0)} of the {count} tests it was given"
+    return None
+
