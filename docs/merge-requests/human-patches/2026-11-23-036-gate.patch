+# --------------------------------------------------------------------------------------------------
+# Spec 036: the docs-only fast path (FR-006, FR-007; research.md R-3)
+# --------------------------------------------------------------------------------------------------
+# A branch whose every change is a note or a record that no test, build, eval, or red-team case reads skips those
+# steps, each SKIP saying why, and the docs' links, which make evals checks, run on their own. The set, derived from
+# what the code reads: a Markdown file directly in one of these folders, not a README (one is read by name), whose
+# name without .md no file of the export outside the prose names (DOCS_ONLY_PROSE, and docs/'s Markdown), since a test
+# that reads a note names it. Patches, scripts, and subfolders are out: tests read them.
+DOCS_ONLY_FOLDERS = ("docs/merge-requests/", "docs/infra/applies/", "docs/incidents/")
+DOCS_ONLY_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*\.md")
+DOCS_ONLY_SKIPPED = ("test", "evals", "redteam", "matrix-h", "image")
+DOCS_ONLY_PROSE = ("specs/", "intent/")
+DOCS_LINKS = "evals/docs_links.py"
+# A plain file's mode in git's tree, and none.
+PLAIN_FILE, NO_FILE = "100644", "000000"
+
+
+def names_in_tree(export_dir: Path, stems: set[str]) -> dict[str, str]:
+    """For each name, a file of the export that holds it, outside the prose: specs/, intent/, and the Markdown under
+    docs/, which no skipped step runs. A file with a NUL byte in its first 8 KiB (an image, a model, a film) isn't
+    read; links aren't followed."""
+    wanted = {stem: stem.encode("utf-8") for stem in stems}
+    found: dict[str, str] = {}
+    for folder, dirs, files in os.walk(export_dir):
+        rel_dir = Path(folder).relative_to(export_dir).as_posix()
+        prefix = "" if rel_dir == "." else f"{rel_dir}/"
+        dirs[:] = sorted(d for d in dirs if f"{prefix}{d}/" not in DOCS_ONLY_PROSE)
+        for name in sorted(files):
+            rel = f"{prefix}{name}"
+            path = os.path.join(folder, name)
+            if (rel.startswith("docs/") and rel.endswith(".md")) or not stat.S_ISREG(
+                os.lstat(path).st_mode
+            ):
+                continue
+            with open(path, "rb") as handle:
+                data = handle.read(8192)
+                if b"\0" in data:
+                    continue
+                data += handle.read()
+            for stem, needle in wanted.items():
+                if stem not in found and needle in data:
+                    found[stem] = rel
+            if len(found) == len(wanted):
+                return found
+    return found
+
+
+def docs_only(
+    repo: Path, export_dir: Path, base: str | None, sha: str
+) -> tuple[list[str] | None, str]:
+    """The paths a docs-only branch changes against its merge base with main (FR-006), or None and why it isn't one."""
+    if base is None:
+        return None, "no merge base with main"
+    done = git(
+        repo,
+        "diff",
+        "--raw",
+        "--no-renames",
+        "--no-abbrev",
+        "-z",
+        base,
+        sha,
+        binary=True,
+    )
+    if done.returncode:
+        return None, "git couldn't list the branch's changes"
+    fields = done.stdout.split(b"\0")
+    paths: list[str] = []
+    for meta, raw in zip(fields[0::2], fields[1::2], strict=False):
+        path = raw.decode("utf-8", "surrogateescape")
+        info = meta.decode("ascii", "replace").lstrip(":").split()
+        if (
+            len(info) != 5
+            or info[4] not in ("A", "M", "D")
+            or {info[0], info[1]} - {PLAIN_FILE, NO_FILE}
+            or (info[4] == "M" and info[0] != PLAIN_FILE)
+        ):
+            return (
+                None,
+                f"{path} isn't a plain file the branch adds, changes, or deletes",
+            )
+        folder = next((f for f in DOCS_ONLY_FOLDERS if path.startswith(f)), "")
+        name = path[len(folder) :]
+        if (
+            not folder
+            or not DOCS_ONLY_NAME.fullmatch(name)
+            or name.lower() == "readme.md"
+        ):
+            return None, f"{path} is outside the fast path's set"
+        paths.append(path)
+    if not paths:
+        return None, "the branch changes nothing"
+    if not (export_dir / DOCS_LINKS).is_file():
+        return None, f"the tree has no {DOCS_LINKS} to check the docs' links"
+    named = names_in_tree(
+        export_dir, {p.rsplit("/", 1)[-1].removesuffix(".md") for p in paths}
+    )
+    if named:
+        stem, where = min(named.items())
+        return None, f"{where} names {stem}, so a test or build may read it"
+    return sorted(paths), ""
+
