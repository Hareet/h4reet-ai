+def retry_test(
+    step: Step,
+    output: str,
+    docker: str,
+    image_id: str,
+    work: Path,
+    export_dir: Path,
+    tmp: Path,
+) -> Step:
+    """The test step's one retry (FR-003 to FR-005): exactly its failed tests, once, in make test's own container. PASS,
+    naming them flaky, when every rerun passes exactly its tests; otherwise the step stays FAIL, with why."""
+    plan, why = retry_plan(output, export_dir)
+    if plan is None:
+        step.notes.append(f"no retry: {why}")
+        return step
+    names = plan.names()
+    begin(
+        "test-retry",
+        f"{len(names)} failed test{'s' if len(names) != 1 else ''}, once, in make test's container, --network none "
+        "(spec 036)",
+    )
+    failed = []
+    for folder, tests in plan.vitest.items():
+        files = list(dict.fromkeys(file for file, _ in tests))
+        pattern = "^(?:" + "|".join(js_regex(name) for _, name in tests) + ")$"
+        rc, out = stream(
+            container(
+                docker,
+                image_id,
+                work,
+                ["npm", "test", "-w", folder, "--", *files, "-t", pattern],
+                network=False,
+            ),
+            host_engine_env(),
+            tmp,
+        )
+        problem = vitest_rerun_problem(rc, out, folder, len(tests))
+        if problem:
+            failed.append(f"{folder}: {problem}")
+    if plan.pytest:
+        rc, out = stream(
+            container(
+                docker,
+                image_id,
+                work,
+                ["pytest", *plan.pytest_args, *plan.pytest],
+                network=False,
+            ),
+            host_engine_env(),
+            tmp,
+        )
+        problem = pytest_rerun_problem(rc, out, len(plan.pytest))
+        if problem:
+            failed.append(f"pytest: {problem}")
+    if failed:
+        step.notes.append(f"its one retry failed too: {'; '.join(failed)}")
+        return step
+    step.status = "PASS"
+    step.notes = [
+        f"flaky: {', '.join(names)} (failed, then passed on the gate's one retry)"
+    ]
+    step.flaky = plan.short()
+    return step
+
