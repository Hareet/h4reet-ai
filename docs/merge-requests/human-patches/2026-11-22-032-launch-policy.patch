   statement {
     sid     = "WhatOnlyTheTemplateNames"
     effect  = "Allow"
@@ -549,20 +562,7 @@
       "arn:aws:ec2:us-east-1:${data.aws_caller_identity.current.account_id}:network-interface/*",
