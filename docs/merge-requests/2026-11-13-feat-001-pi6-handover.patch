+      state       = ["running"]
+    }
+  })
+
+  tags = {
+    component = "ec2"
+  }
+}
+
+resource "aws_cloudwatch_event_target" "ec2_running_guard" {
+  count     = local.wired ? 1 : 0
+  rule      = aws_cloudwatch_event_rule.ec2_running.name
+  target_id = "h4-ec2-guard"
