+    """h4-alert-bridge's entry (infra/account/lambdas.tf), for SNS's event."""
+    records = (event or {}).get("Records") if isinstance(event, dict) else None
+    notices = [
+        r["Sns"].get("Message") or ""
+        for r in records or []
+        if isinstance(r, dict) and isinstance(r.get("Sns"), dict)
