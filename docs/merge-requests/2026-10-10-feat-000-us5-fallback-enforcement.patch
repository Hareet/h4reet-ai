+# The Author's own targets and commands (spec 000 plan §13; tasks.md T103, T104): make contract-live calls a live
+# adapter, Bedrock's paid, with an operator token; make aws-login starts prod's Bedrock session; and the Bedrock evals
+# call Bedrock through prod's paid endpoint. A paid route gets its deny with it (CLAUDE.md).
+# - A make target is two matches in one command: make (gmake, a path to either, or tools/gates/run_checks.py, which runs
+#   make), and the target's name after any character a name can't hold, so after an option or an assignment
+#   (.DEFAULT_GOAL=, --eval=), a quote, a brace, or a separator inside a quoted value. The evals need bedrock too.
+# - operator.py with contract-record, and evals/run.py or its module with bedrock, are the same two matches, so they
+#   hold through runpy, or a copy made in the same command.
+# - aws-login.sh matches where it runs, by the engine rule's starts and skips, so git add, git diff, and shellcheck
+#   naming it still work.
+# - The AWS CLI matches as aws anywhere, with sso and login, configure and sso, or sso-oidc.
+# Quotes and backslashes inside a name don't hide it. A name built at run time or held in a variable, a glob, or a copy
+# run in a command of its own does (the matrix's gap rows); the targets' own SANDBOX_RUNTIME refusals and the token and
+# session the sandbox can't read still stop those. The match is on the command's text, so a command that only names a
+# make target and make, or contract-record and operator.py, is refused too, such as git log --grep='make contract-live':
+# read with the Read and Grep tools, and commit with a message file.
+author_route="the Author runs it (spec 000 plan §13); ask the Author"
+# A name, with quotes or backslashes allowed between its characters, as an extended regular expression.
+spelled() {
+  local s="" c i
+  for ((i = 0; i < ${#1}; i++)); do
+    c="${1:i:1}"
+    if [ "$c" = . ]; then c='\.'; fi
+    s+="${c}${eq}"
+  done
+  printf '%s' "${s%"$eq"}"
+}
+nb="(^|[^[:alnum:]_.-])"
+ne="([^[:alnum:]_.-]|\$)"
+bedrock_word="${nb}$(spelled bedrock)${ne}"
+if echo "$cmd" | grep -Eq "${nb}(g${eq})?$(spelled make)${ne}|${nb}$(spelled run_checks.py)${ne}"; then
+  if echo "$cmd" | grep -Eq "${nb}($(spelled contract-live)|$(spelled aws-login))${ne}"; then
+    block "an Author-only make target" "make contract-live and make aws-login: $author_route"
+  fi
+  if echo "$cmd" | grep -Eq "${nb}$(spelled evals)${ne}" && echo "$cmd" | grep -Eq "$bedrock_word"; then
+    block "the Bedrock evals" "make evals ADAPTER=bedrock: $author_route"
+  fi
+fi
+if echo "$cmd" | grep -Eq "${nb}$(spelled operator.py)${ne}" \
+  && echo "$cmd" | grep -Eq "${nb}$(spelled contract-record)${ne}"; then
+  block "operator.py's contract-record" "$author_route"
+fi
+if echo "$cmd" | grep -Eq "${nb}($(spelled evals/run.py)|$(spelled evals.run))${ne}" \
+  && echo "$cmd" | grep -Eq "$bedrock_word"; then
+  block "the Bedrock evals" "evals/run.py --adapter bedrock: $author_route"
+fi
+if echo "$cmd" | grep -Eq "${engine_start}(${engine_skip})*[[:space:]]*[\"']?([^[:space:];&|]*/)?$(spelled aws-login.sh)${ne}"; then
+  block "aws-login.sh" "$author_route"
+fi
+if echo "$cmd" | grep -Eq "${nb}$(spelled aws)${ne}" \
+  && { echo "$cmd" | grep -Eq "${nb}$(spelled sso-oidc)${ne}" \
+    || { echo "$cmd" | grep -Eq "${nb}$(spelled sso)${ne}" \
+      && echo "$cmd" | grep -Eq "${nb}($(spelled login)|$(spelled configure))${ne}"; }; }; then
+  block "the AWS CLI's SSO sign-in" "$author_route"
+fi
