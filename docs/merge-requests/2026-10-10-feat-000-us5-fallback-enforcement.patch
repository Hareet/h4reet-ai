--- a/.claude/hooks/bash-gate.sh
+++ b/.claude/hooks/bash-gate.sh
@@ -80,6 +80,15 @@
   block "switching back to main" "$main_route"
 fi
 
+# The Author's own targets (spec 000 plan §13; tasks.md T103, T104): make contract-live calls a live adapter, Bedrock's
+# paid, with an operator token, and make aws-login starts prod's Bedrock session. Each matches by name anywhere in one
+# command, after make's options and variables and inside any wrapper, and so do the commands they run: operator.py's
+# contract-record, aws-login.sh, and the AWS CLI's sso login. The match is on the command's text, so a command that
+# only names them is refused too: read such files with the Read and Grep tools, and commit with a message file.
+echo "$cmd" | grep -Eq '(^|[^[:alnum:]_.-])make\b[^;&|]*[[:space:]"'"'"']+(contract-live|aws-login)\b' \
+  && block "an Author-only make target" "make contract-live and make aws-login are the Author's (plan §13); ask the Author"
+echo "$cmd" | grep -Eq 'operator\.py\b[^;&|]*[[:space:]]contract-record\b|\baws-login\.sh\b|(^|[;&|( ])aws\b[^;&|]*[[:space:]]sso[[:space:]]+login\b' \
+  && block "an Author-only command" "contract-record, aws-login.sh, and aws sso login are the Author's (plan §13); ask the Author"
 # Cloud control surfaces the agent may not touch.
 echo "$cmd" | grep -Eq '(^|[;&| ])aws +(iam|budgets|ce|wafv2|waf|cloudfront +update|ssm +put-parameter[^;&|]*kill-switch)' \
   && block "IAM/budget/edge/kill-switch mutation" "write an ADR and a spec; the Author applies"
