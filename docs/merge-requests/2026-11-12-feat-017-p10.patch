+    # Spec 017's P-10 (Q13): its agent configuration outside .claude/; its runner and its specs aren't.
+    before = bh.trigger_hash(repo)
+    write(repo / "deploy" / "night-shift" / "runner" / "night.py", "# the runner\n")
