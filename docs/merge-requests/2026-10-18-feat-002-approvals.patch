+#!/usr/bin/env python3
+"""The published-content check (spec 002, T080; FR-012; contracts/resume-source.md §5; research.md R-08).
+
+    python3 -I -B -X pycache_prefix=/dev/null tools/gates/content_check.py --tree DIR --room-data FILE
+        (--repo DIR | --policy-dir DIR)
+
+The room publishes a content file, the resume's source or a narration script, only when main's
+assets/policy/content-approvals.json lists the SHA-256 of its bytes. The build marks the rest drafts and lists them in
+room-data.json's `drafts`; a build without drafts (ROOM_DRAFTS unset) then leaves them out. The build's code that
+decides this, apps/web/build/approvals.ts, is agent-editable, so a branch could change it to call a draft approved.
+This check is the enforcement, in human-only code, run by make check (make content-check) and by the Author's gate
+after a build without drafts:
+  - main's approvals, from --repo (it runs `git -C DIR show main:assets/policy/content-approvals.json` itself, never
+    reading the branch's copy) or from --policy-dir (a directory the gate filled from main); absent means nothing is
+    approved;
+  - each content file's SHA-256, recomputed from --tree: apps/web/content/resume.yaml and
+    apps/web/content/narration/*.md, each a regular file, never a link;
+  - a FAIL for each file whose digest main doesn't approve and that room-data.json doesn't list in `drafts`: the
+    build published it.
+An approved file listed as a draft is only held back, which passes. It prints paths and counts, never a file's content.
+
+Exit codes: 0 every unapproved file is a draft; 1 a file is published that main doesn't approve, or room-data.json
+isn't a build's; 2 usage, or main's approvals can't be read as the contract's shape.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+APPROVALS = "assets/policy/content-approvals.json"
+CONTENT = Path("apps/web/content")
+SHA256_RE = re.compile(r"[0-9a-f]{64}")
+ID_RE = re.compile(r"C-\d{4}")
+DATE_RE = re.compile(r"\d{4}-\d{2}-\d{2}")
+KINDS = ("resume", "narration")
+
+
+class CantCheck(Exception):
+    """Exit 2: main's approvals can't be read as the contract's shape."""
+
+
+def git_env() -> dict[str, str]:
+    """git's minimum: no GIT_DIR or other GIT_* of the caller's, no replace objects, no system or global config."""
+    return {
+        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
+        "HOME": os.environ.get("HOME", "/nonexistent"),
+        "LC_ALL": "C",
+        "GIT_NO_REPLACE_OBJECTS": "1",
+        "GIT_CONFIG_NOSYSTEM": "1",
+        "GIT_CONFIG_GLOBAL": "/dev/null",
+        "GIT_TERMINAL_PROMPT": "0",
+    }
+
+
+def mains_approvals(repo: Path) -> bytes | None:
+    """main's copy of the approvals file, or None: no main, or no file on it."""
+    try:
+        done = subprocess.run(
+            ["git", "-C", str(repo), "show", f"main:{APPROVALS}"],
+            capture_output=True,
+            check=False,
+            timeout=60,
+            env=git_env(),
+            stdin=subprocess.DEVNULL,
+        )
+    except (OSError, subprocess.TimeoutExpired):
+        return None
+    return done.stdout if done.returncode == 0 else None
+
+
+def approved_digests(data: bytes | None) -> set[str]:
+    """The digests main approves, from data-model.md §4's shape, which every entry must have."""
+    if data is None:
+        return set()
+    try:
+        doc = json.loads(data.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError):
+        raise CantCheck("not JSON") from None
+    if not isinstance(doc, dict) or doc.get("schema") != 1:
+        raise CantCheck("schema isn't 1")
+    entries = doc.get("approvals")
+    if not isinstance(entries, list):
+        raise CantCheck("approvals isn't a list")
+    found = set()
+    for i, entry in enumerate(entries):
+        at = f"approvals[{i}]"
+        if not isinstance(entry, dict):
+            raise CantCheck(f"{at} isn't an object")
+        checks = (
+            ("id", lambda v: isinstance(v, str) and ID_RE.fullmatch(v), "isn't C-nnnn"),
+            ("path_when_approved", lambda v: isinstance(v, str) and v, "is missing"),
+            ("kind", lambda v: v in KINDS, "isn't resume or narration"),
+            (
+                "sha256",
+                lambda v: isinstance(v, str) and SHA256_RE.fullmatch(v),
+                "isn't 64 lowercase hex",
+            ),
+            (
+                "date",
+                lambda v: isinstance(v, str) and DATE_RE.fullmatch(v),
+                "isn't YYYY-MM-DD",
+            ),
+            ("reason", lambda v: isinstance(v, str), "is missing"),
+        )
+        for key, ok, why in checks:
+            if not ok(entry.get(key)):
+                raise CantCheck(f"{at}.{key} {why}")
+        found.add(entry["sha256"])
+    return found
+
+
+def content_files(tree: Path) -> list[str]:
+    """The resume's source, then the narration scripts in name order, as paths from the tree's root."""
+    paths = []
+    resume = CONTENT / "resume.yaml"
+    if (tree / resume).exists() or (tree / resume).is_symlink():
+        paths.append(resume.as_posix())
+    narration = tree / CONTENT / "narration"
+    if narration.is_dir():
+        paths += [
+            (CONTENT / "narration" / p.name).as_posix()
+            for p in sorted(narration.iterdir())
+            if p.name.endswith(".md")
+        ]
+    return paths
+
+
+def drafts_of(room_data: Path) -> tuple[set[str] | None, str]:
+    """room-data.json's drafts, or None with the reason it isn't a build's."""
+    try:
+        doc = json.loads(room_data.read_text(encoding="utf-8"))
+    except FileNotFoundError:
+        return (
+            None,
+            f"{room_data} doesn't exist: the build without drafts didn't run, or wrote none",
+        )
+    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
+        return None, f"{room_data} can't be read as JSON ({type(error).__name__})"
+    if not isinstance(doc, dict):
+        return None, f"{room_data} isn't an object"
+    drafts = doc.get("drafts")
+    if not isinstance(drafts, list) or not all(isinstance(d, str) for d in drafts):
+        return None, f"{room_data}'s drafts isn't a list of paths"
+    return set(drafts), ""
+
+
+def main(argv: list[str]) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--tree", type=Path, required=True)
+    parser.add_argument("--room-data", type=Path, required=True)
+    source = parser.add_mutually_exclusive_group(required=True)
+    source.add_argument("--repo", type=Path)
+    source.add_argument("--policy-dir", type=Path)
+    args = parser.parse_args(argv)
+
+    if args.repo is not None:
+        data = mains_approvals(args.repo)
+    else:
+        path = args.policy_dir / Path(APPROVALS).name
+        data = path.read_bytes() if path.is_file() and not path.is_symlink() else None
+    try:
+        approved = approved_digests(data)
+    except CantCheck as error:
+        print(
+            f"content check: can't check: main's content-approvals.json: {error}",
+            file=sys.stderr,
+        )
+        return 2
+
+    drafts, why = drafts_of(args.room_data)
+    if drafts is None:
+        print(f"FAIL room-data.json: {why}")
+        print("content check: 1 problem (room-data.json isn't a build's)")
+        return 1
+
+    paths = content_files(args.tree)
+    problems = []
+    held = approved_count = 0
+    for rel in paths:
+        full = args.tree / rel
+        if full.is_symlink() or not full.is_file():
+            problems.append(
+                f"FAIL {rel}: not a regular file: a content file is never a link"
+            )
+            continue
+        digest = hashlib.sha256(full.read_bytes()).hexdigest()
+        if digest in approved:
+            approved_count += 1
+            continue
+        if rel in drafts:
+            held += 1
+            continue
+        problems.append(f"FAIL {rel}: published, and main doesn't approve its SHA-256")
+    for line in problems:
+        print(line)
+    if problems:
+        print(
+            f"content check: {len(problems)} problem(s) in {len(paths)} content files"
+        )
+        return 1
+    if not paths:
+        print("content check: PASS (no content files yet)")
+    else:
+        print(
+            f"content check: PASS ({len(paths)} content files: {approved_count} approved by main, "
+            f"{held} drafts, all listed in room-data.json's drafts)"
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
