@@ -0,0 +1,398 @@
+"""Tests for tools/gates/content_check.py: the published-content check (spec 002, T080; contracts/resume-source.md §5).
+
+The build's own approvals code (apps/web/build/approvals.ts) is agent-editable, so a branch could make it call a
+draft approved. This check is the enforcement, in human-only code: it reads main's approvals itself, recomputes each
+content file's SHA-256 from the tree, and fails when room-data.json leaves a file main doesn't approve out of its
+drafts, which is to say publishes it. The fixtures below are builds of that kind: room-data.json files as a build
+would write them, honest or not. Every digest is made at run time.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[3]
+SCRIPT = REPO / "tools" / "gates" / "content_check.py"
+SPEC = importlib.util.spec_from_file_location("content_check", SCRIPT)
+assert SPEC and SPEC.loader
+cc = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = cc
+SPEC.loader.exec_module(cc)
+
+RESUME = "apps/web/content/resume.yaml"
+NARRATION = "apps/web/content/narration/x.engineer.md"
+RESUME_TEXT = "version: 1\nsections: []\n"
+NARRATION_TEXT = "---\nitem: x\npath: engineer\n---\nWords the room would say.\n"
+
+
+def sha(text: str) -> str:
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def approvals(*digests: str) -> str:
+    return json.dumps(
+        {
+            "schema": 1,
+            "approvals": [
+                {
+                    "id": f"C-{i:04d}",
+                    "path_when_approved": RESUME,
+                    "kind": "resume",
+                    "sha256": digest,
+                    "date": "2026-10-18",
+                    "reason": "a stand-in approval, made by the test",
+                }
+                for i, digest in enumerate(digests, 1)
+            ],
+        }
+    )
+
+
+def make_tree(root: Path, files: dict[str, str] | None = None) -> Path:
+    files = {RESUME: RESUME_TEXT, NARRATION: NARRATION_TEXT} if files is None else files
+    for rel, text in files.items():
+        (root / rel).parent.mkdir(parents=True, exist_ok=True)
+        (root / rel).write_text(text, encoding="utf-8")
+    return root
+
+
+def room_data(path: Path, drafts: object, **extra: object) -> Path:
+    """What a build writes: room-data.json, with the drafts it says it left out."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        json.dumps({"built_from": {"policy": "x"}, "drafts": drafts, **extra}),
+        encoding="utf-8",
+    )
+    return path
+
+
+def policy_dir(root: Path, approvals_text: str | None) -> Path:
+    folder = root / "policy"
+    folder.mkdir(parents=True, exist_ok=True)
+    if approvals_text is not None:
+        (folder / "content-approvals.json").write_text(approvals_text, encoding="utf-8")
+    return folder
+
+
+def run(tree: Path, data: Path, *source: str) -> int:
+    return cc.main(["--tree", str(tree), "--room-data", str(data), *source])
+
+
+@pytest.fixture
+def tree(tmp_path: Path) -> Path:
+    return make_tree(tmp_path / "tree")
+
+
+# --------------------------------------------------------------------------------------------------
+# What a build may publish
+# --------------------------------------------------------------------------------------------------
+def test_a_build_that_lists_every_draft_passes(
+    tmp_path: Path, tree: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    folder = policy_dir(tmp_path, approvals(sha(RESUME_TEXT)))
+    data = room_data(tmp_path / "dist/room-data.json", [NARRATION])
+    assert run(tree, data, "--policy-dir", str(folder)) == 0
+    out = capsys.readouterr().out
+    assert (
+        "content check: PASS" in out
+        and "2 content files" in out
+        and "1 approved by main" in out
+    )
+
+
+def test_a_build_whose_code_marks_a_draft_approved_fails(
+    tmp_path: Path, tree: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    # The build's approvals code said the script was approved and left it out of drafts; main never approved it.
+    folder = policy_dir(tmp_path, approvals(sha(RESUME_TEXT)))
+    data = room_data(tmp_path / "dist/room-data.json", [])
+    assert run(tree, data, "--policy-dir", str(folder)) == 1
+    out = capsys.readouterr().out
+    assert f"FAIL {NARRATION}: published, and main doesn't approve its SHA-256" in out
+    assert RESUME not in out.replace(
+        "content check", ""
+    )  # the approved one isn't named
+
+
+def test_an_edit_after_approval_makes_a_draft_again(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    tree = make_tree(tmp_path / "tree", {RESUME: RESUME_TEXT + "edited: true\n"})
+    folder = policy_dir(tmp_path, approvals(sha(RESUME_TEXT)))
+    data = room_data(tmp_path / "dist/room-data.json", [])
+    assert run(tree, data, "--policy-dir", str(folder)) == 1
+    assert f"FAIL {RESUME}: published" in capsys.readouterr().out
+
+
+def test_with_no_approvals_on_main_every_file_is_a_draft(
+    tmp_path: Path, tree: Path
+) -> None:
+    folder = policy_dir(tmp_path, None)
+    assert (
+        run(tree, room_data(tmp_path / "a.json", [RESUME]), "--policy-dir", str(folder))
+        == 1
+    )
+    assert (
+        run(
+            tree,
+            room_data(tmp_path / "b.json", [RESUME, NARRATION]),
+            "--policy-dir",
+            str(folder),
+        )
+        == 0
+    )
+
+
+def test_an_approved_file_listed_as_a_draft_is_only_held_back(
+    tmp_path: Path, tree: Path
+) -> None:
+    folder = policy_dir(tmp_path, approvals(sha(RESUME_TEXT), sha(NARRATION_TEXT)))
+    data = room_data(tmp_path / "dist/room-data.json", [RESUME, NARRATION])
+    assert run(tree, data, "--policy-dir", str(folder)) == 0
+
+
+def test_only_the_resume_and_the_scripts_are_content(tmp_path: Path) -> None:
+    # The fixed messages are reviewed in the branch, not approved by hash (data-model.md §1 and §7).
+    tree = make_tree(
+        tmp_path / "tree",
+        {
+            "apps/web/content/messages.yaml": "- {id: x, text: y}\n",
+            "apps/web/src/main.ts": "x\n",
+        },
+    )
+    folder = policy_dir(tmp_path, None)
+    assert (
+        run(tree, room_data(tmp_path / "d.json", []), "--policy-dir", str(folder)) == 0
+    )
+
+
+def test_no_content_files_yet_passes_and_says_so(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    tree = make_tree(tmp_path / "tree", {})
+    folder = policy_dir(tmp_path, None)
+    assert (
+        run(tree, room_data(tmp_path / "d.json", []), "--policy-dir", str(folder)) == 0
+    )
+    assert "no content files yet" in capsys.readouterr().out
+
+
+def test_a_content_file_that_is_a_link_fails(tmp_path: Path) -> None:
+    tree = make_tree(tmp_path / "tree", {})
+    (tree / "apps/web/content").mkdir(parents=True)
+    (tmp_path / "elsewhere.yaml").write_text(RESUME_TEXT, encoding="utf-8")
+    (tree / RESUME).symlink_to(tmp_path / "elsewhere.yaml")
+    folder = policy_dir(tmp_path, approvals(sha(RESUME_TEXT)))
+    assert (
+        run(tree, room_data(tmp_path / "d.json", []), "--policy-dir", str(folder)) == 1
+    )
+
+
+def test_the_output_names_paths_and_never_content(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    phrase = "a sentence only the content holds"
+    tree = make_tree(tmp_path / "tree", {NARRATION: f"---\nitem: x\n---\n{phrase}\n"})
+    folder = policy_dir(tmp_path, None)
+    assert (
+        run(tree, room_data(tmp_path / "d.json", []), "--policy-dir", str(folder)) == 1
+    )
+    captured = capsys.readouterr()
+    assert phrase not in captured.out + captured.err
+
+
+# --------------------------------------------------------------------------------------------------
+# room-data.json, as the build wrote it
+# --------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize(
+    "text",
+    [
+        None,  # no room-data.json: the build didn't run, or wrote none
+        "{",
+        json.dumps([]),
+        json.dumps({"built_from": {}}),
+        json.dumps({"drafts": RESUME}),
+        json.dumps({"drafts": [RESUME, 3]}),
+    ],
+)
+def test_a_room_data_file_that_isnt_a_builds_fails(
+    tmp_path: Path, tree: Path, text: str | None
+) -> None:
+    data = tmp_path / "dist/room-data.json"
+    if text is not None:
+        data.parent.mkdir(parents=True)
+        data.write_text(text, encoding="utf-8")
+    folder = policy_dir(tmp_path, None)
+    assert run(tree, data, "--policy-dir", str(folder)) == 1
+
+
+# --------------------------------------------------------------------------------------------------
+# main's approvals: from a policy directory the gate filled, or read from main by this script itself
+# --------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize(
+    "text",
+    [
+        "{",
+        json.dumps({"schema": 2, "approvals": []}),
+        json.dumps({"schema": 1}),
+        json.dumps({"schema": 1, "approvals": {}}),
+        json.dumps({"schema": 1, "approvals": [{"sha256": "abc"}]}),
+        approvals("A" * 64),
+        approvals(sha("x")).replace('"kind": "resume"', '"kind": "poem"'),
+        approvals(sha("x")).replace('"id": "C-0001"', '"id": "C-1"'),
+        approvals(sha("x")).replace('"date": "2026-10-18"', '"date": "18 October"'),
+    ],
+)
+def test_approvals_that_arent_the_contracts_shape_stop_the_check(
+    tmp_path: Path, tree: Path, text: str, capsys: pytest.CaptureFixture[str]
+) -> None:
+    folder = policy_dir(tmp_path, text)
+    data = room_data(tmp_path / "dist/room-data.json", [RESUME, NARRATION])
+    assert run(tree, data, "--policy-dir", str(folder)) == 2
+    assert "content-approvals.json" in capsys.readouterr().err
+
+
+def git(repo: Path, *args: str) -> str:
+    done = subprocess.run(
+        ["git", "-C", str(repo), *args],
+        capture_output=True,
+        text=True,
+        check=True,
+        env={
+            "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
+            "HOME": str(repo),
+            "GIT_CONFIG_NOSYSTEM": "1",
+            "GIT_AUTHOR_NAME": "t",
+            "GIT_AUTHOR_EMAIL": "t@example.invalid",
+            "GIT_COMMITTER_NAME": "t",
+            "GIT_COMMITTER_EMAIL": "t@example.invalid",
+        },
+    )
+    return done.stdout.strip()
+
+
+def make_repo(
+    root: Path, main_approvals: str | None, branch_approvals: str | None = None
+) -> Path:
+    """A checkout on a branch, with main's approvals (None: no main at all) and the branch's own copy."""
+    root.mkdir(parents=True)
+    git(root, "init", "-q", "-b", "main" if main_approvals is not None else "other")
+    make_tree(root)
+    if main_approvals is not None:
+        (root / "assets/policy").mkdir(parents=True)
+        (root / "assets/policy/content-approvals.json").write_text(
+            main_approvals, encoding="utf-8"
+        )
+    git(root, "add", "-A")
+    git(root, "commit", "-qm", "base")
+    git(root, "switch", "-qc", "feature")
+    if branch_approvals is not None:
+        (root / "assets/policy").mkdir(parents=True, exist_ok=True)
+        (root / "assets/policy/content-approvals.json").write_text(
+            branch_approvals, encoding="utf-8"
+        )
+        git(root, "add", "-A")
+        git(root, "commit", "-qm", "the branch approves itself")
+    return root
+
+
+def test_the_branchs_own_approvals_are_never_read(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    repo = make_repo(
+        tmp_path / "repo",
+        approvals(sha(RESUME_TEXT)),
+        branch_approvals=approvals(sha(RESUME_TEXT), sha(NARRATION_TEXT)),
+    )
+    data = room_data(tmp_path / "dist/room-data.json", [])
+    assert run(repo, data, "--repo", str(repo)) == 1
+    assert f"FAIL {NARRATION}: published" in capsys.readouterr().out
+    assert (
+        run(repo, room_data(tmp_path / "ok.json", [NARRATION]), "--repo", str(repo))
+        == 0
+    )
+
+
+def test_no_main_approves_nothing(tmp_path: Path) -> None:
+    repo = make_repo(
+        tmp_path / "repo", None, branch_approvals=approvals(sha(RESUME_TEXT))
+    )
+    assert (
+        run(repo, room_data(tmp_path / "a.json", [NARRATION]), "--repo", str(repo)) == 1
+    )
+    assert (
+        run(
+            repo,
+            room_data(tmp_path / "b.json", [RESUME, NARRATION]),
+            "--repo",
+            str(repo),
+        )
+        == 0
+    )
+
+
+def test_git_reads_main_without_replace_objects_or_the_callers_settings(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    repo = make_repo(tmp_path / "repo", approvals(sha(RESUME_TEXT)))
+    seen: list[tuple[list[str], dict[str, str]]] = []
+    real = subprocess.run
+
+    def spy(argv, *args, **kwargs):  # type: ignore[no-untyped-def]
+        seen.append((list(argv), dict(kwargs.get("env") or {})))
+        return real(argv, *args, **kwargs)
+
+    monkeypatch.setattr(cc.subprocess, "run", spy)
+    monkeypatch.setenv("GIT_DIR", str(tmp_path / "elsewhere"))
+    assert (
+        run(repo, room_data(tmp_path / "d.json", [NARRATION]), "--repo", str(repo)) == 0
+    )
+    assert [a for a, _ in seen] == [
+        ["git", "-C", str(repo), "show", "main:assets/policy/content-approvals.json"]
+    ]
+    (env,) = [e for _, e in seen]
+    assert env["GIT_NO_REPLACE_OBJECTS"] == "1" and "GIT_DIR" not in env
+
+
+def test_it_runs_isolated_by_path(tmp_path: Path, tree: Path) -> None:
+    # As make check and the gate run it: python3 -I -B -X pycache_prefix=/dev/null, by path, never -m.
+    folder = policy_dir(tmp_path, None)
+    data = room_data(tmp_path / "d.json", [RESUME, NARRATION])
+    done = subprocess.run(
+        [
+            sys.executable,
+            "-I",
+            "-B",
+            "-X",
+            "pycache_prefix=/dev/null",
+            str(SCRIPT),
+            "--tree",
+            str(tree),
+            "--room-data",
+            str(data),
+            "--policy-dir",
+            str(folder),
+        ],
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=60,
+    )
+    assert done.returncode == 0, done.stdout + done.stderr
+    assert done.stdout.strip().splitlines()[-1].startswith("content check: PASS")
+
+
+def test_it_takes_one_source_of_main_approvals(tmp_path: Path, tree: Path) -> None:
+    data = room_data(tmp_path / "d.json", [])
+    with pytest.raises(SystemExit):
+        run(tree, data)
+    with pytest.raises(SystemExit):
+        run(tree, data, "--repo", str(tree), "--policy-dir", str(tmp_path))
