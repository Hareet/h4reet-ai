+def bash_function(name: str, *args: str) -> str:
+    done = subprocess.run(
+        ["bash", "-c", function(name) + f'{name} "$@"\n', "bash", *args],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    return done.stdout.strip()
+
