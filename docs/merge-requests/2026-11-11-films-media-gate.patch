+def box_name(raw: bytes) -> str:
+    """A box's type, a brand, or a handler, quoted, when it's four plain characters; never the raw bytes otherwise."""
+    return (
+        f"'{raw.decode('ascii')}'"
+        if re.fullmatch(rb"[A-Za-z0-9 ]{4}", raw)
+        else "of no readable type"
+    )
