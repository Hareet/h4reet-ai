{
  "comment": "Recipes for the secret shapes of contracts/telemetry.md §6.3. A test assembles each value at run time by joining its parts ({\"repeat\": s, \"times\": n} repeats s), so no file holds a token-shaped string. The gateway's redactor (test/unit/redact.test.ts) and the collector's copy of the patterns (deploy/otel/collector.yaml, in deploy/scripts/test_observability.py) are checked against the same recipes. Each case is: before, the secret, after; masked, it reads before ****after.",
  "cases": [
    {
      "shape": "Langfuse secret key",
      "before": "key ",
      "parts": ["sk", "-lf-", { "repeat": "a1b2", "times": 9 }],
      "after": " end"
    },
    {
      "shape": "Langfuse public key",
      "before": "user=",
      "parts": ["pk", "-lf-", { "repeat": "c3d4", "times": 9 }],
      "after": ""
    },
    {
      "shape": "AWS access key ID",
      "before": "id ",
      "parts": ["AK", "IA", { "repeat": "Q", "times": 16 }],
      "after": " here"
    },
    {
      "shape": "AWS temporary key ID",
      "before": "(",
      "parts": ["AS", "IA", { "repeat": "Z7", "times": 8 }],
      "after": ")"
    },
    {
      "shape": "Telegram bot token in a URL",
      "before": "https://api.telegram.org/",
      "parts": ["bot", "1234567", "89:", { "repeat": "Ab_-", "times": 9 }],
      "after": "/sendMessage"
    },
    {
      "shape": "Telegram bot token alone",
      "before": "t=",
      "parts": ["98765", "4321:", { "repeat": "xY", "times": 16 }],
      "after": ""
    },
    {
      "shape": "operator token",
      "before": "got ",
      "parts": ["h4op", "_prod_", { "repeat": "q", "times": 43 }],
      "after": " ok"
    },
    {
      "shape": "dev-cpu operator token",
      "before": "",
      "parts": ["h4op", "_devcpu_", { "repeat": "w", "times": 43 }],
      "after": "."
    },
    {
      "shape": "JWT",
      "before": "jwt ",
      "parts": [
        "ey",
        "J",
        { "repeat": "h", "times": 10 },
        ".ey",
        "J",
        { "repeat": "p", "times": 10 },
        ".",
        { "repeat": "s", "times": 10 }
      ],
      "after": " done"
    },
    {
      "shape": "Bearer credential",
      "before": "header: ",
      "parts": ["Bear", "er ", { "repeat": "t0k", "times": 4 }],
      "after": ""
    },
    {
      "shape": "Basic credential",
      "before": "",
      "parts": ["basic", " ", { "repeat": "dXNl", "times": 3 }],
      "after": " x"
    },
    {
      "shape": "URL credentials",
      "before": "connect ",
      "parts": ["postgres", "://gateway:", { "repeat": "pw", "times": 5 }, "@"],
      "after": "gateway-state:5432/gateway"
    },
    {
      "shape": "PEM block",
      "before": "<",
      "parts": [
        "-----BEGIN ",
        "PRIVATE KEY-----\n",
        { "repeat": "MIIB", "times": 4 },
        "\n-----END ",
        "PRIVATE KEY-----"
      ],
      "after": ">"
    },
    {
      "shape": "password=value",
      "before": "set ",
      "parts": ["pass", "word=", { "repeat": "hunter", "times": 2 }],
      "after": " now"
    },
    {
      "shape": "api_key: value",
      "before": "",
      "parts": ["API_", "KEY: ", { "repeat": "k9", "times": 6 }],
      "after": ";"
    },
    {
      "shape": "token=value",
      "before": "?",
      "parts": ["tok", "en=", { "repeat": "zz", "times": 4 }],
      "after": ", next"
    }
  ]
}
