{
  "name": "@h4reet/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "The provider-agnostic model gateway: routing, the meter, and the kill switch (spec 000, plan §5).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint --max-warnings 0 . && tsc --noEmit -p .",
    "fmt": "prettier --write src test vitest.config.ts package.json tsconfig.json tsconfig.build.json",
    "validate-config": "node --import tsx src/config/validate-config.ts",
    "contract:replay": "vitest run test/contract"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@aws-sdk/client-bedrock-runtime": "3.1147.0",
    "@aws-sdk/credential-providers": "3.1147.0",
    "@fastify/otel": "0.21.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/instrumentation-pino": "0.69.0",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@smithy/node-http-handler": "4.12.1",
    "fastify": "5.12.5",
    "nodemailer": "10.0.16",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "aws-sdk-client-mock": "4.1.0",
    "aws-sdk-client-mock-vitest": "8.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
