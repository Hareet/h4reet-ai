# The one list of tool versions that humans, agents, the devcontainer, and the gate use (plan §9, ADR 0018).
# KEY=VALUE lines, read as data and never sourced. tools/gates/toolchain_check.py compares what is installed
# against them, and its test keeps .devcontainer/Dockerfile's build arguments equal to them.
# A pin matches its exact version, or any release in its series: "3.12" matches 3.12.3.
# Pins for tools `make tools` doesn't install are the host's versions on 2026-10-08 (tasks.md T013).
NODE_VERSION=24.21.0
UV_VERSION=0.8.22
RUFF_VERSION=0.16.10
GITLEAKS_VERSION=8.30.1
PYTEST_VERSION=9.1.1
PYYAML_VERSION=6.0.3
PYTHON_VERSION=3.12
SHELLCHECK_VERSION=0.9.0
JQ_VERSION=1.7
CLAUDE_CODE_VERSION=2.1.295
ESLINT_VERSION=10.12.0
TYPESCRIPT_ESLINT_VERSION=8.71.1
TYPESCRIPT_VERSION=6.0.3
PRETTIER_VERSION=3.9.9
