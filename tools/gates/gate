class Refusal(Exception):
    """The gate won't start: a usage error, the sandbox, the wrong copy or checkout, or a file that isn't a recording.
    Exit 2."""


class Stop(Exception):
    """The export's proof failed, so nothing after it may run. Exit 1."""


@dataclass
class Step:
    name: str
    status: str = "PASS"
    notes: list[str] = field(default_factory=list)

    def set(self, status: str, note: str) -> Step:
        self.status = status
        self.notes.append(note)
        return self

    def fail(self, note: str) -> Step:
        return self.set("FAIL", note)


@dataclass
class Report:
    steps: list[Step] = field(default_factory=list)

    def add(self, step: Step) -> Step:
        self.steps.append(step)
        note = f" ({'; '.join(step.notes)})" if step.notes else ""
        say(f"-> {step.status} {step.name}{note}")
        return step

    def status(self, name: str) -> str:
        return next((s.status for s in self.steps if s.name == name), "")

    def failing(self) -> list[Step]:
        return [s for s in self.steps if s.status in ("FAIL", "PENDING")]


