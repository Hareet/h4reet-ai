def githooks(repo: Path) -> Step:
    """make githooks-check's checks, in this file, since the gate never runs make on the host."""
    begin("githooks")
    step = Step("githooks")
    found = git(repo, "rev-parse", "--path-format=absolute", "--git-path", "hooks")
    hooks = Path(found.stdout.strip())
    if found.returncode or not hooks.is_absolute():
        return step.fail("git didn't name the hooks directory")
    problems = []
    for name in ("reference-transaction", "pre-commit"):
        source = repo / ".claude" / "git-hooks" / name
        installed = hooks / name
        if not source.is_file():
            problems.append(
                f"{name}: .claude/git-hooks/{name} is missing from the main working tree"
            )
        elif (
            not installed.is_file()
            or installed.read_bytes() != source.read_bytes()
            or not os.access(installed, os.X_OK)
        ):
            problems.append(
                f"{name}: missing, modified, or not executable in {hooks}: run make git-hooks"
            )
        else:
            say(f"{name}: installed")
    if git(repo, "config", "--get", "core.hooksPath").stdout.strip():
        problems.append("core.hooksPath is set, so git runs other hooks")
    if git(repo, "config", "--get", "gc.packRefs").stdout.strip() != "false":
        problems.append(
            "gc.packRefs isn't false, so gc may pack main out of the hook's reach"
        )
    ref = git(
        repo, "rev-parse", "--path-format=absolute", "--git-path", "refs/heads/main"
    )
    if Path(ref.stdout.strip()).is_file():
        say("main: a loose ref, which the git hook guards")
    elif (
        git(repo, "show-ref", "--verify", "--quiet", "refs/heads/main").returncode == 0
    ):
        problems.append("main is packed, out of the git hook's reach")
    else:
        say("main: no such branch in this clone")
    for problem in problems:
        say(problem)
    return step.fail("; ".join(problems)) if problems else step


def node_bin(export_dir: Path) -> str | None:
    """The pinned Node from nvm, which the Makefile puts first on PATH for its own recipes (plan §9)."""
    try:
        pins = (export_dir / ".devcontainer" / "toolchain.vars").read_text(
            encoding="utf-8"
        )
    except OSError:
        return None
    pin = re.search(r"^NODE_VERSION=(\d+\.\d+\.\d+)$", pins, re.MULTILINE)
    nvm = Path(os.environ.get("NVM_DIR") or Path.home() / ".nvm")
    found = nvm / "versions" / "node" / f"v{pin.group(1)}" / "bin" if pin else None
    return str(found) if found and found.is_dir() else None


def toolchain(repo: Path, export_dir: Path, tmp: Path) -> Step:
    begin("toolchain", "the host's tools against the export's pins")
    env = tool_env()
    pinned = node_bin(export_dir)
    if pinned:
        env["PATH"] = f"{pinned}:{env['PATH']}"
    rc, out = stream(
        py_host(
            repo / "tools" / "gates" / "toolchain_check.py",
            str(export_dir / ".devcontainer" / "toolchain.vars"),
        ),
        env,
        tmp,
    )
    step = classify(Step("toolchain"), rc, out)
    # A Claude Code newer than its floor passes the check with a WARN line (ADR 0023): the step is WARN, which the
    # summary line counts, so the merge commit records it, and which the merge doesn't wait on.
    warned = [ln for ln in out.splitlines() if ln.startswith("WARN:")]
    if step.status == "PASS" and warned:
        step.status, step.notes = "WARN", warned
    return step


def policy(repo: Path, export_dir: Path, tmp: Path) -> Step:
    begin("policy", "the compose and file policy over the export")
    rc, out = stream(
        py_host(
            repo / "tools" / "gates" / "compose_policy.py", "--root", str(export_dir)
        ),
        tool_env(),
        tmp,
    )
    return classify(Step("policy"), rc, out)


def corpus(repo: Path, export_dir: Path) -> Step:
    """The main tree's check_corpus, pointed at the export's corpus and the Author's denylist, in this process."""
    begin("corpus", "the export's corpus, with the Author's denylist")
    step = Step("corpus")
    checker = repo / "corpus" / "tools" / "check_corpus.py"
    private = repo / "corpus" / "intake" / "private"
    if not checker.is_file():
        return step.fail(f"{checker} is missing")
    if not (private / "denylist.txt").is_file():
        return step.fail(
            f"the Author's denylist, {private / 'denylist.txt'}, is missing, so the corpus can't be checked against it"
        )
    spec = importlib.util.spec_from_file_location("h4gate_check_corpus", checker)
    if spec is None or spec.loader is None:
        return step.fail(f"can't load {checker}")
    out = io.StringIO()
    try:
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        module.ROOT = export_dir / "corpus"
        # Where the denylist is. None of the export's files is under it, so none is skipped as private.
        module.PRIVATE = private
        with contextlib.redirect_stdout(out):
            rc = module.main()
    except Exception as exc:  # noqa: BLE001 (the export's files are data: a bad one fails the step, not the gate)
        return step.fail(f"check_corpus stopped: {type(exc).__name__}: {exc}")
    text = out.getvalue()
    for line in text.splitlines():
        say(line)
    if "denylist applied" not in text:
        return step.fail("the denylist wasn't applied")
    return classify(step, rc, text)


def holds_nothing(path: Path) -> bool:
    """Nothing, the empty file a killed sandbox session leaves, or the sandbox's /dev/null mask: no entry."""
    if not os.path.lexists(path):
        return True
    info = os.lstat(path)
    if stat.S_ISREG(info.st_mode):
        return info.st_size == 0
    if stat.S_ISCHR(info.st_mode):
        return (os.major(info.st_rdev), os.minor(info.st_rdev)) == (1, 3)
    return False  # a link, a FIFO, a directory


def fresh_dir(parent: Path) -> Path:
    """A fresh, empty directory, or an exception: never an empty or reused path (research.md R-35)."""
    path = Path(tempfile.mkdtemp(dir=parent))
    if (
        not path.is_absolute()
        or path.is_symlink()
        or not path.is_dir()
        or any(path.iterdir())
    ):
        raise OSError(f"mkdtemp gave {path}, not a fresh empty directory")
    return path


def run_gitleaks(
    binary: str, scan: list[str], config: Path, source: str, cwd: Path | None, tmp: Path
) -> tuple[list[dict], str, list[str]]:
    """One gitleaks run with plan §11's flags: its findings, its log, and every reason its scan may be partial, read
    as publish_check.py reads them. The ignore path is a fresh empty directory, which is the working directory too
    unless cwd names one. Raises OSError when there is no fresh directory."""
    empty, reports = fresh_dir(tmp), fresh_dir(tmp)
    report_file = reports / "gitleaks.json"
    rc, log = stream(
        [
            binary, *scan, "--no-banner", "--no-color", "--redact", "--config", str(config),
            "--gitleaks-ignore-path", str(empty), "--ignore-gitleaks-allow", "--report-format", "json",
            "--report-path", str(report_file), "--exit-code", str(LEAKS), source,
        ],
        tool_env(GIT_NO_REPLACE_OBJECTS="1"),
        cwd or empty,
    )  # fmt: skip
    problems = []
    errors = [
        ln for ln in log.splitlines() if ln.strip() and not GITLEAKS_FINE.match(ln)
    ]
    if errors:
        problems.append(
            f"gitleaks logged an error, so its scan may be partial: {errors[0].strip()[:200]}"
        )
    if rc not in (0, LEAKS):
        problems.append(f"gitleaks exited {rc}")
    try:
        findings = json.loads(report_file.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return [], log, [*problems, "gitleaks' report is missing or unreadable"]
    if not isinstance(findings, list) or not all(isinstance(f, dict) for f in findings):
        return [], log, [*problems, "gitleaks' report isn't a list of findings"]
    if rc in (0, LEAKS) and (rc == LEAKS) != bool(findings):
        problems.append(
            f"gitleaks exited {rc} with {len(findings)} finding(s) in its report"
        )
    return findings, log, problems


def scan_verdict(step: Step, findings: list[dict], problems: list[str]) -> Step:
    """Each finding named by its rule, file, line, and commit, never its match; then the step's status."""
    for found in findings:
        commit = str(found.get("Commit") or "")[:12]
        say(
            f"  {found.get('RuleID')} in {found.get('File')}:{found.get('StartLine')}"
            + (f" (commit {commit})" if commit else "")
        )
    if findings:
        problems = [
            f"{len(findings)} finding(s), named above without their match",
            *problems,
        ]
    return step.fail("; ".join(problems)) if problems else step


def added_lines(repo: Path, base: str, sha: str) -> int | None:
    """The lines the branch's commits add, counted in the patch gitleaks reads (git log -p --text), or None when git
    can't say. gitleaks counts a commit as scanned only when its diff has a hunk, so a branch that adds no line
    (deletions, renames, mode changes, merges, or empty commits) honestly scans none. --numstat counts no line in what
    git takes for binary, even with --text."""
    done = git(
        repo, "log", "-p", "-U0", "--text", "--no-textconv", "--no-ext-diff", "--no-color", "--format=",
        f"{base}..{sha}", binary=True,
    )  # fmt: skip
    if done.returncode:
        return None
    added, in_hunk = 0, False
    for line in done.stdout.split(b"\n"):
        if line.startswith(b"diff --git "):
            in_hunk = False
        elif line.startswith(b"@@ "):
            in_hunk = True
        elif in_hunk and line.startswith(b"+"):
            added += 1
    return added


def holds_content(top: Path) -> bool:
    """Whether a tree holds a regular file with a byte in it."""
    for folder, _, names in os.walk(top):
        for name in names:
            info = os.lstat(os.path.join(folder, name))
            if stat.S_ISREG(info.st_mode) and info.st_size:
                return True
    return False


def gitleaks(repo: Path, sha: str, base: str | None, tmp: Path) -> Step:
    begin("gitleaks", f"the commits since main, with {repo / '.gitleaks.toml'}")
    step = Step("gitleaks")
    binary = shutil.which("gitleaks")
    if binary is None:
        return step.fail(
            "gitleaks isn't installed, so nothing was scanned (make tools)"
        )
    config = repo / ".gitleaks.toml"
    if not config.is_file():
        return step.fail(f"no .gitleaks.toml in {repo}, so nothing was scanned")
    if not holds_nothing(repo / ".gitleaksignore"):
        return step.fail(
            f"a .gitleaksignore in {repo} would switch findings off (research.md R-36); nothing was scanned"
        )
    if base is None:
        return step.fail(
            "no merge base with main, so the branch's commits can't be scanned"
        )
    added = added_lines(repo, base, sha)
    if added is None:
        return step.fail(
            "git log couldn't count the lines the branch adds, so nothing was scanned"
        )
    # git log's --text: without it git shows no diff for what it takes for binary, a NUL byte or a -diff attribute in
    # any .gitattributes in the work tree, even an untracked one, and gitleaks reads only what git shows.
    try:
        findings, log, problems = run_gitleaks(
            binary,
            ["git", f"--log-opts=--text {base}..{sha}"],
            config,
            str(repo),
            None,
            tmp,
        )
    except OSError as exc:
        return step.fail(f"no fresh directory for gitleaks: {exc}")
    scanned = GITLEAKS_COMMITS.search(log)
    if scanned is None:
        problems.append("gitleaks didn't say how many commits it scanned")
    elif added and int(scanned.group(1)) == 0:
        problems.append(
            f"gitleaks scanned 0 commits, though the branch adds {added} line(s)"
        )
    return scan_verdict(step, findings, problems)


def gitleaks_tree(repo: Path, export_dir: Path, tmp: Path) -> Step:
    """gitleaks dir over the export, the tree the merge writes: it reads files as they are, whatever git takes for
    binary, and what a merge's resolution added, which git log shows no diff for."""
    begin("gitleaks-tree", "the export, the tree the merge writes, in dir mode")
    step = Step("gitleaks-tree")
    binary = shutil.which("gitleaks")
    if binary is None:
        return step.fail(
            "gitleaks isn't installed, so nothing was scanned (make tools)"
        )
    config = repo / ".gitleaks.toml"
    if not config.is_file():
        return step.fail(f"no .gitleaks.toml in {repo}, so nothing was scanned")
    # dir mode obeys a .gitleaksignore at the folder it scans whatever its flags (research.md R-36), and the branch
    # wrote any there, so anything at all refuses.
    planted = sorted(
        name for name in os.listdir(export_dir) if name.lower() == ".gitleaksignore"
    )
    if planted:
        return step.fail(
            f"the commit has {planted[0]} at its root, which gitleaks dir would obey whatever its flags "
            "(research.md R-36); nothing was scanned"
        )
    # From inside the export, so dir mode walks paths relative to the tree: the config's ^-anchored allowlists match
    # them, and findings are named by them.
    try:
        findings, log, problems = run_gitleaks(
            binary, ["dir"], config, ".", export_dir, tmp
        )
    except OSError as exc:
        return step.fail(f"no fresh directory for gitleaks: {exc}")
    skipped = GITLEAKS_SKIPPED.search(log)
    if skipped:
        problems.append(
            f"gitleaks skipped what it couldn't read: {skipped.group(0).strip()[:200]}"
        )
    scanned = GITLEAKS_BYTES.search(log)
    if scanned is None:
        problems.append("gitleaks didn't say how much it scanned")
    elif int(scanned.group(1)) == 0 and holds_content(export_dir):
        problems.append("gitleaks scanned 0 bytes of a tree that holds some")
    return scan_verdict(step, findings, problems)


def arrival(repo: Path, sha: str, base: str | None, tmp: Path) -> Step:
    """Spec 003's arrival check over the branch's commits: the main tree's own code, the commits read as git data
    (contracts/arrival-check.md §1). The branch's credits renderer runs in the container phase, never here."""
    begin(
        "arrival",
        "the studio's files in every commit since main, against the main branch's policy",
    )
    step = Step("arrival")
    checker = repo / "tools" / "gates" / "arrival_check.py"
    if not checker.is_file():
        return step.fail(f"{checker} is missing (spec 003, Phase 2)")
    if base is None:
        return step.fail(
            "no merge base with main, so the commits since main can't be named"
        )
    rc, out = stream(
        py_host(checker, "--repo", str(repo), "--range", f"{base}..{sha}"),
        tool_env(GIT_NO_REPLACE_OBJECTS="1"),
        tmp,
    )
    if rc not in (0, 1):
        return step.fail(
            f"the arrival check exited {rc}: it couldn't check, which counts as a failure"
        )
    return classify(step, rc, out)


def engine_problem(docker: str, engine: dict[str, str], tmp: Path) -> str | None:
    """Why the image step can't build on the agents' engine, or None when the engine answered one docker version
    within ENGINE_PROBE_SECONDS, as make image asks it (tasks.md T167). At the bound, subprocess.run kills the client
    and waits for it alone, not for its output, so nothing holding that pipe can hold the step. What docker printed,
    its own error included, goes above the step's line."""
    say(f"docker version, on the agents' engine, stopped at {ENGINE_PROBE_SECONDS} s")
    try:
        done = subprocess.run(
            [docker, "version"],
            env=engine,
            cwd=tmp,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=ENGINE_PROBE_SECONDS,
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        output, why = exc.stdout, f"within {ENGINE_PROBE_SECONDS} s"
    except OSError as exc:
        return f"can't run {docker}: {exc.strerror or exc}"
    else:
        output = done.stdout
        why = f"(it exited {done.returncode})" if done.returncode else None
    text = (output or b"").decode("utf-8", "replace").rstrip("\n")
    if text:
        say(text)
    if why is None:
        return None
    return (
        f"the agents' engine didn't answer docker version {why}, so nothing was built: "
        "deploy/agents-engine/engine.sh up"
    )


def image(export_dir: Path, policy_step: Step, tmp: Path, sha: str) -> Step:
    begin(
        "image",
        "the gateway's, the room's, and the compose images, built on the agents' engine",
    )
    step = Step("image")
    if policy_step.status not in ("PASS", "PLANNED"):
        return step.fail(
            "not built: the compose policy didn't pass, and a build it hasn't vetted could read host files "
            "(build secrets, ssh) into the engine"
        )
    docker = shutil.which("docker")
    if docker is None:
        return step.fail("docker isn't installed")
    certs = Path.home() / ".config" / "h4reet-ai" / "agents-engine" / "docker"
    if not (certs / "cert.pem").is_file():
        return step.fail(
            f"no client certificate for the agents' engine in {certs}: deploy/agents-engine/engine.sh setup"
        )
    engine = tool_env(
        DOCKER_HOST=AGENTS_ENGINE,
        DOCKER_TLS_VERIFY="1",
        DOCKER_CERT_PATH=str(certs),
    )
    # The engine answers first, within its bound, or the step fails rather than holds the gate.
    problem = engine_problem(docker, engine, tmp)
    if problem is not None:
        return step.fail(problem)
    # The gateway's image is make up's own build, outside compose (deploy/scripts/gateway_image.py; tasks.md T184),
    # built here as it builds it, from the export.
    rc, out = stream(
        [
            docker,
            "buildx",
            "build",
            "--load",
            "--file",
            str(export_dir / "services" / "gateway" / "Dockerfile"),
            "--tag",
            f"h4reet-gateway:{sha}",
            "--build-arg",
            f"HTTP_PROXY={AGENTS_PROXY}",
            "--build-arg",
            f"HTTPS_PROXY={AGENTS_PROXY}",
            str(export_dir),
        ],
        engine,
        tmp,
    )
    if rc != 0:
        return step.fail(
            "the agents' engine didn't build the gateway's image; if it's down: deploy/agents-engine/engine.sh up"
        )
    # The room's image (spec 002, contracts/web-serving.md §1), as make up builds prod's: h4reet-web:<SHA>, with no
    # drafts. The gate names no `policy` context, so the Dockerfile's own empty policy stage applies: every content
    # file builds as a draft, which a build without drafts leaves out. That proves the image builds; what main
    # approves is make up's to read. A commit from before spec 002 has no apps/web/Dockerfile and no web image.
    web_dockerfile = export_dir / "apps" / "web" / "Dockerfile"
    if web_dockerfile.is_file():
        rc, web = stream(
            [
                docker,
                "buildx",
                "build",
                "--load",
                "--file",
                str(web_dockerfile),
                "--tag",
                f"h4reet-web:{sha}",
                "--build-arg",
                f"HTTP_PROXY={AGENTS_PROXY}",
                "--build-arg",
                f"HTTPS_PROXY={AGENTS_PROXY}",
                "--build-arg",
                "ROOM_DRAFTS=",
                str(export_dir),
            ],
            engine,
            tmp,
        )
        if rc != 0:
            return step.fail(
                "the agents' engine didn't build the room's image; if it's down: deploy/agents-engine/engine.sh up"
            )
        out += web
    rc, more = stream(
        [
            docker,
            "compose",
            "-p",
            "h4reet-dev-cpu",
            "-f",
            str(export_dir / "deploy" / "compose.yaml"),
            "--env-file",
            str(export_dir / "deploy" / "env.agents" / "dev-cpu.vars"),
            "--profile",
            "*",
            "build",
        ],
        engine,
        tmp,
    )
    if rc != 0:
        return step.fail(
            "the agents' engine didn't build the images; if it's down: deploy/agents-engine/engine.sh up"
        )
    return classify(step, rc, out + more)


def changed_paths(
    repo: Path, base: str, sha: str, *options: str, under: str = ""
) -> list[str] | None:
    """The paths the branch changes, both sides of a rename, or None when git can't say."""
    done = git(
        repo,
        "diff",
        "--no-renames",
        "--name-only",
        "-z",
        *options,
        base,
        sha,
        *(["--", under] if under else []),
        binary=True,
    )
    if done.returncode:
        return None
    return [p.decode("utf-8", "surrogateescape") for p in done.stdout.split(b"\0") if p]


def stage_e(repo: Path, paths: list[str] | None, prove: bool, ref: str) -> Step:
    begin("matrix-e", "stage E, from the host")
    step = Step("matrix-e")
    if paths is None and not prove:
        return step.fail(
            "no merge base with main, so the branch's changes can't be read"
        )
    touched = sorted(
        p
        for p in paths or []
        if p == STAGE_E_PATHS[1] or p.startswith(STAGE_E_PATHS[0])
    )
    if not touched and not prove:
        return step.set(
            "SKIP",
            "the branch touches neither deploy/agents-engine/ nor .claude/settings.json",
        )
    if not prove:
        shown = ", ".join(touched[:3]) + (", ..." if len(touched) > 3 else "")
        return step.set(
            "PENDING",
            f"the branch changes {shown}: run tools/gates/gate --prove {ref} with no agent session using the "
            "engine (Heavy: deploy/agents-engine/engine.sh prove resets and reseeds it)",
        )
    engine = repo / "deploy" / "agents-engine" / "engine.sh"
    if not os.access(engine, os.X_OK):
        return step.fail(f"{engine} isn't there to run")
    # The Author's own human-only script, run as the Author would run it directly: it needs sudo.
    rc, out = stream([str(engine), "prove"], dict(os.environ), repo)
    return classify(step, rc, out)


def pin(text: str) -> str | None:
    found = re.search(r"^CLAUDE_CODE_VERSION=(.*)$", text, re.MULTILINE)
    return found.group(1).strip() if found else None


def agent_config_evals(
    repo: Path, export_dir: Path, base: str | None, paths: list[str] | None
) -> Step:
    begin("agent-config-evals", "the behavioral tier, when triggered (plan §14)")
    step = Step("agent-config-evals")
    if paths is None or base is None:
        return step.fail(
            "no merge base with main, so the branch's changes can't be read"
        )
    touched = sorted(
        p
        for p in paths
        if (
            p in ("CLAUDE.md", "REVIEW.md")
            or p.startswith((".claude/", "evals/agent-config/"))
        )
        and not p.startswith(HISTORY)
    )
    if ".devcontainer/toolchain.vars" in paths:
        before = git(repo, "cat-file", "blob", f"{base}:.devcontainer/toolchain.vars")
        vars_file = export_dir / ".devcontainer" / "toolchain.vars"
        after = vars_file.read_text(encoding="utf-8") if vars_file.is_file() else ""
        if pin(before.stdout if before.returncode == 0 else "") != pin(after):
            touched.append("the Claude Code pin")
    if not touched:
        return step.set(
            "SKIP",
            "the branch touches none of the triggers: CLAUDE.md, REVIEW.md, .claude/, evals/agent-config/, "
            "the Claude Code pin",
        )
    shown = ", ".join(touched[:3]) + (", ..." if len(touched) > 3 else "")
    tier = repo / "evals" / "agent-config" / "behavioral.py"
    if not tier.is_file():
        return step.set(
            "SKIP",
            f"triggered by {shown}, and added by T094 (quickstart §6.3 step 2: make evals-agent-config, then commit "
            "its history entry)",
        )
    # The main tree's own behavioral.py, in this process, as the corpus step loads check_corpus: its status reads the
    # export's cases, thresholds, history, and trigger files as data, and starts nothing (plan §14). In export mode
    # it walks the tree and never runs git, so a .git folder or file the branch carries is data too (review A, 1b).
    spec = importlib.util.spec_from_file_location("h4gate_behavioral", tier)
    if spec is None or spec.loader is None:
        return step.fail(f"can't load {tier}")
    out = io.StringIO()
    try:
        module = importlib.util.module_from_spec(spec)
        sys.modules[spec.name] = module  # its dataclasses look their module up there
        spec.loader.exec_module(module)
        with contextlib.redirect_stdout(out):
            rc = module.status(
                export_dir, export_dir / "evals" / "agent-config", export=True
            )
    except Exception as exc:  # noqa: BLE001 (the export's files are data: a bad one fails the step, not the gate)
        return step.fail(f"behavioral.py stopped: {type(exc).__name__}: {exc}")
    text = out.getvalue()
    for line in text.splitlines():
        say(line)
    lines = text.splitlines()
    if rc != 0:
        failed = [ln for ln in lines if ln.startswith("FAIL")]
        return step.fail(failed[0] if failed else f"behavioral.py's status exited {rc}")
    if not any(
        ln.startswith(("PASS  behavioral tier", "PENDING (behavioral tier)"))
        for ln in lines
    ):
        return step.fail("behavioral.py's status said neither PASS nor PENDING")
    step.notes.append(f"triggered by {shown}")
    return classify(step, rc, text)


