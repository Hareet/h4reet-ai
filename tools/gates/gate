def check_url(url: str) -> str:
    parts = urllib.parse.urlsplit(url)
    if (
        parts.scheme != "http"
        or parts.hostname not in ("127.0.0.1", "localhost", "::1")
        or parts.path != "/v1/metrics"
        or parts.query
        or parts.username
    ):
        raise argparse.ArgumentTypeError(
            f"{url!r}: the push goes to a loopback http://.../v1/metrics only, prod's x004 (telemetry.md §4.4)"
        )
    return url


def history_problems(entry: object) -> list[str]:
    if not isinstance(entry, dict):
        return ["not a JSON object"]
    problems = []
    if entry.get("verdict") not in ("pass", "fail"):
        problems.append('"verdict" isn\'t "pass" or "fail"')
    cost = entry.get("cost_usd")
    if (
        isinstance(cost, bool)
        or not isinstance(cost, (int, float))
        or not math.isfinite(cost)
        or cost < 0
    ):
        problems.append('"cost_usd" isn\'t a non-negative number')
    tokens = entry.get("tokens")
    if not isinstance(tokens, dict):
        problems.append('"tokens" isn\'t an object')
    else:
        for kind in TOKEN_TYPES:
            value = tokens.get(kind)
            if isinstance(value, bool) or not isinstance(value, int) or value < 0:
                problems.append(f'"tokens.{kind}" isn\'t a non-negative integer')
    return problems


def otlp_body(run: str, entry: dict, now_ns: int) -> bytes:
    def attr(key: str, value: str) -> dict:
        return {"key": key, "value": {"stringValue": value}}

    run_attr = attr("h4.eval.run", run)
    cost = {
        "name": "h4.devtime.eval.cost_usd",
        "unit": "{USD}",
        "gauge": {
            "dataPoints": [
                {
                    "timeUnixNano": str(now_ns),
                    "asDouble": float(entry["cost_usd"]),
                    "attributes": [run_attr, attr("h4.eval.verdict", entry["verdict"])],
                }
            ]
        },
    }
    tokens = {
        "name": "h4.devtime.eval.tokens",
        "unit": "{token}",
        "gauge": {
            "dataPoints": [
                {
                    "timeUnixNano": str(now_ns),
                    "asInt": str(entry["tokens"][kind]),
                    "attributes": [run_attr, attr("gen_ai.token.type", kind)],
                }
                for kind in TOKEN_TYPES
            ]
        },
    }
    resource = {
        "attributes": [
            attr("service.name", "h4-gate"),
            attr("service.namespace", "h4reet"),
        ]
    }
    body = {
        "resourceMetrics": [
            {
                "resource": resource,
                "scopeMetrics": [
                    {"scope": {"name": "tools/gates/gate"}, "metrics": [cost, tokens]}
                ],
            }
        ]
    }
    return json.dumps(body).encode("utf-8")


def post(url: str, body: bytes) -> str | None:
    """None when the collector took it, or why not. No proxy: the push goes to this machine's loopback only."""
    request = urllib.request.Request(
        url, data=body, method="POST", headers={"Content-Type": "application/json"}
    )
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(request, timeout=5) as answer:
            return None if 200 <= answer.status < 300 else f"HTTP {answer.status}"
    except urllib.error.HTTPError as exc:
        return f"HTTP {exc.code}"
    except (urllib.error.URLError, OSError) as exc:
        return str(getattr(exc, "reason", exc))


def eval_history(
    repo: Path, export_dir: Path, base: str | None, sha: str, url: str
) -> Step | None:
    """Post each history entry the branch adds, on every gate run, as the h4.devtime.eval.* gauges, when this machine attests its
    exact bytes: make evals-agent-config writes the SHA-256 of each entry it writes under ~/.local/state/h4reet, which
    agent sessions can't write (review A, 4). An unattested entry isn't posted, and the merge waits (PENDING). The
    history is append-only: the newest attested run decides, so a branch that changes or removes an entry fails."""
    if base is None:
        return None
    added = changed_paths(repo, base, sha, "--diff-filter=A", under=HISTORY)
    entries = [p for p in added or [] if p.endswith(".json")]
    altered = [
        p
        for p in changed_paths(repo, base, sha, under=HISTORY) or []
        if p.endswith(".json") and p not in entries
    ]
    if not entries and not altered:
        return None
    begin(
        "eval-history",
        f"{len(entries)} entr{'y' if len(entries) == 1 else 'ies'} to prod's x004",
    )
    step = Step("eval-history")
    store = Path.home() / ".local" / "state" / "h4reet" / "evals" / "attested"
    problems, skipped, unsent = [], [], []
    for rel in entries:
        run = Path(rel).stem
        path = export_dir / rel
        try:
            if path.is_symlink() or not path.is_file():
                raise ValueError("a link, or not a file")
            data = path.read_bytes()
            entry = json.loads(data.decode("utf-8"))
        except (OSError, ValueError) as exc:
            problems.append(f"{rel}: {exc}")
            continue
        found = history_problems(entry)
        if not RUN_NAME_RE.fullmatch(run):
            found.append("its name isn't <UTC>-<branch>-<sha>")
        elif isinstance(entry, dict) and entry.get("run") != run:
            found.append("its \"run\" isn't its file's name")
        if found:
            problems.append(f"{rel}: {'; '.join(found)}")
            continue
        try:
            stamp = (store / hashlib.sha256(data).hexdigest()).lstat()
            attested = stat.S_ISREG(stamp.st_mode)
        except OSError:
            attested = False
        if not attested:
            skipped.append(run)
            continue
        why = post(url, otlp_body(run, entry, time.time_ns()))
        if why:
            unsent.append(f"{run}: {why}")
        else:
            say(f"posted {run}")
    waits = (
        f"not attested on this machine, so not posted: {', '.join(skipped)} (make evals-agent-config attests each "
        f"entry it writes, in {store}/; an entry no run here wrote decides nothing)"
    )
    failures = []
    if altered:
        failures.append(
            f"history is append-only, and the branch changes or removes {', '.join(altered)}"
        )
    if problems:
        failures.append("malformed, not posted: " + " | ".join(problems))
    if failures:
        return step.fail("; ".join([*failures, *([waits] if skipped else [])]))
    if skipped:
        return step.set("PENDING", waits)
    if unsent:
        return step.set(
            "WARN",
            f"prod's collector at {url} didn't take {len(unsent)}: {' | '.join(unsent)}; the dashboard misses "
            "them, and Prometheus takes no back-fill",
        )
    return step.set("PASS", f"posted {len(entries)}")


