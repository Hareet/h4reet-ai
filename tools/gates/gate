def git(repo: Path, *args: str, binary: bool = False) -> subprocess.CompletedProcess:
    # Replace refs live under .git/refs/replace, which git status doesn't show; with this, git reads each
    # commit's own objects.
    return subprocess.run(
        ["git", "-C", str(repo), *args],
        env=tool_env(GIT_NO_REPLACE_OBJECTS="1"),
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=not binary,
        check=False,
        timeout=600,
    )


def main_tree() -> Path:
    """The main working tree, which must be where this file lives: a linked worktree's copy is a branch's."""
    gate = Path(__file__).resolve()
    top = git(gate.parent, "rev-parse", "--show-toplevel")
    common = git(gate.parent, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if top.returncode or common.returncode:
        raise Refusal(f"{gate} isn't inside a git work tree")
    common_dir = Path(common.stdout.strip()).resolve()
    main = common_dir.parent
    if (
        common_dir.name != ".git"
        or Path(top.stdout.strip()).resolve() != main
        or gate != main / "tools" / "gates" / "gate"
    ):
        raise Refusal(
            f"run the main working tree's gate, {main}/tools/gates/gate: {gate} is a linked worktree's copy, "
            "which a branch can change"
        )
    return main


def some(items: list[str]) -> str:
    return ", ".join(items[:3]) + (
        f", and {len(items) - 3} more" if len(items) > 3 else ""
    )


def bytecode_cache(path: str) -> bool:
    """Whether a path is Python's bytecode cache, __pycache__/<module>.<tag>.pyc: PY_HOST's pycache_prefix=/dev/null
    keeps Python from reading one (the matrix's H/pyhost rows), and Python never imports one without its source."""
    folder, _, name = path.rpartition("/")
    return folder.rpartition("/")[2] == "__pycache__" and name.endswith(".pyc")


def checkout_problem(repo: Path) -> str | None:
    """Why main's checkout isn't one whose code the gate may run, or None (US3 review D, finding 1). The gate runs and
    loads the working tree's files, so they must be main's: HEAD is refs/heads/main itself; the tracked files match it,
    in the index and the working tree; git is told to hide no change; and no file git doesn't track, ignored or not,
    sits where the gate's code is (CODE_PATHS), but Python's bytecode caches. Untracked files elsewhere don't matter:
    the gate reads nothing else of the working tree but tracked .gitleaks.toml and what its steps check by name."""
    head = git(repo, "symbolic-ref", "--quiet", "HEAD")
    ref = head.stdout.strip()
    if head.returncode or ref != "refs/heads/main":
        return (
            f"run the gate from main's checkout: HEAD is {ref or 'detached'} here, not refs/heads/main, so the code "
            "it would run and load from this working tree is that commit's, and a branch would grade itself: switch "
            "to main, then run tools/gates/gate <branch>"
        )
    listed = git(repo, "ls-files", "-v", "-z", binary=True)
    if listed.returncode:
        return "git ls-files couldn't list main's checkout"
    # -v tags a file marked assume-unchanged in lower case, and one marked skip-worktree S.
    hidden = [
        entry[2:].decode("utf-8", "surrogateescape")
        for entry in listed.stdout.split(b"\0")
        if entry[:1].islower() or entry[:1] == b"S"
    ]
    if hidden:
        return (
            f"git is told to hide changes to {some(hidden)} (assume-unchanged or skip-worktree), so main's checkout "
            "can't be shown to match main: git update-index --no-assume-unchanged --no-skip-worktree -- <path>"
        )
    # No optional locks: the Author's index isn't rewritten. No fsmonitor: nothing but git's own reading says what
    # changed.
    status = git(
        repo, "--no-optional-locks", "-c", "core.fsmonitor=false", "status", "--porcelain=v1", "-z", "--no-renames",
        "--untracked-files=no", "--ignore-submodules=none", binary=True,
    )  # fmt: skip
    if status.returncode:
        return "git status couldn't read main's checkout"
    changed = [
        e.decode("utf-8", "surrogateescape") for e in status.stdout.split(b"\0") if e
    ]
    if changed:
        return (
            f"main's checkout has tracked files that don't match HEAD, so the code the gate would run might not be "
            f"main's: {some(changed)}; stash or restore them"
        )
    # --others without --exclude-standard: ignored files too.
    others = git(repo, "ls-files", "-z", "--others", "--", *CODE_PATHS, binary=True)
    if others.returncode:
        return "git ls-files couldn't list main's checkout"
    planted = [
        path
        for path in (
            e.decode("utf-8", "surrogateescape")
            for e in others.stdout.split(b"\0")
            if e
        )
        if not path.startswith(HISTORY) and not bytecode_cache(path)
    ]
    if planted:
        return (
            f"main's checkout has files git doesn't track where the gate's code is ({', '.join(CODE_PATHS)}; "
            f"{HISTORY} aside), which a glob, a copy, or an import from their folder would pick up: {some(planted)}; "
            "move them out of the tree"
        )
    return None


def object_id(kind: bytes, data: bytes) -> str:
    """The ID git gives an object of this kind and content (SHA-1 object format)."""
    return hashlib.sha1(b"%s %d\0" % (kind, len(data)) + data).hexdigest()


def tree_id(directory: Path) -> str | None:
    """The tree ID git would give a directory's contents, or None for an empty one, which a tree can't hold."""
    entries = []
    with os.scandir(directory) as found:
        for entry in found:
            name = os.fsencode(entry.name)
            if entry.is_symlink():
                target = os.fsencode(os.readlink(entry.path))
                entries.append((name, b"120000", object_id(b"blob", target)))
            elif entry.is_dir(follow_symlinks=False):
                sub = tree_id(Path(entry.path))
                if sub is not None:
                    entries.append(
                        (name + b"/", b"40000", sub)
                    )  # git orders a tree as if it ended in /
            elif entry.is_file(follow_symlinks=False):
                executable = entry.stat(follow_symlinks=False).st_mode & 0o100
                data = Path(entry.path).read_bytes()
                mode = b"100755" if executable else b"100644"
                entries.append((name, mode, object_id(b"blob", data)))
            else:
                raise Stop(f"{entry.path} is not a file, a link, or a directory")
    if not entries:
        return None
    entries.sort()
    body = b"".join(
        mode + b" " + key.removesuffix(b"/") + b"\0" + bytes.fromhex(oid)
        for key, mode, oid in entries
    )
    return object_id(b"tree", body)


def names_git(name: bytes) -> bool:
    """Whether a path component is a name git takes for its own directory, as its verify_path reads one with
    core.protectNTFS on, git's default everywhere: .git, or NTFS's short name git~1, in any case, followed by nothing
    but dots and spaces (which NTFS drops) or by a colon (an NTFS stream); a backslash separates on NTFS."""
    for part in name.split(b"\\"):
        if part.split(b":", 1)[0].rstrip(b". ").lower() in (b".git", b"git~1"):
            return True
    return False


def resolve(repo: Path, ref: str) -> str:
    done = git(repo, "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}")
    sha = done.stdout.strip()
    if done.returncode or not SHA_RE.fullmatch(sha):
        raise Stop(f"{ref} isn't a commit in {repo}")
    return sha


def commit_tree(repo: Path, sha: str) -> str:
    """The tree a commit names, read from the commit object, after rehashing the object against its SHA: git
    cat-file doesn't, and so the export's tree check proves the export whatever .git holds."""
    done = git(repo, "cat-file", "commit", sha, binary=True)
    if done.returncode or object_id(b"commit", done.stdout) != sha:
        raise Stop(f"the object store's copy of {sha} isn't that commit; run git fsck")
    tree = re.fullmatch(rb"tree ([0-9a-f]{40})", done.stdout.split(b"\n", 1)[0])
    if not tree:
        raise Stop(f"commit {sha} names no tree")
    return tree.group(1).decode()


def extract(data: bytes, dest: Path) -> None:
    dest.mkdir(mode=0o700)
    with tarfile.open(fileobj=io.BytesIO(data), mode="r:") as tar:
        tar.extractall(
            dest, filter="data"
        )  # no absolute paths, no "..", no devices, no links out


def make_read_only(top: Path) -> None:
    for dirpath, _, filenames in os.walk(top):
        for name in filenames:
            path = Path(dirpath, name)
            if not path.is_symlink():
                mode = stat.S_IMODE(path.lstat().st_mode)
                path.chmod(0o555 if mode & 0o111 else 0o444)
        Path(dirpath).chmod(0o555)


def remove(top: Path) -> None:
    """Delete a tree the gate made, whatever modes a container left in it; links are removed, never followed."""
    if not top.exists():
        return
    for dirpath, dirnames, _ in os.walk(top):
        for name in dirnames:
            path = Path(dirpath, name)
            if not path.is_symlink():
                path.chmod(0o700)
        Path(dirpath).chmod(0o700)
    shutil.rmtree(top, ignore_errors=True)


def export(repo: Path, ref: str, tmp: Path) -> tuple[str, Path, bytes]:
    """Resolve REF once, export that commit, and prove the export is the commit's own tree (plan §11)."""
    replaced = git(repo, "for-each-ref", "--format=%(refname)", "refs/replace/")
    if replaced.returncode:
        raise Stop("git for-each-ref couldn't list refs/replace")
    if replaced.stdout.strip():
        raise Stop(
            f"refs/replace holds {len(replaced.stdout.split())} ref(s). The merge and every checkout honor a "
            "replace ref, so the gate would vouch for a commit other than the one the merge writes: remove them "
            "(git replace -l, git replace -d) and run the gate again"
        )
    sha = resolve(repo, ref)
    expected = commit_tree(repo, sha)
    attributes = git(
        repo, "rev-parse", "--path-format=absolute", "--git-path", "info/attributes"
    )
    if attributes.returncode or Path(attributes.stdout.strip()).exists():
        raise Stop(
            f"{attributes.stdout.strip() or 'info/attributes'} exists, and git archive would apply its "
            "export-ignore and export-subst rules; move it aside first"
        )
    # -t lists each folder as well as what it holds, so an empty one is in the listing too.
    listing = git(repo, "ls-tree", "-r", "-t", "-z", sha, binary=True)
    if listing.returncode:
        raise Stop(f"git ls-tree {sha} failed")
    records = [line for line in listing.stdout.split(b"\0") if line]
    if any(line.startswith(b"160000 ") for line in records):
        raise Stop(
            f"commit {sha} holds a submodule, which git archive exports as an empty directory"
        )
    # A file, a folder, or a link the export would hold as .git: git reads a tree that holds .git as a repository,
    # its config and index included, and the behavioral step's status runs git in the export when it holds one.
    # git archive refuses these names too, but only as git's version and core.protectNTFS have it.
    dotgit = sorted(
        {
            path
            for path in (line.partition(b"\t")[2] for line in records)
            if any(names_git(part) for part in path.split(b"/"))
        }
    )
    if dotgit:
        shown = ", ".join(p.decode("utf-8", "replace") for p in dotgit[:3])
        raise Stop(
            f"commit {sha} holds {shown}{', ...' if len(dotgit) > 3 else ''}: a path git takes for its own "
            "directory (.git in any case, or as NTFS spells it), which git would read as a repository if anything "
            "ran it in the export"
        )
    archive = git(repo, "archive", "--format=tar", sha, binary=True)
    if archive.returncode:
        raise Stop(
            f"git archive {sha} failed: {archive.stderr.decode(errors='replace').strip()[-300:]}"
        )
    target = tmp / "export"
    try:
        extract(archive.stdout, target)
    except (tarfile.TarError, OSError) as exc:
        raise Stop(f"the export of {sha} couldn't be extracted safely: {exc}") from exc
    # The checks above name what is known to steer git archive. This one doesn't depend on that list.
    if tree_id(target) != expected:
        raise Stop(
            f"the export of {sha} doesn't match the commit's own tree, so something changed what git archive "
            "wrote: a .gitattributes export rule in the commit, or something in .git (git fsck)"
        )
    make_read_only(target)
    return sha, target, archive.stdout


def makefiles(repo: Path, export_dir: Path) -> Step:
    """The container phase's make reads a GNUmakefile or makefile first, so only main's GNUmakefile may be there."""
    step = Step("makefiles")
    if os.path.lexists(export_dir / "makefile"):
        return step.fail(
            "the commit has a makefile, which make would read instead of the Makefile"
        )
    gnu = export_dir / "GNUmakefile"
    if not os.path.lexists(gnu):
        return step.set("PASS", "no GNUmakefile and no makefile")
    mains = git(repo, "cat-file", "blob", "main:GNUmakefile", binary=True)
    if mains.returncode:
        return step.fail("the commit has a GNUmakefile, and main has none")
    if gnu.is_symlink() or not gnu.is_file() or gnu.read_bytes() != mains.stdout:
        return step.fail("the commit's GNUmakefile isn't main's")
    return step.set("PASS", "main's GNUmakefile and no makefile")


