# The modes
# --------------------------------------------------------------------------------------------------
def summary_line(
    report: Report, sha: str, ref: str, gate_sha: str, degraded: bool
) -> str:
    counts = ", ".join(
        f"{sum(s.status == status for s in report.steps)} {status}"
        for status in COUNTED
    )
    line = f"gate: {sha} ({ref}) by tools/gates/gate at {gate_sha[:12]}: {counts}"
    failing = report.failing()
    if failing:
        line += "; failing: " + ", ".join(f"{s.name} {s.status}" for s in failing)
    if degraded:
        line += "; DEGRADED (--host): no container phase, so lint, tests, the scaffolds, and stage H didn't run"
    return line


def finish(report: Report, repo: Path, sha: str, ref: str, degraded: bool) -> int:
    say()
    for step in report.steps:
        note = f"  {'; '.join(step.notes)}" if step.notes else ""
        say(f"{step.status:<8} {step.name}{note}")
    gate_sha = git(repo, "rev-parse", "HEAD").stdout.strip() or "unknown"
    line = summary_line(report, sha, ref, gate_sha, degraded)
    say(line)
    if report.failing():
        say("Not ready to merge: the summary names what failed or waits.")
        return 1
    merge = (
        f"git switch main && git --no-replace-objects merge --no-ff -m {shlex.quote(f'Merge {ref} ({sha[:12]})')} "
        f"-m {shlex.quote(line)} {sha}"
    )
    say(f"merge: {merge}")
    if git(repo, "merge-base", "--is-ancestor", "main", sha).returncode != 0:
        say(
            f"note: main has commits {ref} doesn't, so the merge writes a tree this run didn't check; to merge "
            "exactly what it checked, merge main into the branch and run the gate again"
        )
    return 0


def private_tmp() -> Path:
    tmp = Path(tempfile.mkdtemp(prefix="h4gate-"))
    tmp.chmod(0o700)
    return tmp


def run_gate(repo: Path, ref: str, host_only: bool, prove: bool, url: str) -> int:
    report = Report()
    tmp = private_tmp()
    try:
        say(
            f"tools/gates/gate {ref}, from {repo}{' (DEGRADED: --host)' if host_only else ''}"
        )
        begin("export", f"git archive {ref}")
        try:
            sha, export_dir, data = export(repo, ref, tmp)
        except Stop as exc:
            report.add(Step("export").fail(str(exc)))
            say(
                f"tools/gates/gate {ref}: the export's proof failed, so nothing else ran"
            )
            return 1
        report.add(Step("export").set("PASS", f"{sha}, the commit's own tree"))
        report.add(makefiles(repo, export_dir))
        if not host_only:
            container_phase(report, data, export_dir, tmp)
        found = git(repo, "merge-base", "main", sha)
        base = (
            found.stdout.strip()
            if found.returncode == 0 and SHA_RE.fullmatch(found.stdout.strip())
            else None
        )
        paths = changed_paths(repo, base, sha) if base else None
        report.add(githooks(repo))
        report.add(toolchain(repo, export_dir, tmp))
        policy_step = report.add(policy(repo, export_dir, tmp))
        report.add(corpus(repo, export_dir))
        report.add(gitleaks(repo, sha, base, tmp))
        report.add(image(export_dir, policy_step, tmp))
        report.add(stage_e(repo, paths, prove, ref))
        report.add(agent_config_evals(repo, export_dir, base, paths))
        pushed = eval_history(repo, export_dir, base, sha, url)
        if pushed is not None:
            report.add(pushed)
        return finish(report, repo, sha, ref, host_only)
    finally:
        remove(tmp)


def read_recording(file: Path) -> str:
    """The recording's adapter name, after refusing anything that isn't a recording file."""
    if file.is_symlink() or not file.is_file():
        raise Refusal(f"{file} isn't a regular file (a link isn't followed)")
    if "," in str(file.resolve()):
        raise Refusal(f"{file}'s path holds a comma, which a --mount can't take")
    try:
        recording = json.loads(file.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise Refusal(f"{file} isn't readable JSON: {exc}") from exc
    if (
        not isinstance(recording, dict)
        or not isinstance(recording.get("adapter"), str)
        or not isinstance(recording.get("cases"), list)
    ):
        raise Refusal(
            f"{file} isn't a recording: no adapter and cases (provider-adapter.md §5.1, LiveRecording)"
        )
    return recording["adapter"][:40]


def run_replay(repo: Path, file: Path) -> int:
    adapter = read_recording(file)
    file = file.resolve()
    report = Report()
    tmp = private_tmp()
    try:
        say(f"gate --contract-replay: the {adapter} recording, on HEAD's export")
        begin("export", "git archive HEAD")
        try:
            sha, export_dir, data = export(repo, "HEAD", tmp)
        except Stop as exc:
            report.add(Step("export").fail(str(exc)))
            say(
                "gate --contract-replay: the export's proof failed, so nothing replayed"
            )
            return 1
        report.add(Step("export").set("PASS", f"{sha}, the commit's own tree"))
        ready = prepare(report, data, export_dir, tmp, ["replay"])
        if ready is not None:
            docker, image_id, work = ready
            begin("replay", "vitest run test/contract/replay.test.ts, --network none")
            rc, out = stream(
                container(
                    docker,
                    image_id,
                    work,
                    [
                        "/work/node_modules/.bin/vitest",
                        "run",
                        "test/contract/replay.test.ts",
                        "--reporter=verbose",
                    ],
                    network=False,
                    workdir="/work/services/gateway",
                    extra=(
                        "--mount",
                        f"type=bind,source={file},target={RECORDING},readonly",
                        "--env",
                        f"H4_CONTRACT_RECORDING={RECORDING}",
                    ),
                ),
                host_engine_env(),
                tmp,
            )
            step = classify(Step("replay"), rc, out)
            replayed = [
                ln
                for ln in out.splitlines()
                if ln.lstrip().startswith("✓") and "recorded live: " in ln
            ]
            if step.status == "PASS" and not replayed:
                step.fail(
                    "no test passed under recorded live: <adapter>, so the replay never read the recording"
                )
            report.add(step)
        verdict = "FAIL" if report.failing() else "PASS"
        say(
            f"gate --contract-replay: the {adapter} recording, replayed at HEAD {sha[:12]}: {verdict}"
        )
        return 1 if report.failing() else 0
    finally:
        remove(tmp)


def parse(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="tools/gates/gate",
        description="The Author's clean-room gate (plan §11). Run it directly, from the main working tree.",
    )
    parser.add_argument("ref", nargs="?", help="the branch or commit to check")
    parser.add_argument(
        "--host",
        action="store_true",
        help="DEGRADED: the host phase alone, for when the devcontainer image won't build (plan §19)",
    )
    parser.add_argument(
        "--prove",
        action="store_true",
        help="run matrix stage E (deploy/agents-engine/engine.sh prove; Heavy, no agent session on the engine)",
    )
    parser.add_argument(
        "--otlp-url",
        type=check_url,
        default=OTLP_URL,
        help=f"where the eval history goes (default {OTLP_URL}, prod's x004)",
    )
    parser.add_argument(
        "--contract-replay",
        metavar="FILE",
        type=Path,
        help="make contract-live's replay of a recording, on HEAD's export (provider-adapter.md §5.3)",
    )
    args = parser.parse_args(argv)
    if args.contract_replay is not None:
        if args.ref is not None or args.host or args.prove:
            parser.error("--contract-replay takes a recording and nothing else")
    elif args.ref is None:
        parser.error("name the branch or commit to check")
    elif not REF_RE.fullmatch(args.ref) or ".." in args.ref:
        parser.error(f"{args.ref!r} isn't a branch, a tag, or a commit")
    return args


def main(argv: list[str]) -> int:
    args = parse(argv)
    try:
        if os.environ.get("SANDBOX_RUNTIME") == "1":
            raise Refusal(
                "tools/gates/gate is the Author's: run it in your own terminal, not an agent session"
            )
        repo = main_tree()
        if args.contract_replay is not None:
            return run_replay(repo, args.contract_replay)
        return run_gate(repo, args.ref, args.host, args.prove, args.otlp_url)
    except Refusal as exc:
        say(f"gate: {exc}", err=True)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
