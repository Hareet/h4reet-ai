# The container phase
# --------------------------------------------------------------------------------------------------
def host_engine_env() -> dict[str, str]:
    return tool_env(DOCKER_HOST=HOST_ENGINE)


def build_devcontainer(
    report: Report, docker: str, export_dir: Path, tmp: Path
) -> str | None:
    step = Step("devcontainer")
    if not (export_dir / ".devcontainer" / "Dockerfile").is_file():
        report.add(step.fail("the commit has no .devcontainer/Dockerfile"))
        return None
    tag = f"{DEVCONTAINER}:{tree_id(export_dir / '.devcontainer')}"
    iid = tmp / "devcontainer.iid"
    begin("devcontainer", f"{tag}, from the export, on this machine's engine")
    rc, _ = stream(
        [
            docker,
            "build",
            "--file",
            str(export_dir / ".devcontainer" / "Dockerfile"),
            "--tag",
            tag,
            "--iidfile",
            str(iid),
            str(export_dir),
        ],
        host_engine_env(),
        tmp,
    )
    image = iid.read_text(encoding="utf-8").strip() if iid.is_file() else ""
    if rc != 0 or not IMAGE_ID_RE.fullmatch(image):
        report.add(step.fail("the image didn't build"))
        return None
    report.add(step.set("PASS", image[:19]))
    return image


def container(
    docker: str,
    image: str,
    work: Path,
    command: list[str],
    *,
    network: bool,
    workdir: str = "/work",
    extra: tuple[str, ...] = (),
) -> list[str]:
    argv = [
        docker,
        "run",
        "--rm",
        "--init",
        "--cap-drop",
        "ALL",
        "--security-opt",
        "no-new-privileges",
        "--user",
        f"{os.getuid()}:{os.getgid()}",
        "--mount",
        f"type=bind,source={work},target=/work",
        "--workdir",
        workdir,
        "--env",
        "HOME=/tmp",
        "--env",
        "npm_config_cache=/tmp/npm-cache",
    ]
    if not network:
        argv += ["--network", "none"]
    return [*argv, *extra, image, *command]


def prepare(
    report: Report, data: bytes, export_dir: Path, tmp: Path, names: list[str]
) -> tuple[str, str, Path] | None:
    """The devcontainer image and an installed copy of the export, or None after reporting why each step that
    didn't run, from the image on through names, didn't."""

    def rest(reason: str, *steps: str) -> None:
        for name in [*steps, *names]:
            report.add(Step(name).fail(f"not run: {reason}"))

    docker = shutil.which("docker")
    if docker is None:
        rest("docker isn't installed", "devcontainer", "npm-ci")
        return None
    image = build_devcontainer(report, docker, export_dir, tmp)
    if image is None:
        rest(
            "no devcontainer image; while it won't build, tools/gates/gate --host runs the host phase alone, "
            "marked DEGRADED (plan §19)",
            "npm-ci",
        )
        return None
    work = tmp / "work"
    if "," in str(work):
        rest(
            f"the temporary path {work} holds a comma, which a --mount can't take",
            "npm-ci",
        )
        return None
    try:
        extract(data, work)
    except (tarfile.TarError, OSError) as exc:
        rest(f"the export's working copy couldn't be made: {exc}", "npm-ci")
        return None
    begin("npm-ci", "npm ci --ignore-scripts, the one step with the network")
    rc, _ = stream(
        container(
            docker,
            image,
            work,
            ["npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"],
            network=True,
        ),
        host_engine_env(),
        tmp,
    )
    if report.add(classify(Step("npm-ci"), rc, "")).status != "PASS":
        rest("npm ci failed")
        return None
    return docker, image, work


def content(
    report: Report,
    repo: Path,
    docker: str,
    image: str,
    work: Path,
    export_dir: Path,
    tmp: Path,
) -> None:
    """The room's published content (spec 002, T080; contracts/resume-source.md §5), when the export has the room.

    The build runs in the container, as a release builds it: no drafts, no pre- or post-scripts (a checkout's prebuild
    reads main with git, and there is none here), and main's policy, read here from the main tree by the branch's full
    ref, refs/heads/main, never a bare "main", which a tag of that name would answer, in a fresh directory mounted
    read-only. Then main's content_check.py, on the host, recomputes each content file's digest from the export, the
    commit's own read-only tree, and fails when the build says it published a file main doesn't approve, or when any
    such file's text is anywhere in the build's dist/. The build's approvals code is the branch's; the check is main's.
    """
    if not (export_dir / "apps" / "web" / "package.json").is_file():
        return  # a commit from before spec 002: no room, nothing published
    try:
        policy_dir = fresh_dir(tmp)
        for path, name in POLICY_FILES:
            shown = git(
                repo, "cat-file", "blob", f"refs/heads/main:{path}", binary=True
            )
            if shown.returncode == 0:
                (policy_dir / name).write_bytes(shown.stdout)
    except OSError as exc:
        report.add(
            Step("content-build").fail(f"main's policy couldn't be written: {exc}")
        )
        report.add(Step("content").fail("not run: no policy directory"))
        return
    begin(
        "content-build",
        "npm run build -w apps/web without drafts, main's policy at /policy, --network none",
    )
    rc, out = stream(
        container(
            docker,
            image,
            work,
            WEB_BUILD,
            network=False,
            extra=(
                "--mount",
                f"type=bind,source={policy_dir},target=/policy,readonly",
                "--env",
                "ROOM_DRAFTS=",
                "--env",
                "ROOM_POLICY_DIR=/policy",
            ),
        ),
        host_engine_env(),
        tmp,
    )
    build = report.add(classify(Step("content-build"), rc, out))
    begin(
        "content",
        "main's content check over the export and that build's dist/",
    )
    if build.status != "PASS":
        report.add(
            Step("content").fail("not run: the build without drafts didn't pass")
        )
        return
    rc, out = stream(
        py_host(
            repo / "tools" / "gates" / "content_check.py",
            "--tree",
            str(export_dir),
            "--dist",
            str(work / "apps" / "web" / "dist"),
            "--policy-dir",
            str(policy_dir),
        ),
        tool_env(),
        tmp,
    )
    report.add(classify(Step("content"), rc, out))


def container_phase(
    report: Report, repo: Path, data: bytes, export_dir: Path, tmp: Path
) -> None:
    names = [name for name, _ in CONTAINER_TARGETS]
    if report.status("makefiles") != "PASS":
        for name in ["devcontainer", "npm-ci", *names]:
            report.add(
                Step(name).fail(
                    "not run: the export's makefiles aren't what main allows"
                )
            )
        return
    ready = prepare(report, data, export_dir, tmp, names)
    if ready is None:
        return
    docker, image, work = ready
    for name, target in CONTAINER_TARGETS:
        if target == "credits-check" and not (
            (export_dir / "scripts" / "assets" / "credits.py").is_file()
            or (export_dir / "assets").is_dir()
        ):
            report.add(
                Step(name).set(
                    "SKIP",
                    "the branch has neither scripts/assets/credits.py nor assets/ (spec 003)",
                )
            )
            continue
        begin(name, f"make {target}, --network none")
        rc, out = stream(
            container(
                docker,
                image,
                work,
                ["make", "-f", "Makefile", "--no-print-directory", target],
                network=False,
            ),
            host_engine_env(),
            tmp,
        )
        report.add(classify(Step(name), rc, out))
    content(report, repo, docker, image, work, export_dir, tmp)


