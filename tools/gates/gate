class Refusal(Exception):
    """The gate won't start: a usage error, the sandbox, the wrong copy, or a file that isn't a recording. Exit 2."""


class Stop(Exception):
    """The export's proof failed, so nothing after it may run. Exit 1."""


@dataclass
class Step:
    name: str
    status: str = "PASS"
    notes: list[str] = field(default_factory=list)

    def set(self, status: str, note: str) -> Step:
        self.status = status
        self.notes.append(note)
        return self

    def fail(self, note: str) -> Step:
        return self.set("FAIL", note)


@dataclass
class Report:
    steps: list[Step] = field(default_factory=list)

    def add(self, step: Step) -> Step:
        self.steps.append(step)
        note = f" ({'; '.join(step.notes)})" if step.notes else ""
        say(f"-> {step.status} {step.name}{note}")
        return step

    def status(self, name: str) -> str:
        return next((s.status for s in self.steps if s.name == name), "")

    def failing(self) -> list[Step]:
        return [s for s in self.steps if s.status in ("FAIL", "PENDING")]


# --------------------------------------------------------------------------------------------------
# Output and processes
# --------------------------------------------------------------------------------------------------
def clean(text: str) -> str:
    """Every control character but a newline and a tab as ?, as the breach test and operator.py have it, so nothing a
    container, a tool, or a file prints can drive the Author's terminal."""
    return "".join(
        ch if ch in "\n\t" or unicodedata.category(ch) != "Cc" else "?" for ch in text
    )


def say(text: str = "", *, err: bool = False) -> None:
    with contextlib.suppress(OSError, ValueError):
        print(clean(text), file=sys.stderr if err else sys.stdout, flush=True)


def begin(name: str, what: str = "") -> None:
    say(f"== {name}{': ' + what if what else ''}")


def tool_env(**extra: str) -> dict[str, str]:
    """The only environment a tool gets: PATH, HOME, the C locale, and what the step adds. Nothing else of the
    Author's shell (DOCKER_CONTEXT, proxies, GIT_DIR, tokens) reaches a tool."""
    env = {
        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
        "HOME": str(Path.home()),
        "LC_ALL": "C",
    }
    env.update(extra)
    return env


def stream(argv: list[str], env: dict[str, str], cwd: Path) -> tuple[int, str]:
    """Run a command, print its output cleaned as it arrives, and return its exit code and output."""
    try:
        proc = subprocess.Popen(
            argv,
            env=env,
            cwd=cwd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            encoding="utf-8",
            errors="replace",
        )
    except OSError as exc:
        say(f"can't run {argv[0]}: {exc.strerror or exc}")
        return 127, ""
    lines = []
    assert proc.stdout is not None
    for line in proc.stdout:
        lines.append(line)
        say(line.rstrip("\n"))
    return proc.wait(), "".join(lines)


def classify(step: Step, rc: int, output: str) -> Step:
    """make check's rules (tools/gates/run_checks.py): non-zero is FAIL; then a PENDING line, a "PLANNED (" line, or
    a "SKIP:" line sets that status; otherwise PASS."""
    lines = output.splitlines()
    if rc != 0:
        return step.fail(f"exited {rc}")
    pending = [ln for ln in lines if ln.startswith("PENDING")]
    planned = [ln for ln in lines if ln.startswith("PLANNED (")]
    skipped = [ln[len("SKIP:") :].strip() for ln in lines if ln.startswith("SKIP:")]
    if pending:
        step.status, step.notes = "PENDING", pending
    elif planned:
        step.status, step.notes = "PLANNED", planned
    elif skipped:
        step.status, step.notes = "SKIP", skipped
    return step


def py_host(script: Path, *args: str) -> list[str]:
    return [
        sys.executable,
        "-I",
        "-B",
        "-X",
        "pycache_prefix=/dev/null",
        str(script),
        *args,
    ]


# --------------------------------------------------------------------------------------------------
# git, the main tree, and the export
# --------------------------------------------------------------------------------------------------
def git(repo: Path, *args: str, binary: bool = False) -> subprocess.CompletedProcess:
    # Replace refs live under .git/refs/replace, which git status doesn't show; with this, git reads each
    # commit's own objects.
    return subprocess.run(
        ["git", "-C", str(repo), *args],
        env=tool_env(GIT_NO_REPLACE_OBJECTS="1"),
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=not binary,
        check=False,
        timeout=600,
    )


def main_tree() -> Path:
    """The main working tree, which must be where this file lives: a linked worktree's copy is a branch's."""
    gate = Path(__file__).resolve()
    top = git(gate.parent, "rev-parse", "--show-toplevel")
    common = git(gate.parent, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if top.returncode or common.returncode:
        raise Refusal(f"{gate} isn't inside a git work tree")
    common_dir = Path(common.stdout.strip()).resolve()
    main = common_dir.parent
    if (
        common_dir.name != ".git"
        or Path(top.stdout.strip()).resolve() != main
        or gate != main / "tools" / "gates" / "gate"
    ):
        raise Refusal(
            f"run the main working tree's gate, {main}/tools/gates/gate: {gate} is a linked worktree's copy, "
            "which a branch can change"
        )
    return main


def object_id(kind: bytes, data: bytes) -> str:
    """The ID git gives an object of this kind and content (SHA-1 object format)."""
    return hashlib.sha1(b"%s %d\0" % (kind, len(data)) + data).hexdigest()


def tree_id(directory: Path) -> str | None:
    """The tree ID git would give a directory's contents, or None for an empty one, which a tree can't hold."""
    entries = []
    with os.scandir(directory) as found:
        for entry in found:
            name = os.fsencode(entry.name)
            if entry.is_symlink():
                target = os.fsencode(os.readlink(entry.path))
                entries.append((name, b"120000", object_id(b"blob", target)))
            elif entry.is_dir(follow_symlinks=False):
                sub = tree_id(Path(entry.path))
                if sub is not None:
                    entries.append(
                        (name + b"/", b"40000", sub)
                    )  # git orders a tree as if it ended in /
            elif entry.is_file(follow_symlinks=False):
                executable = entry.stat(follow_symlinks=False).st_mode & 0o100
                data = Path(entry.path).read_bytes()
                mode = b"100755" if executable else b"100644"
                entries.append((name, mode, object_id(b"blob", data)))
            else:
                raise Stop(f"{entry.path} is not a file, a link, or a directory")
    if not entries:
        return None
    entries.sort()
    body = b"".join(
        mode + b" " + key.removesuffix(b"/") + b"\0" + bytes.fromhex(oid)
        for key, mode, oid in entries
    )
    return object_id(b"tree", body)


def resolve(repo: Path, ref: str) -> str:
    done = git(repo, "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}")
    sha = done.stdout.strip()
    if done.returncode or not SHA_RE.fullmatch(sha):
        raise Stop(f"{ref} isn't a commit in {repo}")
    return sha


def commit_tree(repo: Path, sha: str) -> str:
    """The tree a commit names, read from the commit object, after rehashing the object against its SHA: git
    cat-file doesn't, and so the export's tree check proves the export whatever .git holds."""
    done = git(repo, "cat-file", "commit", sha, binary=True)
    if done.returncode or object_id(b"commit", done.stdout) != sha:
        raise Stop(f"the object store's copy of {sha} isn't that commit; run git fsck")
    tree = re.fullmatch(rb"tree ([0-9a-f]{40})", done.stdout.split(b"\n", 1)[0])
    if not tree:
        raise Stop(f"commit {sha} names no tree")
    return tree.group(1).decode()


def extract(data: bytes, dest: Path) -> None:
    dest.mkdir(mode=0o700)
    with tarfile.open(fileobj=io.BytesIO(data), mode="r:") as tar:
        tar.extractall(
            dest, filter="data"
        )  # no absolute paths, no "..", no devices, no links out


def make_read_only(top: Path) -> None:
    for dirpath, _, filenames in os.walk(top):
        for name in filenames:
            path = Path(dirpath, name)
            if not path.is_symlink():
                mode = stat.S_IMODE(path.lstat().st_mode)
                path.chmod(0o555 if mode & 0o111 else 0o444)
        Path(dirpath).chmod(0o555)


def remove(top: Path) -> None:
    """Delete a tree the gate made, whatever modes a container left in it; links are removed, never followed."""
    if not top.exists():
        return
    for dirpath, dirnames, _ in os.walk(top):
        for name in dirnames:
            path = Path(dirpath, name)
            if not path.is_symlink():
                path.chmod(0o700)
        Path(dirpath).chmod(0o700)
    shutil.rmtree(top, ignore_errors=True)


def export(repo: Path, ref: str, tmp: Path) -> tuple[str, Path, bytes]:
    """Resolve REF once, export that commit, and prove the export is the commit's own tree (plan §11)."""
    replaced = git(repo, "for-each-ref", "--format=%(refname)", "refs/replace/")
    if replaced.returncode:
        raise Stop("git for-each-ref couldn't list refs/replace")
    if replaced.stdout.strip():
        raise Stop(
            f"refs/replace holds {len(replaced.stdout.split())} ref(s). The merge and every checkout honor a "
            "replace ref, so the gate would vouch for a commit other than the one the merge writes: remove them "
            "(git replace -l, git replace -d) and run the gate again"
        )
    sha = resolve(repo, ref)
    expected = commit_tree(repo, sha)
    attributes = git(
        repo, "rev-parse", "--path-format=absolute", "--git-path", "info/attributes"
    )
    if attributes.returncode or Path(attributes.stdout.strip()).exists():
        raise Stop(
            f"{attributes.stdout.strip() or 'info/attributes'} exists, and git archive would apply its "
            "export-ignore and export-subst rules; move it aside first"
        )
    listing = git(repo, "ls-tree", "-r", "-z", sha, binary=True)
    if listing.returncode:
        raise Stop(f"git ls-tree {sha} failed")
    if any(line.startswith(b"160000 ") for line in listing.stdout.split(b"\0")):
        raise Stop(
            f"commit {sha} holds a submodule, which git archive exports as an empty directory"
        )
    archive = git(repo, "archive", "--format=tar", sha, binary=True)
    if archive.returncode:
        raise Stop(
            f"git archive {sha} failed: {archive.stderr.decode(errors='replace').strip()[-300:]}"
        )
    target = tmp / "export"
    try:
        extract(archive.stdout, target)
    except (tarfile.TarError, OSError) as exc:
        raise Stop(f"the export of {sha} couldn't be extracted safely: {exc}") from exc
    # The checks above name what is known to steer git archive. This one doesn't depend on that list.
    if tree_id(target) != expected:
        raise Stop(
            f"the export of {sha} doesn't match the commit's own tree, so something changed what git archive "
            "wrote: a .gitattributes export rule in the commit, or something in .git (git fsck)"
        )
    make_read_only(target)
    return sha, target, archive.stdout


def makefiles(repo: Path, export_dir: Path) -> Step:
    """The container phase's make reads a GNUmakefile or makefile first, so only main's GNUmakefile may be there."""
    step = Step("makefiles")
    if os.path.lexists(export_dir / "makefile"):
        return step.fail(
            "the commit has a makefile, which make would read instead of the Makefile"
        )
    gnu = export_dir / "GNUmakefile"
    if not os.path.lexists(gnu):
        return step.set("PASS", "no GNUmakefile and no makefile")
    mains = git(repo, "cat-file", "blob", "main:GNUmakefile", binary=True)
    if mains.returncode:
        return step.fail("the commit has a GNUmakefile, and main has none")
    if gnu.is_symlink() or not gnu.is_file() or gnu.read_bytes() != mains.stdout:
        return step.fail("the commit's GNUmakefile isn't main's")
    return step.set("PASS", "main's GNUmakefile and no makefile")


# --------------------------------------------------------------------------------------------------
# The container phase
# --------------------------------------------------------------------------------------------------
def host_engine_env() -> dict[str, str]:
    return tool_env(DOCKER_HOST=HOST_ENGINE)


def build_devcontainer(
    report: Report, docker: str, export_dir: Path, tmp: Path
) -> str | None:
    step = Step("devcontainer")
    if not (export_dir / ".devcontainer" / "Dockerfile").is_file():
        report.add(step.fail("the commit has no .devcontainer/Dockerfile"))
        return None
    tag = f"{DEVCONTAINER}:{tree_id(export_dir / '.devcontainer')}"
    iid = tmp / "devcontainer.iid"
    begin("devcontainer", f"{tag}, from the export, on this machine's engine")
    rc, _ = stream(
        [
            docker,
            "build",
            "--file",
            str(export_dir / ".devcontainer" / "Dockerfile"),
            "--tag",
            tag,
            "--iidfile",
            str(iid),
            str(export_dir),
        ],
        host_engine_env(),
        tmp,
    )
    image = iid.read_text(encoding="utf-8").strip() if iid.is_file() else ""
    if rc != 0 or not IMAGE_ID_RE.fullmatch(image):
        report.add(step.fail("the image didn't build"))
        return None
    report.add(step.set("PASS", image[:19]))
    return image


def container(
    docker: str,
    image: str,
    work: Path,
    command: list[str],
    *,
    network: bool,
    workdir: str = "/work",
    extra: tuple[str, ...] = (),
) -> list[str]:
    argv = [
        docker,
        "run",
        "--rm",
        "--init",
        "--cap-drop",
        "ALL",
        "--security-opt",
        "no-new-privileges",
        "--user",
        f"{os.getuid()}:{os.getgid()}",
        "--mount",
        f"type=bind,source={work},target=/work",
        "--workdir",
        workdir,
        "--env",
        "HOME=/tmp",
        "--env",
        "npm_config_cache=/tmp/npm-cache",
    ]
    if not network:
        argv += ["--network", "none"]
    return [*argv, *extra, image, *command]


def prepare(
    report: Report, data: bytes, export_dir: Path, tmp: Path, names: list[str]
) -> tuple[str, str, Path] | None:
    """The devcontainer image and an installed copy of the export, or None after reporting why each step that
    didn't run, from the image on through names, didn't."""

    def rest(reason: str, *steps: str) -> None:
        for name in [*steps, *names]:
            report.add(Step(name).fail(f"not run: {reason}"))

    docker = shutil.which("docker")
    if docker is None:
        rest("docker isn't installed", "devcontainer", "npm-ci")
        return None
    image = build_devcontainer(report, docker, export_dir, tmp)
    if image is None:
        rest(
            "no devcontainer image; while it won't build, tools/gates/gate --host runs the host phase alone, "
            "marked DEGRADED (plan §19)",
            "npm-ci",
        )
        return None
    work = tmp / "work"
    if "," in str(work):
        rest(
            f"the temporary path {work} holds a comma, which a --mount can't take",
            "npm-ci",
        )
        return None
    try:
        extract(data, work)
    except (tarfile.TarError, OSError) as exc:
        rest(f"the export's working copy couldn't be made: {exc}", "npm-ci")
        return None
    begin("npm-ci", "npm ci --ignore-scripts, the one step with the network")
    rc, _ = stream(
        container(
            docker,
            image,
            work,
            ["npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"],
            network=True,
        ),
        host_engine_env(),
        tmp,
    )
    if report.add(classify(Step("npm-ci"), rc, "")).status != "PASS":
        rest("npm ci failed")
        return None
    return docker, image, work


def container_phase(report: Report, data: bytes, export_dir: Path, tmp: Path) -> None:
    names = [name for name, _ in CONTAINER_TARGETS]
    if report.status("makefiles") != "PASS":
        for name in ["devcontainer", "npm-ci", *names]:
            report.add(
                Step(name).fail(
                    "not run: the export's makefiles aren't what main allows"
                )
            )
        return
    ready = prepare(report, data, export_dir, tmp, names)
    if ready is None:
        return
    docker, image, work = ready
    for name, target in CONTAINER_TARGETS:
        begin(name, f"make {target}, --network none")
        rc, out = stream(
            container(
                docker,
                image,
                work,
                ["make", "-f", "Makefile", "--no-print-directory", target],
                network=False,
            ),
            host_engine_env(),
            tmp,
        )
        report.add(classify(Step(name), rc, out))


