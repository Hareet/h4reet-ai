# The template for prod's env file (spec 000, specs/000-local-foundations/contracts/env-files.md).
# make init-env ENV=prod copies it to ~/.config/h4reet-ai/env/prod.env (0600, in a 0700 directory, outside the
# repository), replaces __HOME__ with your home, and generates every __GENERATE__ value. You fill each __ASK__
# value yourself, in an editor in your own terminal. Preflight refuses the file while a placeholder is left, or
# while its keys differ from this template's (checks P3 and P4).
# Grammar (contracts/env-files.md §1.1): KEY=VALUE, no spaces around =, no export, and no ${...}. Quote a value
# with single quotes if it holds whitespace, $, ", `, \, or #. The file is read as data and never sourced.

# The stack (§2). The ports are prod's own, so no other stack overlaps them (FR-020).
H4_STACK=prod
H4_ENV=prod
COMPOSE_PROJECT_NAME=h4reet-prod
COMPOSE_PROFILES=gpu
H4_MODEL_DIR=__HOME__/.local/share/h4reet/models
H4_STATE_DIR=__HOME__/.local/state/h4reet/prod
H4_AWS_DIR=__HOME__/.config/h4reet-ai/aws-home/.aws
# The Windows drive that holds WSL's ext4.vhdx. Preflight checks its free space as well as ext4's (P13).
H4_VHDX_MOUNT=/mnt/c
H4_API_PORT=18000
H4_LANGFUSE_PORT=18001
H4_GRAFANA_PORT=18002
H4_ADMIN_PORT=18003
H4_OTLP_PORT=18004
# Empty on host stacks: only the agents' engine builds through a proxy.
H4_BUILD_PROXY=

# The model (§3). A model change is this file and deploy/models.lock, never code.
MODEL_FILE=Qwen3-30B-A3B-Instruct-2507-Q4_K_M.gguf
MODEL_ALIAS=qwen3-30b-a3b-instruct-2507
MODEL_CTX_SIZE=32768
MODEL_PARALLEL=4
MODEL_THREADS=4
LOCAL_MODEL_BASE_URL=http://model-server:8080/v1

# The gateway (§4).
GATEWAY_DB_PASSWORD=__GENERATE__
GATEWAY_GRAFANA_RO_PASSWORD=__GENERATE__
# The hash make operator-token ENV=prod prints. The token stays in ~/.config/h4reet-ai/operator/prod.token.
OPERATOR_TOKEN_SHA256=__ASK__
ALERT_DELIVERY=real
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_BOT_TOKEN=__ASK__
TELEGRAM_CHAT_ID=__ASK__
SMTP_HOST=__ASK__
# 465 with SMTP_TLS=implicit, or 587 with SMTP_TLS=starttls.
SMTP_PORT=__ASK__
SMTP_TLS=__ASK__
SMTP_USER=__ASK__
SMTP_PASSWORD=__ASK__
ALERT_EMAIL_FROM=__ASK__
ALERT_EMAIL_TO=__ASK__
# Becomes the gateway container's AWS_PROFILE, so your shell's own AWS_PROFILE can never stand in for it.
GATEWAY_AWS_PROFILE=h4reet-bedrock
TELEMETRY_PAYLOAD_SAMPLING=off

# Langfuse (§5).
LANGFUSE_PUBLIC_KEY=__GENERATE__
LANGFUSE_SECRET_KEY=__GENERATE__
LANGFUSE_SALT=__GENERATE__
LANGFUSE_ENCRYPTION_KEY=__GENERATE__
LANGFUSE_NEXTAUTH_SECRET=__GENERATE__
LANGFUSE_DB_PASSWORD=__GENERATE__
LANGFUSE_INIT_USER_EMAIL=operator@h4reet.local
LANGFUSE_INIT_USER_PASSWORD=__GENERATE__

# ClickHouse, Valkey, SeaweedFS, and Grafana (§6).
CLICKHOUSE_PASSWORD=__GENERATE__
VALKEY_PASSWORD=__GENERATE__
SEAWEEDFS_S3_ACCESS_KEY=__GENERATE__
SEAWEEDFS_S3_SECRET_KEY=__GENERATE__
GF_SECURITY_ADMIN_PASSWORD=__GENERATE__
