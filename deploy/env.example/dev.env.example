# The template for dev's env file (spec 000, specs/000-local-foundations/contracts/env-files.md).
# make init-env ENV=dev copies it to ~/.config/h4reet-ai/env/dev.env (0600, in a 0700 directory, outside the
# repository), replaces __HOME__ and __REPO__ with this machine's paths, and generates every __GENERATE__ value.
# You fill each __ASK__ value yourself, in an editor in your own terminal. Preflight refuses the file while a
# placeholder is left, or while its keys differ from this template's (checks P3 and P4).
# Grammar (contracts/env-files.md §1.1): KEY=VALUE, no spaces around =, no export, and no ${...}. Quote a value
# with single quotes if it holds whitespace, $, ", `, \, or #. The file is read as data and never sourced.
# deploy/env.agents/dev-cpu.vars has exactly these keys, plus H4_TREE and H4_DEVCPU_OPERATOR_TOKEN.

# The stack (§2). The ports are dev's own, so no other stack overlaps them (FR-020).
H4_STACK=dev
H4_ENV=dev
COMPOSE_PROJECT_NAME=h4reet-dev
COMPOSE_PROFILES=gpu,dev-receivers
H4_MODEL_DIR=__HOME__/.local/share/h4reet/models
H4_STATE_DIR=__HOME__/.local/state/h4reet/dev
# An empty directory: no Bedrock call is possible outside prod, even by mistake.
H4_AWS_DIR=__REPO__/deploy/aws-none
# The Windows drive that holds WSL's ext4.vhdx. Preflight checks its free space as well as ext4's (P13).
H4_VHDX_MOUNT=/mnt/c
H4_API_PORT=18100
H4_LANGFUSE_PORT=18101
H4_GRAFANA_PORT=18102
H4_ADMIN_PORT=18103
H4_OTLP_PORT=18104
# Empty on host stacks: only the agents' engine builds through a proxy.
H4_BUILD_PROXY=

# The model (§3): the stand-in. A model change is this file and deploy/models.lock, never code.
MODEL_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf
MODEL_ALIAS=qwen2.5-0.5b-instruct
MODEL_CTX_SIZE=8192
MODEL_PARALLEL=2
MODEL_THREADS=4
LOCAL_MODEL_BASE_URL=http://model-server:8080/v1

# The gateway (§4).
GATEWAY_DB_PASSWORD=__GENERATE__
GATEWAY_GRAFANA_RO_PASSWORD=__GENERATE__
# The hash make operator-token ENV=dev prints. The token stays in ~/.config/h4reet-ai/operator/dev.token.
OPERATOR_TOKEN_SHA256=__ASK__
# dev's alerts go to the stand-ins. Only the recorded run (make breach-test ENV=dev DELIVERY=real) sends them
# to the real channels, which is when the empty channel keys below need your values (§7.2).
ALERT_DELIVERY=standin
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=
# implicit with port 465, or starttls with port 587, to match the mailbox.
SMTP_TLS=implicit
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# dev only (§7): the test clock and the synthetic metered source that the breach test drives.
GATEWAY_TEST_CLOCK=1
GATEWAY_TEST_SYNTHETIC_SPEND=1
TELEMETRY_PAYLOAD_SAMPLING=off

# Langfuse (§5).
LANGFUSE_PUBLIC_KEY=__GENERATE__
LANGFUSE_SECRET_KEY=__GENERATE__
LANGFUSE_SALT=__GENERATE__
LANGFUSE_ENCRYPTION_KEY=__GENERATE__
LANGFUSE_NEXTAUTH_SECRET=__GENERATE__
LANGFUSE_DB_PASSWORD=__GENERATE__
LANGFUSE_INIT_USER_EMAIL=operator@h4reet.local
LANGFUSE_INIT_USER_PASSWORD=__GENERATE__

# ClickHouse, Valkey, SeaweedFS, and Grafana (§6).
CLICKHOUSE_PASSWORD=__GENERATE__
VALKEY_PASSWORD=__GENERATE__
SEAWEEDFS_S3_ACCESS_KEY=__GENERATE__
SEAWEEDFS_S3_SECRET_KEY=__GENERATE__
GF_SECURITY_ADMIN_PASSWORD=__GENERATE__
