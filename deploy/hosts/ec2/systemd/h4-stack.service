# EC2's stack at boot: the deployer asks the bucket first, then starts the newest release, or, with the bucket out of
# reach, its last one, and alerts (spec 001 FR-046; contracts/releases-deployer.md §3; the release's deployer --boot, by
# deploy_first_step.py). Its class's services alone (preflight's HOST_CLASSES).
[Unit]
Description=h4reet: EC2's stack
After=docker.service h4-write-env.service
# Wants, not Requires, the env file's unit, as the tunnel end's.
Requires=docker.service
Wants=h4-write-env.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=3700
Environment=HTTPS_PROXY=http://127.0.0.1:3128 NO_PROXY=169.254.169.254
ExecStart=/usr/bin/python3 -I -B /opt/h4reet/deploy/scripts/deploy_first_step.py --host ec2 --boot
# A stop stops the class's containers, at shutdown too.
ExecStop=/usr/bin/docker compose -p h4reet-prod stop

[Install]
WantedBy=multi-user.target
