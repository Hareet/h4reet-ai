# EC2 gateway's Bedrock credentials, as h4-prod-gateway, refreshed (spec 001 research.md R-15; deploy/hosts/ec2/
# ec2_host.py, installed from the release's tree by the deployer's host step).
[Unit]
Description=h4reet: EC2 gateway's Bedrock credentials
After=h4-egress-proxy.service h4-write-env.service

[Service]
Type=oneshot
Environment=HTTPS_PROXY=http://127.0.0.1:3128 NO_PROXY=169.254.169.254
ExecStart=/usr/bin/python3 -I -B /opt/h4reet/release/ec2_host.py credentials
