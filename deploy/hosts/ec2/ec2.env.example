# EC2's env file (spec 001 contracts/env-cloud.md §1 and §2), which deploy/scripts/write_env.py writes at boot to
# /run/h4reet/ec2.env, on tmpfs, mode 0600, from this template: each value as written here, but
#   __PARAMETER__                 the SecureString /h4reet/ec2/<KEY>, the Author's, from Parameter Store;
#   __PARAMETER:<path>__          that parameter;
#   __ACCOUNT_REGISTRY__          the account's ECR registry, from the instance's own identity document.
# A missing parameter stops the boot, naming it, and so does an instance whose Name tag isn't h4-prod-ec2. Preflight's
# ec2 class holds the file to this template (deploy/scripts/preflight.py, ec2_checks). Read as data and never sourced.
# No image is named here: the deployer's release env file alone names each upstream copy (H4_IMAGE_<SERVICE>).
H4_HOST=ec2
H4_STACK=prod
H4_ENV=prod
COMPOSE_PROJECT_NAME=h4reet-prod
COMPOSE_PROFILES=ec2
H4_REGISTRY=__ACCOUNT_REGISTRY__
RELEASE_BUCKET=__PARAMETER:/h4reet/hosts/RELEASE_BUCKET__
# Compose's bind roots: the gateway's journal on the data volume, which outlives a replace (ec2_host.py makes it), its
# AWS profile on tmpfs (ec2_host.py's credential timer), and no model directory, since EC2 runs no model server.
H4_STATE_DIR=/srv/h4reet/data/state
H4_AWS_DIR=/run/h4reet/ec2/aws
H4_MODEL_DIR=/var/lib/h4reet/none
# spec 000's prod ports, on EC2's loopback, for the Author's Systems Manager session (FR-050).
H4_API_PORT=18000
H4_LANGFUSE_PORT=18001
H4_GRAFANA_PORT=18002
H4_ADMIN_PORT=18003
H4_OTLP_PORT=18004
H4_SITE_PORT=18005
# No model server on EC2 (FR-044): its route names no local adapter, and this name never resolves.
LOCAL_MODEL_BASE_URL=http://model-server.invalid:8080/v1
MODEL_ALIAS=none-on-ec2
# The shared state on the tunnel end, at its private address, with TLS verified by its CA and its name (contracts/
# shared-state.md §3); the gateway refuses to start without it (local_store_on_shared_host).
GATEWAY_DB_URL=postgres://gateway@10.42.1.10:5432/h4reet?sslmode=verify-full
GATEWAY_DB_TLS_SERVERNAME=shared-state
GATEWAY_DB_TLS_CA=__PARAMETER:/h4reet/hosts/SHARED_STATE_TLS_CA__
GATEWAY_DB_PASSWORD=__PARAMETER:/h4reet/ec2/DB_GATEWAY_PASSWORD__
GATEWAY_GRAFANA_RO_PASSWORD=__PARAMETER:/h4reet/ec2/DB_GRAFANA_RO_PASSWORD__
OPERATOR_TOKEN_SHA256=__PARAMETER__
ALERT_DELIVERY=real
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_BOT_TOKEN=__PARAMETER__
TELEGRAM_CHAT_ID=__PARAMETER__
# SMTP's implicit TLS on 465 alone: the gateway's proxy reads the name in the TLS hello, which STARTTLS on 587 sends
# only after the plain greeting (sni_proxy.py).
SMTP_HOST=__PARAMETER__
SMTP_PORT=465
SMTP_TLS=implicit
SMTP_USER=__PARAMETER__
SMTP_PASSWORD=__PARAMETER__
ALERT_EMAIL_FROM=__PARAMETER__
ALERT_EMAIL_TO=__PARAMETER__
# Bedrock, EC2's second route, as h4-prod-gateway, through the credential timer's profile (ec2_host.py).
GATEWAY_AWS_PROFILE=h4reet-bedrock
# The Anthropic API, EC2's first route (spec 010's preconditions; FR-068): its key, passed to the gateway alone.
GATEWAY_ANTHROPIC_API_KEY=__PARAMETER__
TELEMETRY_PAYLOAD_SAMPLING=off
LANGFUSE_PUBLIC_KEY=__PARAMETER__
LANGFUSE_SECRET_KEY=__PARAMETER__
LANGFUSE_SALT=__PARAMETER__
LANGFUSE_ENCRYPTION_KEY=__PARAMETER__
LANGFUSE_NEXTAUTH_SECRET=__PARAMETER__
LANGFUSE_DB_PASSWORD=__PARAMETER__
LANGFUSE_INIT_USER_EMAIL=operator@h4reet.local
LANGFUSE_INIT_USER_PASSWORD=__PARAMETER__
CLICKHOUSE_PASSWORD=__PARAMETER__
VALKEY_PASSWORD=__PARAMETER__
SEAWEEDFS_S3_ACCESS_KEY=__PARAMETER__
SEAWEEDFS_S3_SECRET_KEY=__PARAMETER__
GF_SECURITY_ADMIN_PASSWORD=__PARAMETER__
# The relay block's token for EC2 (contracts/tunnel.md §4), which the Author's tunnel-keys target writes.
RELAY_TOKEN_SELF=__PARAMETER__
