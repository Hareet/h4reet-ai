# The tunnel end's env file and key files, from Parameter Store to tmpfs, at each boot (spec 001 contracts/env-cloud.md
# §1; deploy/scripts/write_env.py). A missing name stops the boot here, and the stack doesn't start. Docker starts after
# it, so no container Docker restarts at boot finds its key files gone from tmpfs; by ordering alone, so restarting this
# unit (h4-tunnel-restart.service) never restarts Docker (group 5's review, I4).
[Unit]
Description=h4reet: the tunnel end's env file
After=h4-egress-proxy.service network-online.target
Requires=h4-egress-proxy.service
Before=docker.service h4-stack.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HTTPS_PROXY=http://127.0.0.1:3128 NO_PROXY=169.254.169.254
ExecStart=/usr/bin/python3 -I -B /opt/h4reet/deploy/scripts/write_env.py --host tunnel-end --template /etc/h4reet/tunnel-end.env.example --out /run/h4reet/tunnel-end.env --keys-dir /run/h4reet/tunnel-end/keys

[Install]
WantedBy=multi-user.target
