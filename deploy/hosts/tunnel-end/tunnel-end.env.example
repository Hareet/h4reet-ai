# The tunnel end's env file (spec 001 contracts/env-cloud.md §1 and §2), which deploy/scripts/write_env.py writes at
# boot to /run/h4reet/tunnel-end.env, on tmpfs, mode 0600, from this template: each value as written here, but
#   __PARAMETER__                 the SecureString /h4reet/tunnel-end/<KEY>, the Author's, from Parameter Store;
#   __PARAMETER:<path>__          that parameter;
#   __ACCOUNT_REGISTRY__          the account's ECR registry, from the instance's own identity document.
# A missing parameter stops the boot, naming it. Preflight's tunnel-end class holds the file to this template
# (deploy/scripts/preflight.py, tunnel_end_checks). Read as data and never sourced.
H4_HOST=tunnel-end
H4_STACK=prod
H4_ENV=prod
COMPOSE_PROJECT_NAME=h4reet-prod
COMPOSE_PROFILES=tunnel-end
H4_REGISTRY=__ACCOUNT_REGISTRY__
RELEASE_BUCKET=__PARAMETER:/h4reet/hosts/RELEASE_BUCKET__
# EC2's collector, inside the VPC, at EC2's fixed private address (group 7 makes EC2 and publishes its collector).
EC2_COLLECTOR_ENDPOINT=http://10.42.0.20:4318
TELEMETRY_BLOCK_TOKEN=__PARAMETER__
# The bind roots the compose file requires of every stack (`:?`), for the laptop's and EC2's services; compose
# interpolates the whole file before it starts the class's services by name. None of the tunnel end's services binds
# them, so they name one empty folder no service reads (group 5's review, I5).
H4_STATE_DIR=/var/lib/h4reet/none
H4_AWS_DIR=/var/lib/h4reet/none
H4_MODEL_DIR=/var/lib/h4reet/none
