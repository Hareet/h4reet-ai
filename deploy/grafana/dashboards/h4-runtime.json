      }
    },
    {
      "type": "timeseries",
      "id": 18,
      "title": "Queue fill",
      "description": "How full each exporter's sending queue is.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 8,
        "y": 38,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "max by (exporter) (otelcol_exporter_queue_size / otelcol_exporter_queue_capacity)",
          "range": true,
          "instant": false,
          "legendFormat": "{{exporter}}"
        }
