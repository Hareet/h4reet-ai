{
  "role": "ops",
  "parent": "ceiling",
  "image": "h4-night-worker:{{IMAGE_TAG}}",
  "user": "{{UID}}:{{GID}}",
  "mounts": [
    {
      "host": "{{ENGINE_CERTS}}",
      "container": "/night/engine",
      "mode": "ro"
    },
    {
      "host": "/srv/studio/briefs",
      "container": "/srv/studio/briefs",
      "mode": "rw"
    },
    {
      "host": "/srv/studio/handoff",
      "container": "/srv/studio/handoff",
      "mode": "ro"
    }
  ],
  "networks": ["h4-night", "h4-night-engine"],
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CONFIG_DIR": "/night/claude",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",
    "DOCKER_CONFIG": "/night/engine",
    "DOCKER_HOST": "tcp://127.0.0.1:2376",
    "GIT_AUTHOR_EMAIL": "night-ops@night-shift.invalid",
    "GIT_AUTHOR_NAME": "night-ops",
    "GIT_COMMITTER_EMAIL": "night-ops@night-shift.invalid",
    "GIT_COMMITTER_NAME": "night-ops",
    "GIT_CONFIG_COUNT": "2",
    "GIT_CONFIG_KEY_0": "gc.auto",
    "GIT_CONFIG_KEY_1": "maintenance.auto",
    "GIT_CONFIG_VALUE_0": "0",
    "GIT_CONFIG_VALUE_1": "false",
    "HOME": "/night/home",
    "HTTPS_PROXY": "http://egress:3128",
    "NIGHT_ENGINE_FWD": "engine-fwd:2376",
    "NO_PROXY": "engine-fwd,localhost,127.0.0.1",
    "NPM_CONFIG_CACHE": "/tmp/npm-cache",
    "PYTHONDONTWRITEBYTECODE": "1",
    "SANDBOX_RUNTIME": "1",
    "TMPDIR": "/tmp",
    "UV_CACHE_DIR": "/tmp/uv-cache",
    "XDG_CACHE_HOME": "/tmp/cache"
  },
  "env_file": "{{HOME}}/.config/h4reet-ai/night-shift/claude.env",
  "cap_drop": ["ALL"],
  "security_opt": ["no-new-privileges"],
  "read_only": true,
  "tmpfs": ["/tmp:rw,exec,nosuid,size=2g", "/night/home:rw,exec,nosuid,size=512m"],
  "limits": {
    "memory": "4g",
    "cpus": "2",
    "pids": 512
  },
  "requests": ["plan"],
  "x-h4": {
    "example": true,
    "task": "writing"
  }
}
