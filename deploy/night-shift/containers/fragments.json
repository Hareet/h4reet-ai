{
  "schema": 1,
  "placeholders": [
    "UID",
    "GID",
    "HOME",
    "REPO",
    "NIGHT_ROOT",
    "COMFYUI_DIR",
    "COMFYUI_VENV",
    "COMFYUI_PORT",
    "BLENDER_DIR",
    "ENGINE_CERTS",
    "IMAGE_TAG"
  ],
  "networks": {
    "h4-night": { "internal": true, "proxy": "egress" },
    "h4-night-engine": { "internal": true },
    "h4-night-studio": { "internal": true, "proxy": "egress-studio" },
    "h4-night-plan": { "internal": true, "proxy": "egress-plan" },
    "h4-night-out": { "internal": false }
  },
  "base": {
    "user": "{{UID}}:{{GID}}",
    "cap_drop": ["ALL"],
    "security_opt": ["no-new-privileges"]
  },
  "images": {
    "worker": "h4-night-worker:{{IMAGE_TAG}}",
    "studio": "h4-night-studio:{{IMAGE_TAG}}",
    "comfyui": "h4-night-comfyui:{{IMAGE_TAG}}"
  },
  "env_files": {
    "token": "{{HOME}}/.config/h4reet-ai/night-shift/claude.env"
  },
  "mounts": {
    "night-ro": [{ "path": "{{NIGHT_ROOT}}", "mode": "ro" }],
    "briefs-ro": [{ "path": "/srv/studio/briefs", "mode": "ro" }],
    "briefs-rw": [{ "path": "/srv/studio/briefs", "mode": "rw" }],
    "handoff-ro": [{ "path": "/srv/studio/handoff", "mode": "ro" }],
    "handoff-rw": [{ "path": "/srv/studio/handoff", "mode": "rw" }],
    "outputs-rw": [{ "path": "/srv/studio/outputs", "mode": "rw" }],
    "workflows-ro": [{ "path": "/srv/studio/workflows", "mode": "ro" }],
    "engine": [{ "host": "{{ENGINE_CERTS}}", "container": "/night/engine", "mode": "ro" }],
    "plan": [
      { "path": "{{HOME}}/.config/h4reet-ai/infra", "mode": "ro" },
      { "path": "{{HOME}}/.config/h4reet-ai/infra/data", "mode": "rw" },
      { "path": "{{HOME}}/.config/h4reet-ai/infra/plans", "mode": "rw" },
      { "path": "{{HOME}}/.config/h4reet-ai/infra/state", "mode": "rw" },
      { "path": "{{HOME}}/.local/share/h4reet/terraform-providers", "mode": "ro" }
    ],
    "comfyui": [
      { "path": "{{COMFYUI_DIR}}", "mode": "ro" },
      { "path": "{{COMFYUI_VENV}}", "mode": "ro" },
      { "host": "{{NIGHT_ROOT}}/.comfyui/user", "container": "/comfyui/user", "mode": "rw" }
    ]
  },
  "env": {
    "session": {
      "HOME": "/night/home",
      "TMPDIR": "/tmp",
      "CLAUDE_CONFIG_DIR": "/night/claude",
      "SANDBOX_RUNTIME": "1",
      "DISABLE_AUTOUPDATER": "1",
      "DISABLE_TELEMETRY": "1",
      "DISABLE_ERROR_REPORTING": "1",
      "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
      "PYTHONDONTWRITEBYTECODE": "1",
      "XDG_CACHE_HOME": "/tmp/cache",
      "NPM_CONFIG_CACHE": "/tmp/npm-cache",
      "UV_CACHE_DIR": "/tmp/uv-cache"
    },
    "proxy-night": {
      "HTTPS_PROXY": "http://egress:3128",
      "NO_PROXY": "localhost,127.0.0.1"
    },
    "proxy-engine": {
      "NO_PROXY": "engine-fwd,localhost,127.0.0.1"
    },
    "engine": {
      "DOCKER_HOST": "tcp://127.0.0.1:2376",
      "DOCKER_CONFIG": "/night/engine",
      "NIGHT_ENGINE_FWD": "engine-fwd:2376"
    },
    "git": {
      "GIT_CONFIG_COUNT": "2",
      "GIT_CONFIG_KEY_0": "gc.auto",
      "GIT_CONFIG_VALUE_0": "0",
      "GIT_CONFIG_KEY_1": "maintenance.auto",
      "GIT_CONFIG_VALUE_1": "false",
      "GIT_AUTHOR_NAME": "night-{role}",
      "GIT_AUTHOR_EMAIL": "night-{role}@night-shift.invalid",
      "GIT_COMMITTER_NAME": "night-{role}",
      "GIT_COMMITTER_EMAIL": "night-{role}@night-shift.invalid"
    },
    "studio": {
      "HTTPS_PROXY": "http://egress-studio:3128",
      "NO_PROXY": "h4-night-comfyui,localhost,127.0.0.1",
      "COMFYUI_URL": "http://h4-night-comfyui:{{COMFYUI_PORT}}"
    },
    "plan": {
      "HOME": "{{HOME}}",
      "TMPDIR": "/tmp",
      "HTTPS_PROXY": "http://egress-plan:3128",
      "NO_PROXY": "localhost,127.0.0.1",
      "CHECKPOINT_DISABLE": "1",
      "PYTHONDONTWRITEBYTECODE": "1"
    },
    "comfyui": {
      "HOME": "/night/home",
      "TMPDIR": "/tmp",
      "HF_HUB_OFFLINE": "1",
      "PYTHONDONTWRITEBYTECODE": "1"
    }
  },
  "tmpfs": {
    "session": ["/tmp:rw,nosuid,size=2g", "/night/home:rw,nosuid,size=512m"],
    "studio": ["/tmp:rw,nosuid,size=4g", "/night/home:rw,nosuid,size=1g"],
    "plan": ["/tmp:rw,nosuid,size=1g"],
    "comfyui": [
      "/tmp:rw,nosuid,size=4g",
      "/night/home:rw,nosuid,size=1g",
      "/comfyui/temp:rw,nosuid,size=4g",
      "{{COMFYUI_DIR}}/input:rw,nosuid,size=2g"
    ]
  },
  "limits": {
    "worker": { "memory": "4g", "cpus": "2", "pids": 512 },
    "supervisor": { "memory": "2g", "cpus": "2", "pids": 512 },
    "studio": { "memory": "8g", "cpus": "4", "pids": 1024 },
    "comfyui": { "memory": "24g", "cpus": "6", "pids": 1024 },
    "plan": { "memory": "4g", "cpus": "2", "pids": 512 }
  },
  "roles": {
    "supervisor": {
      "parent": "ceiling",
      "task": "writing",
      "image": "worker",
      "mounts": ["night-ro", "briefs-ro", "handoff-ro"],
      "networks": ["h4-night"],
      "env": ["session", "proxy-night", "git"],
      "env_file": "token",
      "tmpfs": "session",
      "limits": "supervisor",
      "requests": []
    },
    "spec-writer": {
      "parent": "implementer",
      "task": "writing",
      "image": "worker",
      "mounts": [],
      "networks": ["h4-night"],
      "env": ["session", "proxy-night", "git"],
      "env_file": "token",
      "tmpfs": "session",
      "limits": "worker",
      "requests": []
    },
    "implementer": {
      "parent": "ops",
      "task": "writing",
      "image": "worker",
      "mounts": ["briefs-rw", "handoff-ro", "engine"],
      "networks": ["h4-night", "h4-night-engine"],
      "env": ["session", "proxy-night", "proxy-engine", "engine", "git"],
      "env_file": "token",
      "tmpfs": "session",
      "limits": "worker",
      "requests": []
    },
    "reviewer": {
      "parent": "spec-writer",
      "task": "reading",
      "image": "worker",
      "mounts": [],
      "networks": ["h4-night"],
      "env": ["session", "proxy-night", "git"],
      "env_file": "token",
      "tmpfs": "session",
      "limits": "worker",
      "requests": []
    },
    "red-teamer": {
      "parent": "implementer",
      "task": "reading",
      "image": "worker",
      "mounts": ["engine"],
      "networks": ["h4-night", "h4-night-engine"],
      "env": ["session", "proxy-night", "proxy-engine", "engine", "git"],
      "env_file": "token",
      "tmpfs": "session",
      "limits": "worker",
      "requests": []
    },
    "ops": {
      "parent": "ceiling",
      "task": "writing",
      "image": "worker",
      "mounts": ["briefs-rw", "handoff-ro", "engine"],
      "networks": ["h4-night", "h4-night-engine"],
      "env": ["session", "proxy-night", "proxy-engine", "engine", "git"],
      "env_file": "token",
      "tmpfs": "session",
      "limits": "worker",
      "requests": ["plan"]
    },
    "gate-runner": {
      "parent": "ceiling",
      "task": "reading",
      "image": "worker",
      "mounts": [],
      "networks": ["h4-night"],
      "env": ["session", "proxy-night", "git"],
      "env_file": "token",
      "tmpfs": "session",
      "limits": "worker",
      "requests": ["gate"]
    },
    "studio": {
      "parent": "ceiling",
      "task": "none",
      "image": "studio",
      "mounts": ["handoff-rw", "outputs-rw", "briefs-ro", "workflows-ro"],
      "networks": ["h4-night-studio"],
      "env": ["session", "studio"],
      "env_file": "token",
      "tmpfs": "studio",
      "limits": "studio",
      "requests": ["comfyui"],
      "gpus": "all"
    },
    "plan": {
      "parent": "runner",
      "task": "plan",
      "image": "worker",
      "mounts": ["plan"],
      "networks": ["h4-night-plan"],
      "env": ["plan"],
      "env_file": null,
      "tmpfs": "plan",
      "limits": "plan",
      "requests": []
    },
    "comfyui": {
      "parent": "runner",
      "task": "none",
      "image": "comfyui",
      "mounts": ["comfyui", "outputs-rw"],
      "networks": ["h4-night-studio"],
      "env": ["comfyui"],
      "env_file": null,
      "tmpfs": "comfyui",
      "limits": "comfyui",
      "requests": [],
      "gpus": "all"
    }
  },
  "allowlists": {
    "allowlist.json": { "from_settings": true, "add": ["api.anthropic.com"] },
    "allowlist-studio.json": { "hosts": ["api.anthropic.com"] },
    "allowlist-plan.json": {
      "hosts": [
        "sts.amazonaws.com",
        "sts.us-east-1.amazonaws.com",
        "iam.amazonaws.com",
        "s3.amazonaws.com",
        "s3.us-east-1.amazonaws.com",
        "*.s3.amazonaws.com",
        "*.s3.us-east-1.amazonaws.com",
        "budgets.amazonaws.com",
        "ce.us-east-1.amazonaws.com",
        "events.us-east-1.amazonaws.com",
        "logs.us-east-1.amazonaws.com",
        "api.ecr.us-east-1.amazonaws.com",
        "lambda.us-east-1.amazonaws.com",
        "ec2.us-east-1.amazonaws.com",
        "sns.us-east-1.amazonaws.com",
        "sqs.us-east-1.amazonaws.com",
        "sso.us-east-1.amazonaws.com"
      ]
    }
  },
  "x-h4": {
    "note": "build.py makes every spec and the three allowlists from this file, and the night allowlist from main's allowedDomains too (contracts/containers.md). Edit here, then run python3 -I -B build.py; build.py --check fails when a committed file differs. A spec's mounts are its role's own; the worktree, .git, the masks, the Claude folder, and the io folder are the runner's task mounts, which x-h4.task names (contracts/containers.md section 4)."
  }
}
