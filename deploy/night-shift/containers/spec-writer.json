{
  "role": "spec-writer",
  "parent": "implementer",
  "image": "h4-night-worker:{{IMAGE_TAG}}",
  "user": "{{UID}}:{{GID}}",
  "mounts": [],
  "networks": ["h4-night"],
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CONFIG_DIR": "/night/claude",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",
    "GIT_AUTHOR_EMAIL": "night-spec-writer@night-shift.h4reet-ai",
    "GIT_AUTHOR_NAME": "night-spec-writer",
    "GIT_COMMITTER_EMAIL": "night-spec-writer@night-shift.h4reet-ai",
    "GIT_COMMITTER_NAME": "night-spec-writer",
    "GIT_CONFIG_COUNT": "2",
    "GIT_CONFIG_KEY_0": "gc.auto",
    "GIT_CONFIG_KEY_1": "maintenance.auto",
    "GIT_CONFIG_VALUE_0": "0",
    "GIT_CONFIG_VALUE_1": "false",
    "HOME": "/night/home",
    "HTTPS_PROXY": "http://egress:3128",
    "NO_PROXY": "localhost,127.0.0.1",
    "NPM_CONFIG_CACHE": "/tmp/npm-cache",
    "PYTHONDONTWRITEBYTECODE": "1",
    "SANDBOX_RUNTIME": "1",
    "TMPDIR": "/tmp",
    "UV_CACHE_DIR": "/tmp/uv-cache",
    "XDG_CACHE_HOME": "/tmp/cache"
  },
  "env_file": "{{HOME}}/.config/h4reet-ai/night-shift/claude.env",
  "cap_drop": ["ALL"],
  "security_opt": ["no-new-privileges"],
  "read_only": true,
  "tmpfs": ["/tmp:rw,exec,nosuid,size=2g", "/night/home:rw,exec,nosuid,size=512m"],
  "limits": {
    "memory": "4g",
    "cpus": "2",
    "pids": 512
  },
  "requests": [],
  "x-h4": {
    "example": true,
    "task": "writing"
  }
}
