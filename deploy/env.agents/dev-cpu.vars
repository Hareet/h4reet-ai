# dev-cpu's env file: the stack agent sessions run on their own engine (spec 000 FR-039,
# specs/000-local-foundations/contracts/env-files.md §6.1). Committed, because every value in it is a public dummy
# that protects nothing: the engine holds nothing the Author needs. No real value ever goes in this file.
# Each dummy has its key's shape, so the same validators pass, and starts with devcpu or, where the shape allows
# only hex, is a repeated pattern, so nobody mistakes it for a real value. The name avoids the *.env rules on
# purpose, and gitleaks allowlists this one path (plan §11).
# It has exactly deploy/env.example/dev.env.example's keys, plus H4_TREE and H4_DEVCPU_OPERATOR_TOKEN (P4).
# Read as data and never sourced (§1.1).

# The stack (§2). The engine's own paths: the masked, read-only tree, the seeded models, and its state root.
H4_STACK=dev-cpu
H4_ENV=dev
COMPOSE_PROJECT_NAME=h4reet-dev-cpu
COMPOSE_PROFILES=cpu,dev-receivers
H4_TREE=/run/h4agents/tree
H4_MODEL_DIR=/run/h4agents/models
H4_STATE_DIR=/var/lib/h4agents/state/dev-cpu
H4_AWS_DIR=/run/h4agents/tree/deploy/aws-none
H4_TUNNEL_DIR=/run/h4agents/tree/deploy/tunnel-none
H4_VHDX_MOUNT=/mnt/c
H4_API_PORT=18300
H4_LANGFUSE_PORT=18301
H4_GRAFANA_PORT=18302
H4_ADMIN_PORT=18303
H4_OTLP_PORT=18304
# x005, the room's site (spec 002, contracts/web-serving.md §4).
H4_SITE_PORT=18305
# Builds reach npm and PyPI only through the engine's egress proxy (contracts/agents-engine.md §4).
H4_BUILD_PROXY=http://198.18.0.1:3128
# The room's web image's tag suffix, which carries its drafts flag (spec 002, contracts/web-serving.md §1 and §4),
# -drafts: dev-cpu's web image shows the room's drafts, bannered.
H4_WEB_SUFFIX=-drafts

# The model (§3): the stand-in, seeded by the Author (deploy/agents-engine/engine.sh seed).
MODEL_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf
MODEL_ALIAS=qwen2.5-0.5b-instruct
MODEL_CTX_SIZE=8192
MODEL_PARALLEL=2
MODEL_THREADS=4
LOCAL_MODEL_BASE_URL=http://model-server:8080/v1

# The gateway (§4). The operator token is the public dummy below, and OPERATOR_TOKEN_SHA256 is its SHA-256.
# prod's gateway refuses that hash, and any token without prod's prefix.
GATEWAY_DB_PASSWORD=d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0
GATEWAY_GRAFANA_RO_PASSWORD=d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1
OPERATOR_TOKEN_SHA256=a2d31213fa06fe88ace640f1a44aa2a1ae9131e6cfed89384db03311a3217f48
H4_DEVCPU_OPERATOR_TOKEN=h4op_devcpu_devcpu-public-dummy-operator-token-00000000
# The engine has no route to Telegram or SMTP: alerts go to the stand-ins (§4).
ALERT_DELIVERY=standin
TELEGRAM_API_BASE=http://telegram-standin:8080
TELEGRAM_BOT_TOKEN=0000000000:devcpu-dummy-telegram-bot-token-000
TELEGRAM_CHAT_ID=0
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USER=devcpu-smtp-user
SMTP_PASSWORD=devcpu-smtp-password
ALERT_EMAIL_FROM=alerts@h4reet.local
ALERT_EMAIL_TO=operator@h4reet.local
GATEWAY_TEST_CLOCK=1
GATEWAY_TEST_SYNTHETIC_SPEND=1
TELEMETRY_PAYLOAD_SAMPLING=off

# Langfuse (§5).
LANGFUSE_PUBLIC_KEY=pk-lf-00000000-0000-4000-8000-000000000000
LANGFUSE_SECRET_KEY=sk-lf-00000000-0000-4000-8000-000000000000
LANGFUSE_SALT=d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2
LANGFUSE_ENCRYPTION_KEY=d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3
LANGFUSE_NEXTAUTH_SECRET=d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4
LANGFUSE_DB_PASSWORD=d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5
LANGFUSE_INIT_USER_EMAIL=operator@h4reet.local
LANGFUSE_INIT_USER_PASSWORD=d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6d6

# ClickHouse, Valkey, SeaweedFS, and Grafana (§6).
CLICKHOUSE_PASSWORD=d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7d7
