{
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(./secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(/corpus/intake/private/**)",
      "WebFetch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh pr merge*)",
      "Edit(.claude/**)",
      "Edit(.specify/memory/constitution.md)",
      "Edit(REVIEW.md)",
      "Edit(CLAUDE.md)",
      "Edit(/corpus/*.md)",
      "Edit(/corpus/.gitignore)",
      "Edit(/corpus/facts/**)",
      "Edit(/corpus/intake/**)",
      "Edit(/corpus/tools/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/.git/hooks/**)",
      "Edit(/.git/config)",
      "Edit(/config/budgets*)",
      "Edit(/config/alert*)",
      "Edit(/config/kill-switch*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make test-fast)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make evals)",
      "Bash(make redteam)",
      "Bash(make plan)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": [
        "./CLAUDE.md",
        "./REVIEW.md",
        "./.claude",
        "./.specify/memory/constitution.md",
        "./corpus/00-profile.md",
        "./corpus/01-ai-strategy-and-cht.md",
        "./corpus/02-production-infrastructure-national-scale.md",
        "./corpus/03-grants-and-credits.md",
        "./corpus/INTAKE.md",
        "./corpus/README.md",
        "./corpus/.gitignore",
        "./corpus/facts",
        "./corpus/intake",
        "./corpus/tools",
        "./.git/hooks",
        "./.git/config"
      ],
      "denyRead": [
        "./corpus/intake/private"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "ghcr.io"
      ],
      "deniedDomains": [
        "github.com",
        "api.github.com"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "TELEGRAM_BOT_TOKEN",
          "mode": "deny"
        },
        {
          "name": "LANGFUSE_SECRET_KEY",
          "mode": "deny"
        }
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/bash-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protected-paths.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-check.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent-report-check.sh"
          }
        ]
      }
    ]
  }
}
