{
  "env": {
    "DOCKER_CONFIG": "~/.config/h4reet/agents-engine/docker",
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(*.env)",
      "Read(./secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(/corpus/intake/private/**)",
      "WebFetch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh pr merge*)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/agents/**)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/git-hooks/**)",
      "Edit(.claude/audit/**)",
      "Edit(.claude/.gitignore)",
      "Edit(.claude/skills)",
      "Edit(.claude/.cc-writes)",
      "Edit(.specify/memory/constitution.md)",
      "Edit(REVIEW.md)",
      "Edit(CLAUDE.md)",
      "Edit(/corpus/*.md)",
      "Edit(/corpus/.gitignore)",
      "Edit(/corpus/facts/**)",
      "Edit(/corpus/intake/**)",
      "Edit(/corpus/tools/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/.git/hooks/**)",
      "Edit(/.git/config)",
      "Edit(*.env)",
      "Edit(/config/budgets*)",
      "Edit(/config/alert*)",
      "Edit(/config/kill-switch*)",
      "Read(~/.config/h4reet-ai/**)",
      "Edit(~/.config/h4reet-ai/**)",
      "Edit(~/.local/state/h4reet/**)",
      "Edit(/config/prices*)",
      "Edit(/GNUmakefile)",
      "Edit(/makefile)",
      "Edit(/deploy/agents-engine/**)",
      "Edit(/.gitleaks.toml)",
      "Edit(/.gitleaksignore)",
      "Edit(/tools/gates/**)",
      "Edit(/evals/agent-config/**)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make test-fast)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make evals)",
      "Bash(make redteam)",
      "Bash(make plan)",
      "Edit(.claude/worktrees/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": [
        "./CLAUDE.md",
        "./REVIEW.md",
        "./.claude",
        "./.specify/memory/constitution.md",
        "./corpus/00-profile.md",
        "./corpus/01-ai-strategy-and-cht.md",
        "./corpus/02-production-infrastructure-national-scale.md",
        "./corpus/03-grants-and-credits.md",
        "./corpus/INTAKE.md",
        "./corpus/README.md",
        "./corpus/.gitignore",
        "./corpus/facts",
        "./corpus/intake",
        "./corpus/tools",
        "./.git/hooks",
        "./.git/config",
        "./deploy/env",
        "./config/prices.yaml",
        "./config/budgets.yaml",
        "./config/alerts.yaml",
        "./GNUmakefile",
        "./makefile",
        "./deploy/agents-engine",
        "./.gitleaks.toml",
        "./.gitleaksignore",
        "./tools/gates",
        "./evals/agent-config",
        "~/.config/h4reet-ai",
        "~/.local/state/h4reet"
      ],
      "denyRead": [
        "./corpus/intake/private",
        "./deploy/env",
        "~/.config/h4reet-ai",
        "~/.docker/config.json",
        "~/.npmrc",
        "~/.pypirc",
        "~/.netrc",
        "~/.gnupg",
        "~/.bash_history",
        "~/.zsh_history",
        "~/.python_history",
        "~/.node_repl_history",
        "/mnt/c/Users",
        "/etc/h4agents/pki"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "ghcr.io",
        "198.18.0.1:2376"
      ],
      "deniedDomains": [
        "github.com",
        "api.github.com"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        },
        {
          "path": "~/.config/h4reet-ai",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "TELEGRAM_BOT_TOKEN",
          "mode": "deny"
        },
        {
          "name": "LANGFUSE_SECRET_KEY",
          "mode": "deny"
        },
        {
          "name": "H4_OPERATOR_TOKEN",
          "mode": "deny"
        },
        {
          "name": "SMTP_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "SMTP_USER",
          "mode": "deny"
        },
        {
          "name": "GATEWAY_DB_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "GATEWAY_GRAFANA_RO_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "LANGFUSE_PUBLIC_KEY",
          "mode": "deny"
        },
        {
          "name": "LANGFUSE_SALT",
          "mode": "deny"
        },
        {
          "name": "LANGFUSE_ENCRYPTION_KEY",
          "mode": "deny"
        },
        {
          "name": "LANGFUSE_NEXTAUTH_SECRET",
          "mode": "deny"
        },
        {
          "name": "LANGFUSE_DB_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "LANGFUSE_INIT_USER_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "CLICKHOUSE_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "VALKEY_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "SEAWEEDFS_S3_SECRET_KEY",
          "mode": "deny"
        },
        {
          "name": "GF_SECURITY_ADMIN_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "AWS_PROFILE",
          "mode": "deny"
        },
        {
          "name": "AWS_CONFIG_FILE",
          "mode": "deny"
        },
        {
          "name": "AWS_SHARED_CREDENTIALS_FILE",
          "mode": "deny"
        },
        {
          "name": "AWS_WEB_IDENTITY_TOKEN_FILE",
          "mode": "deny"
        },
        {
          "name": "AWS_ROLE_ARN",
          "mode": "deny"
        },
        {
          "name": "AWS_CONTAINER_CREDENTIALS_FULL_URI",
          "mode": "deny"
        },
        {
          "name": "AWS_CONTAINER_AUTHORIZATION_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/bash-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protected-paths.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/content-scan.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-check.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent-report-check.sh"
          }
        ]
      }
    ]
  }
}
