#!/usr/bin/env bash
# pre-commit: gitleaks over the staged changes (spec 000 FR-008 and FR-012; plan §11; research.md R-36).
# Human-only; `make git-hooks` installs it, once per clone. It reads only the main working tree's .gitleaks.toml,
# passes an empty ignore path and --ignore-gitleaks-allow, and refuses while a .gitleaksignore sits at its source,
# or one that an agent could fill sits in the main tree, so nothing an agent writes can switch a rule off. Without
# gitleaks or the config it refuses the commit: the hook fails closed.
set -euo pipefail
fail() {
  echo "pre-commit: $1; the commit is refused" >&2
  exit 1
}
command -v gitleaks >/dev/null 2>&1 || fail "gitleaks isn't installed (the Author runs make tools)"
top="$(git rev-parse --show-toplevel)" || fail "not inside a work tree"
common="$(git rev-parse --path-format=absolute --git-common-dir)" || fail "no git directory"
main_tree="$(cd -- "$(dirname -- "$common")" && pwd -P)" || fail "can't resolve the main working tree" # resolved, as $top is
config="$main_tree/.gitleaks.toml"
[ -f "$config" ] || fail "no .gitleaks.toml in the main working tree, $main_tree"
# gitleaks reads a source's own .gitleaksignore whatever the flags (R-36), so this check is what holds.
# - In the main tree, the sandbox denies the path, so a session can't fill what is there: holds_nothing lets through
#   the two things that hold no entry. While a session runs, the sandbox masks the path with /dev/null itself,
#   device 1:3; a killed session leaves an empty regular file there. Refusing those refused every commit from a
#   session (2026-10-09). A link, a FIFO (size 0, but gitleaks reads what a writer feeds it), or content refuses.
# - Anywhere else, a worktree of its own, nothing masks the path and an agent can write it, so even an empty file
#   could be filled between this check and gitleaks' read: anything there at all refuses.
holds_nothing() {
  if [ ! -e "$1" ] && [ ! -L "$1" ]; then return 0; fi
  if [ -L "$1" ]; then return 1; fi
  if [ -f "$1" ] && [ ! -s "$1" ]; then return 0; fi
  [ -c "$1" ] && [ "$(stat -c '%t:%T' -- "$1")" = "1:3" ]
}
if [ "$top" != "$main_tree" ] && { [ -e "$top/.gitleaksignore" ] || [ -L "$top/.gitleaksignore" ]; }; then
  fail "a .gitleaksignore in $top would switch findings off (research.md R-36)"
fi
holds_nothing "$main_tree/.gitleaksignore" ||
  fail "a .gitleaksignore in $main_tree would switch findings off (research.md R-36)"
empty="$(mktemp -d)" || fail "mktemp failed"
{ [ -n "$empty" ] && [ -d "$empty" ]; } || fail "mktemp gave no directory"
trap 'rmdir -- "$empty" 2>/dev/null || true' EXIT
gitleaks git --pre-commit --staged --no-banner --redact --config "$config" --gitleaks-ignore-path "$empty" \
  --ignore-gitleaks-allow "$top" \
  || fail "gitleaks found something shaped like a secret in the staged changes, or couldn't run"
