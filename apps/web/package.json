{
  "name": "@h4reet/web",
  "version": "0.1.0",
  "private": true,
  "description": "The room: the static site the visitor sees, built by Vite and served by the web image (spec 002, plan section 1).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "prebuild": "node --import tsx build/policy.ts",
    "build": "vite build",
    "build:lookdev-phone": "vite build --config vite.phone.config.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "content:lock": "node --import tsx build/narration.ts --lock",
    "content:check": "node --import tsx build/narration.ts",
    "fonts:lock": "node --import tsx build/fonts-lock.ts",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint --max-warnings 0 . && tsc --noEmit -p .",
    "manifest": "npm run room:generate",
    "room:generate": "node --import tsx build/room/cli.ts generate",
    "room:check": "node --import tsx build/room/cli.ts check",
    "room:report": "node --import tsx build/room/cli.ts report",
    "room:scan": "node --import tsx build/room/cli.ts scan",
    "room:fit": "node --import tsx build/room/cli.ts fit",
    "twin:pack": "node --import tsx build/twin-pack.ts"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.1",
    "@types/pdfkit": "0.17.6",
    "@types/three": "0.186.0",
    "axe-core": "4.13.0",
    "fontkit": "2.0.4",
    "jsdom": "30.1.1",
    "pako": "2.1.0",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.20.2",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
