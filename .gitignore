# Never commit secrets, local state, or build output. Three more .gitignore files cover their own folders:
# .claude/ (the hook audit log), corpus/ (the private intake), and .specify/ (Spec Kit's machine-local state).

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
*.egg-info/
.coverage
htmlcov/
# uv's cache, which the Makefile keeps inside the repository (UV_CACHE_DIR)
.cache/

# Node
node_modules/
npm-debug.log*
*.tsbuildinfo
coverage/
dist/

# Terraform. State and plans describe real resources and can hold secrets; the remote state is the source of truth.
# .terraform.lock.hcl is committed: it pins the providers (lockfile pinning, spec 000 FR-014; Terraform arrives with spec 001).
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tf.plan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Variable files can hold secrets. If spec 001 commits non-secret per-environment values, its plan names the exception.
*.tfvars
*.tfvars.json

# Environment files hold real values and stay on the machine that runs the stack (docs/START-HERE.md).
# Commit templates as *.env.example. Ignored everywhere, not only in deploy/env/, so a stray env file can't slip in.
*.env
.env
.env.*
!.env.example
secrets/

# OS and editor files
.DS_Store
Thumbs.db
*.swp
.idea/
